<Project Sdk="Cosmos.Sdk/3.0.95">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>
    <!-- Stock Cosmos 3.0.95 input API; NO private SMP/SMT runtime overlays. -->
    <ZonderqCosmosKeyboardApi>Input</ZonderqCosmosKeyboardApi>
    <!-- Main defaults to the full disk-backed GUI. The kernel refuses to mount
         an unapproved FAT32 volume or Kali ESP. Enable probe explicitly in CI. -->
    <ZonderqInputDiagnosticBoot Condition="'$(ZonderqInputDiagnosticBoot)' == ''">false</ZonderqInputDiagnosticBoot>
    <DefineConstants Condition="'$(ZonderqInputDiagnosticBoot)' == 'true'">$(DefineConstants);ZONDERQ_INPUT_DIAGNOSTIC_BOOT</DefineConstants>
    <!-- Optional non-mutating hardware probe; always explicit when building
         the diagnostics ISO, NEVER silently applied to the normal GUI ISO. -->
    <ZonderqReadOnlyHardwareProbe Condition="'$(ZonderqReadOnlyHardwareProbe)' == ''">false</ZonderqReadOnlyHardwareProbe>
    <DefineConstants Condition="'$(ZonderqReadOnlyHardwareProbe)' == 'true'">$(DefineConstants);ZONDERQ_READONLY_HARDWARE_PROBE</DefineConstants>
    <!-- Optional *ephemeral* full-GUI profile: FAT32 on private RAM device.
         No host disk can receive a write from root setup or icon caches. -->
    <ZonderqRamRoot Condition="'$(ZonderqRamRoot)' == ''">false</ZonderqRamRoot>
    <DefineConstants Condition="'$(ZonderqRamRoot)' == 'true'">$(DefineConstants);ZONDERQ_3094_RAM_ROOT</DefineConstants>
    <DefineConstants Condition="'$(ZonderqCosmosKeyboardApi)' == 'Input'">$(DefineConstants);ZONDERQ_COSMOS_INPUT_API</DefineConstants>

    <CosmosKernelClass>ZonderqOS.Kernel</CosmosKernelClass>

    <!-- Keep one feature profile for both architectures. Architecture-specific
         hardware setup belongs in Cosmos/HAL adapters, not throughout the app. -->
    <CosmosEnableNetwork>false</CosmosEnableNetwork>
    <!-- Explicit x64/QEMU-only isolated NIC proof. Production stays offline. -->
    <ZonderqNetworkN1Probe Condition="'$(ZonderqNetworkN1Probe)' == ''">false</ZonderqNetworkN1Probe>
    <!-- Explicit isolated ASUS RTL810xE read-only BAR2 probe, never production GUI. -->
    <ZonderqRealtekReadOnlyMmio Condition="'$(ZonderqRealtekReadOnlyMmio)' == ''">false</ZonderqRealtekReadOnlyMmio>
    <!-- Separate opt-in screen variant. The original UART-only ISO stays unchanged. -->
    <ZonderqRealtekScreen Condition="'$(ZonderqRealtekScreen)' == ''">false</ZonderqRealtekScreen>
    <DefineConstants Condition="'$(ZonderqRealtekReadOnlyMmio)' == 'true' and '$(CosmosArch)' == 'x64'">$(DefineConstants);ZONDERQ_REALTEK_READONLY_MMIO</DefineConstants>
    <NoWarn Condition="'$(ZonderqRealtekReadOnlyMmio)' == 'true'">$(NoWarn);COSMOS0003</NoWarn>
    <!-- N2 runs DHCP only after the N1 raw TX proof, in the same QEMU-only kernel. -->
    <ZonderqNetworkN2Dhcp Condition="'$(ZonderqNetworkN2Dhcp)' == ''">false</ZonderqNetworkN2Dhcp>
    <ZonderqNetworkN3Icmp Condition="'$(ZonderqNetworkN3Icmp)' == ''">false</ZonderqNetworkN3Icmp>
    <ZonderqNetworkN4Tcp Condition="'$(ZonderqNetworkN4Tcp)' == ''">false</ZonderqNetworkN4Tcp>
    <ZonderqNetworkN5Dns Condition="'$(ZonderqNetworkN5Dns)' == ''">false</ZonderqNetworkN5Dns>
    <ZonderqNetworkN6Http Condition="'$(ZonderqNetworkN6Http)' == ''">false</ZonderqNetworkN6Http>
    <DefineConstants Condition="'$(ZonderqNetworkN1Probe)' == 'true' and '$(ZonderqNetworkN2Dhcp)' == 'true' and '$(ZonderqNetworkN3Icmp)' == 'true' and '$(ZonderqNetworkN4Tcp)' == 'true' and '$(CosmosArch)' == 'x64'">$(DefineConstants);ZONDERQ_NETWORK_N4_TCP</DefineConstants>
    <DefineConstants Condition="'$(ZonderqNetworkN1Probe)' == 'true' and '$(ZonderqNetworkN2Dhcp)' == 'true' and '$(ZonderqNetworkN3Icmp)' == 'true' and '$(ZonderqNetworkN4Tcp)' == 'true' and '$(ZonderqNetworkN5Dns)' == 'true' and '$(CosmosArch)' == 'x64'">$(DefineConstants);ZONDERQ_NETWORK_N5_DNS</DefineConstants>
    <DefineConstants Condition="'$(ZonderqNetworkN1Probe)' == 'true' and '$(ZonderqNetworkN2Dhcp)' == 'true' and '$(ZonderqNetworkN3Icmp)' == 'true' and '$(ZonderqNetworkN4Tcp)' == 'true' and '$(ZonderqNetworkN5Dns)' == 'true' and '$(ZonderqNetworkN6Http)' == 'true' and '$(CosmosArch)' == 'x64'">$(DefineConstants);ZONDERQ_NETWORK_N6_HTTP</DefineConstants>
    <DefineConstants Condition="'$(ZonderqNetworkN1Probe)' == 'true' and '$(ZonderqNetworkN2Dhcp)' == 'true' and '$(ZonderqNetworkN3Icmp)' == 'true' and '$(CosmosArch)' == 'x64'">$(DefineConstants);ZONDERQ_NETWORK_N3_ICMP</DefineConstants>
    <DefineConstants Condition="'$(ZonderqNetworkN1Probe)' == 'true' and '$(ZonderqNetworkN2Dhcp)' == 'true' and '$(CosmosArch)' == 'x64'">$(DefineConstants);ZONDERQ_NETWORK_N2_DHCP</DefineConstants>
    <CosmosEnableNetwork Condition="'$(ZonderqNetworkN1Probe)' == 'true' and '$(CosmosArch)' == 'x64'">true</CosmosEnableNetwork>
    <!-- The read-only RTL probe needs PCI/DriverKit, NOT NetworkManager.
         Keep the shipped E1000E/virtio NIC drivers and their DMA disabled. -->
    <CosmosKernelClass Condition="'$(ZonderqRealtekReadOnlyMmio)' == 'true' and '$(CosmosArch)' == 'x64'">ZonderqOS.NetworkRealtekReadOnlyKernel</CosmosKernelClass>
    <CosmosKernelClass Condition="'$(ZonderqNetworkN1Probe)' == 'true' and '$(CosmosArch)' == 'x64'">ZonderqOS.NetworkN1ProbeKernel</CosmosKernelClass>
    <DefineConstants Condition="'$(ZonderqNetworkN1Probe)' == 'true' and '$(CosmosArch)' == 'x64'">$(DefineConstants);ZONDERQ_NETWORK_N1_PROBE</DefineConstants>
    <CosmosEnableStorage Condition="'$(ZonderqNetworkN1Probe)' != 'true'">true</CosmosEnableStorage>
    <CosmosEnableStorage Condition="'$(ZonderqNetworkN1Probe)' == 'true'">false</CosmosEnableStorage>
    <CosmosEnableMouse Condition="'$(ZonderqNetworkN1Probe)' != 'true'">true</CosmosEnableMouse>
    <CosmosEnableMouse Condition="'$(ZonderqNetworkN1Probe)' == 'true'">false</CosmosEnableMouse>
    <CosmosEnablePCI>true</CosmosEnablePCI>
    <CosmosEnableUsb Condition="'$(ZonderqNetworkN1Probe)' != 'true'">true</CosmosEnableUsb>
    <CosmosEnableUsb Condition="'$(ZonderqNetworkN1Probe)' == 'true'">false</CosmosEnableUsb>
    <CosmosEnableKeyboard Condition="'$(ZonderqNetworkN1Probe)' != 'true'">true</CosmosEnableKeyboard>
    <CosmosEnableKeyboard Condition="'$(ZonderqNetworkN1Probe)' == 'true'">false</CosmosEnableKeyboard>
    <CosmosEnableGraphics Condition="'$(ZonderqNetworkN1Probe)' != 'true'">true</CosmosEnableGraphics>
    <CosmosEnableGraphics Condition="'$(ZonderqNetworkN1Probe)' == 'true'">false</CosmosEnableGraphics>
    <!-- Physical diagnostic cannot mount storage or initialize the GUI. -->
    <CosmosEnableStorage Condition="'$(ZonderqRealtekReadOnlyMmio)' == 'true'">false</CosmosEnableStorage>
    <CosmosEnableMouse Condition="'$(ZonderqRealtekReadOnlyMmio)' == 'true'">false</CosmosEnableMouse>
    <CosmosEnableUsb Condition="'$(ZonderqRealtekReadOnlyMmio)' == 'true'">false</CosmosEnableUsb>
    <CosmosEnableKeyboard Condition="'$(ZonderqRealtekReadOnlyMmio)' == 'true'">false</CosmosEnableKeyboard>
    <CosmosEnableGraphics Condition="'$(ZonderqRealtekReadOnlyMmio)' == 'true' and '$(ZonderqRealtekScreen)' != 'true'">false</CosmosEnableGraphics>
    <!-- Only a text console on the firmware display; never the production GUI. -->
    <CosmosEnableGraphics Condition="'$(ZonderqRealtekReadOnlyMmio)' == 'true' and '$(ZonderqRealtekScreen)' == 'true'">true</CosmosEnableGraphics>
    <CosmosEnableScheduler>true</CosmosEnableScheduler>
    <!-- Serial diagnostics remain available even without graphics. -->
    <CosmosEnableUART>true</CosmosEnableUART>

    <!-- Make the disabled network state explicit to ZonderqOS code without
         depending on package-internal networking types. -->
    <DefineConstants Condition="'$(ZonderqNetworkN1Probe)' != 'true'">$(DefineConstants);ZONDERQ_NETWORK_DISABLED</DefineConstants>

    <!-- An obsolete experimental shim existed locally in some checkouts. Put it
         in DefaultItemExcludes as well as Compile Remove so it cannot re-enter
         through SDK wildcard item discovery on either x64 or ARM64. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);source/Core/CosmosGen3DiagnosticsCompat.cs;**/CosmosGen3DiagnosticsCompat.cs</DefaultItemExcludes>
  </PropertyGroup>

  <!-- Keep architecture selection deterministic even when the project is
       restored/published directly instead of only through cosmos build. -->
  <PropertyGroup Condition="'$(CosmosArch)' == '' and '$(RuntimeIdentifier)' == 'linux-x64'">
    <CosmosArch>x64</CosmosArch>
  </PropertyGroup>

  <PropertyGroup Condition="'$(CosmosArch)' == '' and '$(RuntimeIdentifier)' == 'linux-arm64'">
    <CosmosArch>arm64</CosmosArch>
  </PropertyGroup>

  <PropertyGroup Condition="'$(CosmosArch)' == 'arm64'">
    <!-- QEMU virt ARM64: GICv3 + PL011 + ACPI/ECAM PCI + NVMe/VirtIO devices. -->
    <CosmosEnableInterrupts>true</CosmosEnableInterrupts>
    <CosmosEnablePCI>true</CosmosEnablePCI>
    <CosmosEnableUART>true</CosmosEnableUART>
  </PropertyGroup>

  <ItemGroup>
    <!-- Exactly matched stock upstream Cosmos v3.0.95 packages. No custom
         AP bootstrap, OrionGC patches or managed SMP scheduler. -->
    <PackageReference Include="Cosmos.Kernel" Version="3.0.95" />
    <PackageReference Include="Cosmos.Kernel.System" Version="3.0.95" />
  </ItemGroup>

  <!-- Platform architecture boundary: Common is always compiled. Exactly one
       architecture-specific backend remains in Compile items for each build. -->
  <ItemGroup Condition="'$(CosmosArch)' == 'arm64'">
    <Compile Remove="source/Platform/X64/**/*.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(CosmosArch)' != 'arm64'">
    <Compile Remove="source/Platform/Arm64/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <Compile Remove="source/Core/CosmosGen3DiagnosticsCompat.cs" />
    <Compile Remove="**/CosmosGen3DiagnosticsCompat.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(CosmosEnableNetwork)' != 'true' or '$(ZonderqNetworkN1Probe)' == 'true' or '$(ZonderqRealtekReadOnlyMmio)' == 'true'">
    <!-- Network commands directly consume the Cosmos networking API. Keep them
         out until the feature is re-enabled and backed by a real platform NIC. -->
    <Compile Remove="source/Shell/Commands/CmdNetwork.cs" />
    <Compile Remove="source/Shell/Commands/CmdIp.cs" />
    <Compile Remove="source/Shell/Commands/CmdPing.cs" />
    <Compile Remove="source/Shell/Commands/CmdDns.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(ZonderqRealtekReadOnlyMmio)' == 'true' and '$(CosmosArch)' == 'x64'">
    <CosmosDriverInclude Include="ZonderqOS.Drivers.Realtek810xEReadOnlyProbeDriver" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="source/GUI/Icons/Assets/*.png">
      <LogicalName>Icons.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="source/Wallpapers/*.png">
      <LogicalName>Wallpapers.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <Target Name="GuardNetworkN1Probe" BeforeTargets="CoreCompile">
    <Error Condition="'$(ZonderqNetworkN2Dhcp)' == 'true' and '$(ZonderqNetworkN1Probe)' != 'true'"
           Text="Network N2 DHCP proof requires the isolated N1 probe." />
    <Error Condition="'$(ZonderqNetworkN3Icmp)' == 'true' and '$(ZonderqNetworkN2Dhcp)' != 'true'"
           Text="Network N3 ICMP proof requires the isolated N2 DHCP probe." />
    <Error Condition="'$(ZonderqNetworkN4Tcp)' == 'true' and '$(ZonderqNetworkN3Icmp)' != 'true'"
           Text="Network N4 TCP proof requires the isolated N3 ICMP probe." />
    <Error Condition="'$(ZonderqNetworkN6Http)' == 'true' and '$(ZonderqNetworkN5Dns)' != 'true'"
           Text="Network N6 HTTP proof requires the isolated N5 DNS probe." />
    <Error Condition="'$(ZonderqNetworkN5Dns)' == 'true' and '$(ZonderqNetworkN4Tcp)' != 'true'"
           Text="Network N5 DNS proof requires the isolated N4 TCP probe." />
    <Error Condition="'$(ZonderqNetworkN1Probe)' == 'true' and '$(CosmosArch)' != 'x64'"
           Text="Network N1 probe is x64-only." />
    <Error Condition="'$(ZonderqNetworkN1Probe)' == 'true' and ('$(ZonderqRamRoot)' == 'true' or '$(ZonderqReadOnlyHardwareProbe)' == 'true' or '$(ZonderqInputDiagnosticBoot)' == 'true')"
           Text="Network N1 probe must not share the production or diagnostics boot profiles." />
    <Error Condition="'$(ZonderqNetworkN1Probe)' == 'true' and '$(CosmosEnableNetwork)' != 'true'"
           Text="Network N1 probe requires CosmosEnableNetwork=true." />
  </Target>

  <Target Name="GuardRealtekReadOnlyMmio" BeforeTargets="CoreCompile">
    <Error Condition="'$(ZonderqRealtekReadOnlyMmio)' == 'true' and '$(CosmosArch)' != 'x64'"
           Text="RTL810xE MMIO probe is x64-only." />
    <Error Condition="'$(ZonderqRealtekReadOnlyMmio)' == 'true' and ('$(ZonderqNetworkN1Probe)' == 'true' or '$(ZonderqRamRoot)' == 'true' or '$(ZonderqReadOnlyHardwareProbe)' == 'true' or '$(ZonderqInputDiagnosticBoot)' == 'true')"
           Text="RTL810xE MMIO probe must use its own isolated serial boot profile." />
    <Error Condition="'$(ZonderqRealtekScreen)' == 'true' and '$(ZonderqRealtekReadOnlyMmio)' != 'true'"
           Text="RTL810xE screen output requires the isolated read-only MMIO probe." />
    <Error Condition="'$(ZonderqRealtekReadOnlyMmio)' == 'true' and '$(CosmosEnableStorage)' != 'false'"
           Text="RTL810xE MMIO probe must not enable storage." />
    <Error Condition="'$(ZonderqRealtekReadOnlyMmio)' == 'true' and '$(ZonderqRealtekScreen)' != 'true' and '$(CosmosEnableGraphics)' != 'false'"
           Text="RTL810xE UART-only probe must keep graphics disabled." />
    <Error Condition="'$(ZonderqRealtekReadOnlyMmio)' == 'true' and '$(ZonderqRealtekScreen)' == 'true' and '$(CosmosEnableGraphics)' != 'true'"
           Text="RTL810xE screen probe requires the text-console display." />
  </Target>

  <Target Name="GuardRamRootProfile" BeforeTargets="CoreCompile">
    <Error Condition="'$(ZonderqRamRoot)' == 'true' and '$(ZonderqReadOnlyHardwareProbe)' == 'true'"
           Text="RAM-root GUI and read-only probe are mutually exclusive." />
    <Error Condition="'$(ZonderqRamRoot)' == 'true' and '$(ZonderqInputDiagnosticBoot)' == 'true'"
           Text="RAM-root GUI needs the normal graphical startup profile." />
  </Target>

</Project>
