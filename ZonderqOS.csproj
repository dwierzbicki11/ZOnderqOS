<Project Sdk="Cosmos.Sdk/3.0.95">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>
    <!-- Stock Cosmos 3.0.95 input API; NO private SMP/SMT runtime overlays. -->
    <ZonderqCosmosKeyboardApi>Input</ZonderqCosmosKeyboardApi>
    <!-- Main defaults to the full disk-backed GUI. The kernel refuses to mount
         an unapproved FAT32 volume or Kali ESP. Enable probe explicitly in CI. -->
    <ZonderqInputDiagnosticBoot Condition="'$(ZonderqInputDiagnosticBoot)' == ''">false</ZonderqInputDiagnosticBoot>
    <DefineConstants Condition="'$(ZonderqInputDiagnosticBoot)' == 'true'">$(DefineConstants);ZONDERQ_INPUT_DIAGNOSTIC_BOOT</DefineConstants>
    <!-- Optional non-mutating hardware probe; always explicit when building
         the diagnostics ISO, NEVER silently applied to the normal GUI ISO. -->
    <ZonderqReadOnlyHardwareProbe Condition="'$(ZonderqReadOnlyHardwareProbe)' == ''">false</ZonderqReadOnlyHardwareProbe>
    <DefineConstants Condition="'$(ZonderqReadOnlyHardwareProbe)' == 'true'">$(DefineConstants);ZONDERQ_READONLY_HARDWARE_PROBE</DefineConstants>
    <!-- Optional *ephemeral* full-GUI profile: FAT32 on private RAM device.
         No host disk can receive a write from root setup or icon caches. -->
    <ZonderqRamRoot Condition="'$(ZonderqRamRoot)' == ''">false</ZonderqRamRoot>
    <DefineConstants Condition="'$(ZonderqRamRoot)' == 'true'">$(DefineConstants);ZONDERQ_3094_RAM_ROOT</DefineConstants>
    <!-- Explicit CI-only ISO: preserve the real Limine framebuffer to exercise
         small display layouts. Production builds never enable this symbol. -->
    <ZonderqGuiTestNativeFramebuffer Condition="'$(ZonderqGuiTestNativeFramebuffer)' == ''">false</ZonderqGuiTestNativeFramebuffer>
    <DefineConstants Condition="'$(ZonderqGuiTestNativeFramebuffer)' == 'true'">$(DefineConstants);ZONDERQ_GUI_TEST_NATIVE_FRAMEBUFFER</DefineConstants>
    <DefineConstants Condition="'$(ZonderqCosmosKeyboardApi)' == 'Input'">$(DefineConstants);ZONDERQ_COSMOS_INPUT_API</DefineConstants>

    <CosmosKernelClass>ZonderqOS.Kernel</CosmosKernelClass>

    <!-- Keep one feature profile for both architectures. Architecture-specific
         hardware setup belongs in Cosmos/HAL adapters, not throughout the app. -->
    <CosmosEnableNetwork>false</CosmosEnableNetwork>
    <CosmosEnableStorage>true</CosmosEnableStorage>
    <CosmosEnableMouse>true</CosmosEnableMouse>
    <CosmosEnablePCI>true</CosmosEnablePCI>
    <CosmosEnableUsb>true</CosmosEnableUsb>
    <CosmosEnableKeyboard>true</CosmosEnableKeyboard>
    <CosmosEnableGraphics>true</CosmosEnableGraphics>
    <CosmosEnableScheduler>true</CosmosEnableScheduler>

    <!-- Make the disabled network state explicit to ZonderqOS code without
         depending on package-internal networking types. -->
    <DefineConstants>$(DefineConstants);ZONDERQ_NETWORK_DISABLED</DefineConstants>

    <!-- An obsolete experimental shim existed locally in some checkouts. Put it
         in DefaultItemExcludes as well as Compile Remove so it cannot re-enter
         through SDK wildcard item discovery on either x64 or ARM64. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);source/Core/CosmosGen3DiagnosticsCompat.cs;**/CosmosGen3DiagnosticsCompat.cs</DefaultItemExcludes>
  </PropertyGroup>

  <!-- Keep architecture selection deterministic even when the project is
       restored/published directly instead of only through cosmos build. -->
  <PropertyGroup Condition="'$(CosmosArch)' == '' and '$(RuntimeIdentifier)' == 'linux-x64'">
    <CosmosArch>x64</CosmosArch>
  </PropertyGroup>

  <PropertyGroup Condition="'$(CosmosArch)' == '' and '$(RuntimeIdentifier)' == 'linux-arm64'">
    <CosmosArch>arm64</CosmosArch>
  </PropertyGroup>

  <PropertyGroup Condition="'$(CosmosArch)' == 'arm64'">
    <!-- QEMU virt ARM64: GICv3 + PL011 + ACPI/ECAM PCI + NVMe/VirtIO devices. -->
    <CosmosEnableInterrupts>true</CosmosEnableInterrupts>
    <CosmosEnablePCI>true</CosmosEnablePCI>
    <CosmosEnableUART>true</CosmosEnableUART>
  </PropertyGroup>

  <ItemGroup>
    <!-- Exactly matched stock upstream Cosmos v3.0.95 packages. No custom
         AP bootstrap, OrionGC patches or managed SMP scheduler. -->
    <PackageReference Include="Cosmos.Kernel" Version="3.0.95" />
    <PackageReference Include="Cosmos.Kernel.System" Version="3.0.95" />
  </ItemGroup>

  <!-- Platform architecture boundary: Common is always compiled. Exactly one
       architecture-specific backend remains in Compile items for each build. -->
  <ItemGroup Condition="'$(CosmosArch)' == 'arm64'">
    <Compile Remove="source/Platform/X64/**/*.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(CosmosArch)' != 'arm64'">
    <Compile Remove="source/Platform/Arm64/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <Compile Remove="source/Core/CosmosGen3DiagnosticsCompat.cs" />
    <Compile Remove="**/CosmosGen3DiagnosticsCompat.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(CosmosEnableNetwork)' != 'true'">
    <!-- Network commands directly consume the Cosmos networking API. Keep them
         out until the feature is re-enabled and backed by a real platform NIC. -->
    <Compile Remove="source/Shell/Commands/CmdNetwork.cs" />
    <Compile Remove="source/Shell/Commands/CmdIp.cs" />
    <Compile Remove="source/Shell/Commands/CmdPing.cs" />
    <Compile Remove="source/Shell/Commands/CmdDns.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="source/GUI/Icons/Assets/*.png">
      <LogicalName>Icons.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="source/Wallpapers/*.png">
      <LogicalName>Wallpapers.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <Target Name="GuardRamRootProfile" BeforeTargets="CoreCompile">
    <Error Condition="'$(ZonderqRamRoot)' == 'true' and '$(ZonderqReadOnlyHardwareProbe)' == 'true'"
           Text="RAM-root GUI and read-only probe are mutually exclusive." />
    <Error Condition="'$(ZonderqRamRoot)' == 'true' and '$(ZonderqInputDiagnosticBoot)' == 'true'"
           Text="RAM-root GUI needs the normal graphical startup profile." />
  </Target>

</Project>
