<Project Sdk="Cosmos.Sdk/3.0.85">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <CosmosKernelClass>ZonderqOS.Kernel</CosmosKernelClass>

    <!-- Keep one feature profile for both architectures. Architecture-specific
         hardware setup belongs in Cosmos/HAL adapters, not throughout the app. -->
    <CosmosEnableNetwork>false</CosmosEnableNetwork>
    <CosmosEnableStorage>true</CosmosEnableStorage>
    <CosmosEnableMouse>true</CosmosEnableMouse>
    <CosmosEnableKeyboard>true</CosmosEnableKeyboard>
    <CosmosEnableGraphics>true</CosmosEnableGraphics>
    <CosmosEnableScheduler>true</CosmosEnableScheduler>

    <!-- Make the disabled network state explicit to ZonderqOS code without
         depending on package-internal networking types. -->
    <DefineConstants>$(DefineConstants);ZONDERQ_NETWORK_DISABLED</DefineConstants>

    <!-- An obsolete experimental shim existed locally in some checkouts. Put it
         in DefaultItemExcludes as well as Compile Remove so it cannot re-enter
         through SDK wildcard item discovery on either x64 or ARM64. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);source/Core/CosmosGen3DiagnosticsCompat.cs;**/CosmosGen3DiagnosticsCompat.cs</DefaultItemExcludes>
  </PropertyGroup>

  <PropertyGroup Condition="'$(CosmosArch)' == 'arm64'">
    <!-- QEMU virt ARM64: GICv3 + PL011 + ACPI/ECAM PCI + NVMe/VirtIO devices. -->
    <CosmosEnableInterrupts>true</CosmosEnableInterrupts>
    <CosmosEnablePCI>true</CosmosEnablePCI>
    <CosmosEnableUART>true</CosmosEnableUART>
  </PropertyGroup>

  <ItemGroup>
    <!-- SDK and runtime packages must stay on the exact same Cosmos release. -->
    <PackageReference Include="Cosmos.Kernel" Version="3.0.85" />
    <PackageReference Include="Cosmos.Kernel.System" Version="3.0.85" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="source/Core/CosmosGen3DiagnosticsCompat.cs" />
    <Compile Remove="**/CosmosGen3DiagnosticsCompat.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(CosmosEnableNetwork)' != 'true'">
    <!-- Network commands directly consume the Cosmos networking API. Keep them
         out until the feature is re-enabled and backed by a real platform NIC. -->
    <Compile Remove="source/Shell/Commands/CmdNetwork.cs" />
    <Compile Remove="source/Shell/Commands/CmdIp.cs" />
    <Compile Remove="source/Shell/Commands/CmdPing.cs" />
    <Compile Remove="source/Shell/Commands/CmdDns.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="source/GUI/Icons/Assets/*.png">
      <LogicalName>Icons.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="source/Wallpapers/*.png">
      <LogicalName>Wallpapers.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
