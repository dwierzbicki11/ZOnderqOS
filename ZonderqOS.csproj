<Project Sdk="Cosmos.Sdk/3.0.84">

  <PropertyGroup>
    <CosmosEnableNetwork>false</CosmosEnableNetwork>

    <CosmosEnableStorage Condition="'$(CosmosArch)' != 'arm64'">true</CosmosEnableStorage>
    <CosmosEnableMouse Condition="'$(CosmosArch)' != 'arm64'">true</CosmosEnableMouse>
    <CosmosEnableKeyboard Condition="'$(CosmosArch)' != 'arm64'">true</CosmosEnableKeyboard>

    <CosmosEnableStorage Condition="'$(CosmosArch)' == 'arm64'">false</CosmosEnableStorage>
    <CosmosEnableMouse Condition="'$(CosmosArch)' == 'arm64'">false</CosmosEnableMouse>
    <CosmosEnableKeyboard Condition="'$(CosmosArch)' == 'arm64'">false</CosmosEnableKeyboard>

    <!-- Physical Raspberry Pi 4 baseline: the Cosmos ARM64 IRQ/GIC + GenericTimer
         + RTC initialization path has reached the managed shell successfully. Keep
         interrupts enabled while higher-level input/storage drivers stay isolated. -->
    <CosmosEnableInterrupts Condition="'$(CosmosArch)' == 'arm64'">true</CosmosEnableInterrupts>

    <!-- Generic Cosmos PCI remains disabled on the Pi target because BCM2711 PCI
         configuration space requires a platform-specific CFG_INDEX/CFG_DATA quirk,
         not ordinary ECAM. Rpi4XhciProbe handles that path explicitly for now. -->
    <CosmosEnablePCI Condition="'$(CosmosArch)' == 'arm64'">false</CosmosEnablePCI>

    <!-- Cosmos Gen3's ARM64 serial backend is currently hard-wired to the QEMU virt
         PL011 at 0x09000000. Touching that MMIO address on Raspberry Pi 4 can fault or
         hang before the managed kernel lifecycle starts, so keep UART disabled for the
         physical ARM64 target until a BCM2711-specific PL011 backend exists. -->
    <CosmosEnableUART Condition="'$(CosmosArch)' == 'arm64'">false</CosmosEnableUART>

    <CosmosEnableGraphics>true</CosmosEnableGraphics>
    <CosmosEnableScheduler Condition="'$(CosmosArch)' != 'arm64'">true</CosmosEnableScheduler>
    <CosmosEnableScheduler Condition="'$(CosmosArch)' == 'arm64'">false</CosmosEnableScheduler>

    <!-- Required by the ARM64 BCM2711/xHCI bring-up code. -->
    <AllowUnsafeBlocks Condition="'$(CosmosArch)' == 'arm64'">true</AllowUnsafeBlocks>

    <CosmosKernelClass Condition="'$(CosmosArch)' != 'arm64'">ZonderqOS.Kernel</CosmosKernelClass>
    <CosmosKernelClass Condition="'$(CosmosArch)' == 'arm64'">ZonderqOS.Rpi4BootKernel</CosmosKernelClass>

    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Cosmos.Kernel" Version="3.0.84" />
    <PackageReference Include="Cosmos.Kernel.System" Version="3.0.84" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="source/Core/CosmosGen3NetworkGlobalUsings.cs" />
    <Compile Remove="source/GUI/Application/LegacyNetworkConfig.cs" />
    <Compile Remove="source/Shell/Commands/CmdNetwork.cs" />
    <Compile Remove="source/Shell/Commands/CmdIp.cs" />
    <Compile Remove="source/Shell/Commands/CmdPing.cs" />
    <Compile Remove="source/Shell/Commands/CmdDns.cs" />
    <Compile Remove="source/Core/Arm64BootCompat.cs" />
    <Compile Remove="source/Core/Arm64DiagnosticsStub.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(CosmosArch)' == 'arm64'">
    <Compile Remove="Kernel.cs" />
    <Compile Remove="source/**/*.cs" />

    <!-- Real ZonderqOS shell core, intentionally limited to commands that do not
         require storage, network, GUI, keyboard input or scheduler support yet. -->
    <Compile Include="source/Common/CommandIO.cs" />
    <Compile Include="source/Shell/Command.cs" />
    <Compile Include="source/Shell/Commands/ICommand.cs" />
    <Compile Include="source/Shell/Commands/CmdPwd.cs" />
    <Compile Include="source/Shell/Commands/CmdClear.cs" />
    <Compile Include="source/Shell/Commands/CmdEcho.cs" />
    <Compile Include="source/Shell/Commands/CmdHelp.cs" />

    <!-- Raspberry Pi 4 BCM2711 PCI + VL805/xHCI bring-up. -->
    <Compile Include="source/Arm64/Rpi4XhciProbe.cs" />
    <Compile Include="source/Arm64/Rpi4XhciResetStage.cs" />
  </ItemGroup>

  <!-- The critical Raspberry Pi 4 VL805 reset path is compiled as freestanding
       AArch64 C by Cosmos.Build.CC. The arm64 subdirectory is selected automatically
       by the Cosmos architecture-aware GCCProject override. DirectPInvoke makes the
       NativeAOT call resolve directly to the linked C symbol (no dynamic loader). -->
  <ItemGroup Condition="'$(CosmosArch)' == 'arm64'">
    <GCCProject Include="source/Native/" />
    <DirectPInvoke Include="zq_rpi4_native" />
  </ItemGroup>

  <ItemGroup Condition="'$(CosmosArch)' != 'arm64'">
    <Compile Remove="Rpi4BootKernel.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="source/GUI/Icons/Assets/*.png">
      <LogicalName>Icons.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="source/Wallpapers/*.png">
      <LogicalName>Wallpapers.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
