<Project Sdk="Cosmos.Sdk/3.0.85">

  <PropertyGroup>
    <!-- Keep the feature surface identical on x86_64 and ARM64/QEMU wherever
         Cosmos Gen3 has a backend for both architectures. Networking remains
         intentionally disabled on both profiles. -->
    <CosmosEnableNetwork>false</CosmosEnableNetwork>
    <CosmosEnableStorage>true</CosmosEnableStorage>
    <CosmosEnableMouse>true</CosmosEnableMouse>
    <CosmosEnableKeyboard>true</CosmosEnableKeyboard>
    <CosmosEnableGraphics>true</CosmosEnableGraphics>
    <CosmosEnableScheduler>true</CosmosEnableScheduler>

    <!-- QEMU virt ARM64 uses GICv3, PL011, ACPI/ECAM PCI and VirtIO-MMIO
         keyboard/mouse. PCI is also required for the NVMe data disk used by
         the normal ZonderqOS VFS/storage path. -->
    <CosmosEnableInterrupts Condition="'$(CosmosArch)' == 'arm64'">true</CosmosEnableInterrupts>
    <CosmosEnablePCI Condition="'$(CosmosArch)' == 'arm64'">true</CosmosEnablePCI>
    <CosmosEnableUART Condition="'$(CosmosArch)' == 'arm64'">true</CosmosEnableUART>

    <!-- One kernel and one application surface on both architectures. -->
    <CosmosKernelClass>ZonderqOS.Kernel</CosmosKernelClass>

    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <!-- Keep SDK, kernel and system packages on exactly the same release.
         3.0.85 rebuilds the multi-arch artifacts coherently, which is required
         for ARM64 NativeAOT to see the same public ABI at compile and link time. -->
    <PackageReference Include="Cosmos.Kernel" Version="3.0.85" />
    <PackageReference Include="Cosmos.Kernel.System" Version="3.0.85" />
  </ItemGroup>

  <ItemGroup>
    <!-- Networking is disabled globally for now, so keep its command surface
         out of both architecture builds until the feature is restored. -->
    <Compile Remove="source/Core/CosmosGen3NetworkGlobalUsings.cs" />
    <Compile Remove="source/GUI/Application/LegacyNetworkConfig.cs" />
    <Compile Remove="source/Shell/Commands/CmdNetwork.cs" />
    <Compile Remove="source/Shell/Commands/CmdIp.cs" />
    <Compile Remove="source/Shell/Commands/CmdPing.cs" />
    <Compile Remove="source/Shell/Commands/CmdDns.cs" />

    <!-- The old reduced ARM64 shell kernel is retained in git history only;
         ARM64 now boots the same ZonderqOS.Kernel class as x86_64. -->
    <Compile Remove="Arm64QemuKernel.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="source/GUI/Icons/Assets/*.png">
      <LogicalName>Icons.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="source/Wallpapers/*.png">
      <LogicalName>Wallpapers.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
