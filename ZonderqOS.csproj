<Project Sdk="Cosmos.Sdk/3.0.85">
<PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers><CosmosKernelClass>ZonderqOS.Kernel</CosmosKernelClass><CosmosNetworkStageN2>false</CosmosNetworkStageN2><CosmosNetworkStageN3>false</CosmosNetworkStageN3><CosmosNetworkStageN4>false</CosmosNetworkStageN4><CosmosNetworkStageN5>false</CosmosNetworkStageN5><CosmosNetworkStageN6>false</CosmosNetworkStageN6><CosmosNetworkStageN7>false</CosmosNetworkStageN7><CosmosEnableNetwork>false</CosmosEnableNetwork><CosmosEnableStorage>true</CosmosEnableStorage><CosmosEnableMouse>true</CosmosEnableMouse><CosmosEnableKeyboard>true</CosmosEnableKeyboard><CosmosEnableGraphics>true</CosmosEnableGraphics><CosmosEnableScheduler>true</CosmosEnableScheduler><DefaultItemExcludes>$(DefaultItemExcludes);source/Core/CosmosGen3DiagnosticsCompat.cs;**/CosmosGen3DiagnosticsCompat.cs;source/Core/NetworkN3EntryKernel.cs;source/Core/NetworkN4EntryKernel.cs;source/Core/NetworkN5EntryKernel.cs;source/Core/NetworkN6EntryKernel.cs;source/Core/NetworkN7EntryKernel.cs</DefaultItemExcludes></PropertyGroup>
<PropertyGroup Condition="'$(CosmosArch)' == '' and '$(RuntimeIdentifier)' == 'linux-x64'"><CosmosArch>x64</CosmosArch></PropertyGroup><PropertyGroup Condition="'$(CosmosArch)' == '' and '$(RuntimeIdentifier)' == 'linux-arm64'"><CosmosArch>arm64</CosmosArch></PropertyGroup>
<PropertyGroup Condition="'$(CosmosArch)' == 'x64'"><CosmosEnableNetwork>true</CosmosEnableNetwork><DefineConstants>$(DefineConstants);ZONDERQ_NETWORK_X64</DefineConstants></PropertyGroup>
<PropertyGroup Condition="'$(CosmosArch)' == 'x64' and '$(CosmosNetworkStageN2)' == 'true'"><DefineConstants>$(DefineConstants);ZONDERQ_NETWORK_N2_PROBE</DefineConstants><CosmosKernelClass>ZonderqOS.NetworkN2Kernel</CosmosKernelClass></PropertyGroup>
<PropertyGroup Condition="'$(CosmosArch)' == 'x64' and '$(CosmosNetworkStageN3)' == 'true'"><DefineConstants>$(DefineConstants);ZONDERQ_NETWORK_N3_PROBE</DefineConstants></PropertyGroup>
<PropertyGroup Condition="'$(CosmosArch)' == 'x64' and '$(CosmosNetworkStageN4)' == 'true'"><DefineConstants>$(DefineConstants);ZONDERQ_NETWORK_N4_PROBE</DefineConstants></PropertyGroup>
<PropertyGroup Condition="'$(CosmosArch)' == 'x64' and '$(CosmosNetworkStageN5)' == 'true'"><DefineConstants>$(DefineConstants);ZONDERQ_NETWORK_N5_PROBE</DefineConstants></PropertyGroup>
<PropertyGroup Condition="'$(CosmosArch)' == 'x64' and '$(CosmosNetworkStageN6)' == 'true'"><DefineConstants>$(DefineConstants);ZONDERQ_NETWORK_N6_PROBE</DefineConstants></PropertyGroup>
<PropertyGroup Condition="'$(CosmosArch)' == 'x64' and '$(CosmosNetworkStageN7)' == 'true'"><DefineConstants>$(DefineConstants);ZONDERQ_NETWORK_N7_PROBE</DefineConstants></PropertyGroup>
<PropertyGroup Condition="'$(CosmosArch)' == 'arm64'"><CosmosEnableInterrupts>true</CosmosEnableInterrupts><CosmosEnablePCI>true</CosmosEnablePCI><CosmosEnableUART>true</CosmosEnableUART><DefineConstants>$(DefineConstants);ZONDERQ_NETWORK_DISABLED</DefineConstants></PropertyGroup>
<ItemGroup><PackageReference Include="Cosmos.Kernel" Version="3.0.85"/><PackageReference Include="Cosmos.Kernel.System" Version="3.0.85"/></ItemGroup><ItemGroup Condition="'$(CosmosArch)' == 'arm64'"><Compile Remove="source/Platform/X64/**/*.cs"/></ItemGroup><ItemGroup Condition="'$(CosmosArch)' != 'arm64'"><Compile Remove="source/Platform/Arm64/**/*.cs"/></ItemGroup><ItemGroup><Compile Remove="source/Core/CosmosGen3DiagnosticsCompat.cs"/><Compile Remove="**/CosmosGen3DiagnosticsCompat.cs"/></ItemGroup>
<ItemGroup Condition="'$(CosmosArch)' == 'x64' and '$(CosmosNetworkStageN3)' == 'true'"><Compile Remove="Kernel.cs"/><Compile Remove="source/Core/NetworkN3Kernel.cs"/><Compile Include="source/Core/NetworkN3EntryKernel.cs"/></ItemGroup>
<ItemGroup Condition="'$(CosmosArch)' == 'x64' and '$(CosmosNetworkStageN4)' == 'true'"><Compile Remove="Kernel.cs"/><Compile Remove="source/Core/NetworkN3Kernel.cs"/><Compile Include="source/Core/NetworkN4EntryKernel.cs"/></ItemGroup>
<ItemGroup Condition="'$(CosmosArch)' == 'x64' and '$(CosmosNetworkStageN5)' == 'true'"><Compile Remove="Kernel.cs"/><Compile Remove="source/Core/NetworkN3Kernel.cs"/><Compile Include="source/Core/NetworkN5EntryKernel.cs"/></ItemGroup>
<ItemGroup Condition="'$(CosmosArch)' == 'x64' and '$(CosmosNetworkStageN6)' == 'true'"><Compile Remove="Kernel.cs"/><Compile Remove="source/Core/NetworkN3Kernel.cs"/><Compile Include="source/Core/NetworkN6EntryKernel.cs"/></ItemGroup>
<ItemGroup Condition="'$(CosmosArch)' == 'x64' and '$(CosmosNetworkStageN7)' == 'true'"><Compile Remove="Kernel.cs"/><Compile Remove="source/Core/NetworkN3Kernel.cs"/><Compile Include="source/Core/NetworkN7EntryKernel.cs"/></ItemGroup>
<ItemGroup Condition="'$(CosmosEnableNetwork)' != 'true'"><Compile Remove="source/Shell/Commands/CmdNetwork.cs"/><Compile Remove="source/Shell/Commands/CmdIp.cs"/><Compile Remove="source/Shell/Commands/CmdPing.cs"/><Compile Remove="source/Shell/Commands/CmdDns.cs"/></ItemGroup><ItemGroup><EmbeddedResource Include="source/GUI/Icons/Assets/*.png"><LogicalName>Icons.%(Filename)%(Extension)</LogicalName></EmbeddedResource><EmbeddedResource Include="source/Wallpapers/*.png"><LogicalName>Wallpapers.%(Filename)%(Extension)</LogicalName></EmbeddedResource></ItemGroup>
<Target Name="BindVerifiedNetworkProbeCosmosSystemAssembly" AfterTargets="ResolveAssemblyReferences" BeforeTargets="CoreCompile" Condition="('$(CosmosNetworkStageN2)' == 'true' or '$(CosmosNetworkStageN3)' == 'true' or '$(CosmosNetworkStageN4)' == 'true' or '$(CosmosNetworkStageN5)' == 'true' or '$(CosmosNetworkStageN6)' == 'true' or '$(CosmosNetworkStageN7)' == 'true') and '$(NetworkN2CosmosKernelSystemPath)' != ''"><ItemGroup><_NetworkProbeOldCosmosSystem Include="@(ReferencePath)" Condition="'%(ReferencePath.Filename)' == 'Cosmos.Kernel.System'"/><ReferencePath Remove="@(_NetworkProbeOldCosmosSystem)"/><ReferencePath Include="$(NetworkN2CosmosKernelSystemPath)"><ReferenceSourceTarget>NetworkProbeVerifiedRuntime</ReferenceSourceTarget><Private>false</Private></ReferencePath></ItemGroup><Message Importance="High" Text="Network probe: replaced resolved Cosmos.Kernel.System reference(s) @(_NetworkProbeOldCosmosSystem) with verified assembly $(NetworkN2CosmosKernelSystemPath)"/><Error Condition="'@(_NetworkProbeOldCosmosSystem)' == ''" Text="Network probe: RAR produced no Cosmos.Kernel.System ReferencePath to replace"/></Target>
</Project>
