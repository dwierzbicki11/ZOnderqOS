<Project Sdk="Cosmos.Sdk/3.0.85">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <CosmosArch>x64</CosmosArch>
    <CosmosKernelClass>ZonderqOS.DriverD1EntryKernel</CosmosKernelClass>
    <CosmosEnableNetwork>false</CosmosEnableNetwork>
    <CosmosEnableStorage>false</CosmosEnableStorage>
    <CosmosEnableMouse>false</CosmosEnableMouse>
    <CosmosEnableKeyboard>false</CosmosEnableKeyboard>
    <CosmosEnableGraphics>false</CosmosEnableGraphics>
    <CosmosEnableScheduler>true</CosmosEnableScheduler>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Cosmos.Kernel" Version="3.0.85" />
    <PackageReference Include="Cosmos.Kernel.System" Version="3.0.85" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="DriverD1EntryKernel.cs" />
    <Compile Include="../../source/Hardware/DeviceModel.cs" Link="Hardware/DeviceModel.cs" />
    <Compile Include="../../source/Hardware/PciDeviceModel.cs" Link="Hardware/PciDeviceModel.cs" />
    <Compile Include="../../source/Hardware/PciConfigDiscoverySource.cs" Link="Hardware/PciConfigDiscoverySource.cs" />
    <Compile Include="../../source/Hardware/PciConfigMechanism1.cs" Link="Hardware/PciConfigMechanism1.cs" />
    <Compile Include="../../source/Hardware/HardwareDeviceRegistry.cs" Link="Hardware/HardwareDeviceRegistry.cs" />
    <Compile Include="../../source/Platform/X64/PciConfigIoAccessor.cs" Link="Platform/X64/PciConfigIoAccessor.cs" />
    <Compile Include="../../source/Platform/X64/HardwareDeviceRegistry.X64.cs" Link="Platform/X64/HardwareDeviceRegistry.X64.cs" />
  </ItemGroup>
</Project>
