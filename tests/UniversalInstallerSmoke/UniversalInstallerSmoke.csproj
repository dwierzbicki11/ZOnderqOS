<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8625;CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="Cosmos.Kernel.HAL.UART.Enabled" Value="false" />
    <RuntimeHostConfigurationOption Include="Cosmos.Kernel.System.Storage.Enabled" Value="true" />
    <RuntimeHostConfigurationOption Include="Cosmos.Kernel.System.Filesystems.Fat.Enabled" Value="true" />
    <PackageReference Include="Cosmos.Kernel.System" Version="3.0.99" />
    <PackageReference Include="Cosmos.Kernel.Boot.Limine" Version="3.0.99" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="../../Bootloader/Assets/*">
      <LogicalName>Bootloader.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../source/Common/Crypto.cs" Link="Crypto.cs" />
    <Compile Include="../../source/Core/KernelBuildInfo.cs" Link="KernelBuildInfo.cs" />
    <Compile Include="../../source/Security/PasswordPolicy.cs" Link="PasswordPolicy.cs" />
    <Compile Include="../../source/Security/SecurityContext.cs" Link="SecurityContext.cs" />
    <Compile Include="../../source/Storage/DataVolumePolicy.cs" Link="DataVolumePolicy.cs" />
    <Compile Include="../../source/Storage/RamRootVolume.cs" Link="RamRootVolume.cs" />
    <Compile Include="../../source/Storage/InstallerInputValidator.cs" Link="InstallerInputValidator.cs" />
    <Compile Include="../../source/Storage/FilesystemSignatureProbe.cs" Link="FilesystemSignatureProbe.cs" />
    <Compile Include="../../source/Storage/DiskIdentityToken.cs" Link="DiskIdentityToken.cs" />
    <Compile Include="../../source/Storage/InstallerStepTracker.cs" Link="InstallerStepTracker.cs" />
    <Compile Include="../../source/Storage/LimineBootMediaDetector.cs" Link="LimineBootMediaDetector.cs" />
    <Compile Include="../../source/Storage/DiskCatalog.cs" Link="DiskCatalog.cs" />
    <Compile Include="../../source/Storage/DualBootManager.cs" Link="DualBootManager.cs" />
    <Compile Include="../../source/Storage/DiskFormattingEngine.cs" Link="DiskFormattingEngine.cs" />
    <Compile Include="../../source/Storage/SystemInstallerEngine.cs" Link="SystemInstallerEngine.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

</Project>
