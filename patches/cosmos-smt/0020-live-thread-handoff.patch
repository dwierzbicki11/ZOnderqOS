+// int _native_x64_disarm_scheduler_timer()
+// Masks the current CPU's private scheduler timer before a live thread is
+// handed to another CPU. Without this, the old owner would keep receiving
+// periodic vector-0xEF interrupts after it had returned to idle.
+.global _native_x64_disarm_scheduler_timer
+_native_x64_disarm_scheduler_timer:
+    mov rax, qword ptr [rip + _native_x64_lapic_base]
+    test rax, rax
+    jz .Lap_disarm_scheduler_timer_failure
+    mov dword ptr [rax + 0x320], 0x000100EF
+    mov dword ptr [rax + 0x380], 0
+    mfence
+    mov eax, 1
+    ret
+.Lap_disarm_scheduler_timer_failure:
+    xor eax, eax
+    ret
