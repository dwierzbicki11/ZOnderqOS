@@ -307,5 +307,20 @@ _native_get_sp:
     mov rax, rsp
     ret
 
+// uint _native_get_hardware_cpu_id(void)
+// Return the current processor's initial xAPIC ID. Stage 1 explicitly keeps
+// x2APIC disabled, so CPUID.1:EBX[31:24] is the hardware identifier used by
+// the Limine MP table. Managed CpuIdentity maps it to a dense scheduler index.
+.global _native_get_hardware_cpu_id
+_native_get_hardware_cpu_id:
+    push rbx
+    mov eax, 1
+    xor ecx, ecx
+    cpuid
+    shr ebx, 24
+    mov eax, ebx
+    pop rbx
+    ret
+
