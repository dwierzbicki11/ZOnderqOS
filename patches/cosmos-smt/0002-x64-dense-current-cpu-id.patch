diff --git a/src/Cosmos.Kernel.Core/Scheduler/CpuIdentity.cs b/src/Cosmos.Kernel.Core/Scheduler/CpuIdentity.cs
new file mode 100644
--- /dev/null
+++ b/src/Cosmos.Kernel.Core/Scheduler/CpuIdentity.cs
@@ -0,0 +1,141 @@
+using Cosmos.Kernel.Boot.Limine;
+using Cosmos.Kernel.Core.Bridge;
+
+namespace Cosmos.Kernel.Core.Scheduler;
+
+/// <summary>
+/// Maps architecture hardware CPU identifiers to the scheduler's dense 0..N-1
+/// CPU indexes. APs are still parked during stage 2, so the table is immutable
+/// after boot-time initialization and needs no locking on the hot path.
+/// </summary>
+internal static unsafe class CpuIdentity
+{
+#if ARCH_X64
+    private const int XApicTableSize = 256;
+    private const uint InvalidCpuIndex = uint.MaxValue;
+    private const uint DiscoveredCpuMarker = uint.MaxValue - 1;
+
+    private static uint[]? s_xapicToCpuIndex;
+#endif
+
+    internal static void Initialize(uint cpuCount)
+    {
+#if ARCH_X64
+        LimineMpResponseX64* response = LimineMp.X64Response;
+        if (response == null || response->Cpus == null)
+        {
+            Cosmos.Kernel.Core.Panic.Halt("SMT stage 2 requires a valid Limine MP response.");
+            return;
+        }
+
+        if ((response->Flags & LimineMp.X64ResponseFlagX2Apic) != 0)
+        {
+            Cosmos.Kernel.Core.Panic.Halt("SMT stage 2 requires xAPIC mode.");
+            return;
+        }
+
+        if (cpuCount == 0 || cpuCount > XApicTableSize || response->CpuCount != cpuCount)
+        {
+            Cosmos.Kernel.Core.Panic.Halt("SMT stage 2 CPU count does not match Limine MP topology.");
+            return;
+        }
+
+        uint[] map = new uint[XApicTableSize];
+        for (int i = 0; i < map.Length; i++)
+        {
+            map[i] = InvalidCpuIndex;
+        }
+
+        bool bspSeen = false;
+        for (ulong i = 0; i < response->CpuCount; i++)
+        {
+            LimineMpInfoX64* cpu = response->Cpus[i];
+            if (cpu == null || cpu->LapicId >= XApicTableSize)
+            {
+                Cosmos.Kernel.Core.Panic.Halt("SMT stage 2 found an invalid xAPIC CPU descriptor.");
+                return;
+            }
+
+            int xapicId = (int)cpu->LapicId;
+            if (map[xapicId] != InvalidCpuIndex)
+            {
+                Cosmos.Kernel.Core.Panic.Halt("SMT stage 2 found duplicate xAPIC IDs.");
+                return;
+            }
+
+            if (cpu->LapicId == response->BspLapicId)
+            {
+                map[xapicId] = 0;
+                bspSeen = true;
+            }
+            else
+            {
+                map[xapicId] = DiscoveredCpuMarker;
+            }
+        }
+
+        if (!bspSeen)
+        {
+            Cosmos.Kernel.Core.Panic.Halt("SMT stage 2 could not find the BSP in Limine MP topology.");
+            return;
+        }
+
+        uint nextCpuIndex = 1;
+        for (ulong i = 0; i < response->CpuCount; i++)
+        {
+            LimineMpInfoX64* cpu = response->Cpus[i];
+            if (cpu->LapicId == response->BspLapicId)
+            {
+                continue;
+            }
+
+            map[(int)cpu->LapicId] = nextCpuIndex++;
+        }
+
+        if (nextCpuIndex != cpuCount)
+        {
+            Cosmos.Kernel.Core.Panic.Halt("SMT stage 2 produced an incomplete dense CPU map.");
+            return;
+        }
+
+        uint currentXapicId = ContextSwitchNative.GetCurrentHardwareCpuId();
+        if (currentXapicId != response->BspLapicId || map[(int)currentXapicId] != 0)
+        {
+            Cosmos.Kernel.Core.Panic.Halt("SMT stage 2 BSP identity validation failed.");
+            return;
+        }
+
+        s_xapicToCpuIndex = map;
+#endif
+    }
+
+    internal static uint GetCurrentCpuIndex()
+    {
+#if ARCH_X64
+        uint[]? map = s_xapicToCpuIndex;
+        if (map is null)
+        {
+            // Preserve the pre-scheduler boot contract: only the BSP executes.
+            return 0;
+        }
+
+        uint xapicId = ContextSwitchNative.GetCurrentHardwareCpuId();
+        if (xapicId >= XApicTableSize)
+        {
+            Cosmos.Kernel.Core.Panic.Halt("Current xAPIC ID is outside the stage 2 map.");
+            return 0;
+        }
+
+        uint cpuIndex = map[(int)xapicId];
+        if (cpuIndex == InvalidCpuIndex || cpuIndex == DiscoveredCpuMarker)
+        {
+            Cosmos.Kernel.Core.Panic.Halt("Current xAPIC ID is not present in Limine MP topology.");
+            return 0;
+        }
+
+        return cpuIndex;
+#else
+        return 0;
+#endif
+    }
+}
