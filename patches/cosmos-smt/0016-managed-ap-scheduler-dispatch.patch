+            thread.CpuId != expectedCpuId || ReferenceEquals(thread, state.IdleThread) ||
+            thread.State != SchedulerThreadState.Running ||
+            !state.TryEnterStage16Dispatch(expectedCpuId, thread.Id))
+        {
+            Panic.Halt("Stage 16 AP scheduler thread entered with invalid ownership.");
+            return;
+        }
+
+        // Keep interrupts masked while the worker publishes completion and
+        // leaves the scheduler. Arm the timer only after ExitThread: arming it
+        // in the native idle command races vector 0xEF against the dispatch
+        // IPI and can make the timer enter the managed scheduler first.
+        using (InternalCpu.DisableInterruptsScope())
+        {
+            ulong checksum = ComputeStage16Checksum(expectedCpuId, thread.Id);
+            if (!state.TryCompleteStage16Dispatch(expectedCpuId, thread.Id, checksum))
+            {
+                Panic.Halt("Stage 16 AP scheduler thread failed to publish completion.");
+                return;
+            }
