+using System.Runtime.InteropServices;
+using Cosmos.Kernel.Core.CPU;
+using Cosmos.Kernel.Core.Scheduler;
+
+namespace Cosmos.Kernel.Core.Bridge;
+
+/// <summary>
+/// Initial instruction pointer for the Stage-16 scheduler thread. Unlike the
+/// earlier AP exports this entry is reached by the normal interrupt-return
+/// context-switch path on the thread's separately allocated scheduler stack.
+/// </summary>
+internal static class ManagedApSchedulerThreadNative
+{
+    [UnmanagedCallersOnly]
+    internal static void Entry(uint expectedCpuId)
+    {
+        SchedulerManager.RunStage16DispatchedThread(expectedCpuId);
+
+        // A completed thread is switched away by the AP LAPIC timer. It must
+        // never return: the initial context was entered with a jump, not call.
+        while (true)
+        {
+            InternalCpu.Halt();
+        }
+    }
+}
