+    /// <summary>
+    /// Creates one real scheduler thread per AP, enqueues it in that CPU's
+    /// Stride run queue and dispatches CPUs one at a time through the common
+    /// x64 IRQ context-switch path. Each worker runs on its allocated stack,
+    /// observes itself as CurrentThread, exits through the scheduler lifecycle
+    /// and is switched back to the enrolled AP idle context by the LAPIC timer.
+    /// </summary>
+    internal static unsafe bool RunManagedApplicationProcessorSchedulerDispatchProof()
+    {
+        if (!s_enabled || s_currentScheduler is null || s_cpuStates is null ||
+            s_cpuCount == 0 || !GarbageCollector.IsEnabled)
+        {
+            Serial.WriteString("[SCHED] WARNING: Stage 16 dispatch prerequisites are not initialized.\n");
+            return false;
+        }
+
+#if ARCH_X64
+        // The vector is delivered as a real LAPIC self-IPI, so the normal EOI
+        // and pending-reschedule path are both exercised.
+        InterruptManager.SetHandler(Stage16DispatchVector, Stage16DispatchInterrupt);
+
+        SchedulerThread?[] workers = new SchedulerThread?[checked((int)s_cpuCount)];
+        ushort codeSelector = (ushort)NativeGetCodeSelector();
+        nuint entryPoint = (nuint)(delegate* unmanaged<uint, void>)&ManagedApSchedulerThreadNative.Entry;
+
+        for (uint cpuId = 1; cpuId < s_cpuCount; cpuId++)
+        {
+            PerCpuState state = s_cpuStates[cpuId];
+            if (!state.Stage15IdleStackEnrolled || state.Stage16DispatchState != 0 ||
+                state.Stage16DispatchCount != 0 || state.IdleThread is null ||
+                !ReferenceEquals(state.CurrentThread, state.IdleThread))
+            {
+                Serial.WriteString("[SCHED] WARNING: Stage 16 per-CPU state is not dispatchable.\n");
+                return false;
+            }
+
+            SchedulerThread worker = new()
+            {
+                Id = AllocateThreadId(),
+                CpuId = cpuId,
+                State = SchedulerThreadState.Created,
+                Flags = SchedulerThreadFlags.Pinned
+            };
+            worker.InitializeStack(entryPoint, codeSelector, cpuId);
+            CreateThread(cpuId, worker);
+            ReadyThread(cpuId, worker);
+            workers[cpuId] = worker;
+        }
+
+        long frequency = Stopwatch.Frequency;
+        ulong timeoutTicks = frequency > 0
+            ? checked((ulong)frequency * Stage16TimeoutSeconds)
+            : 5_000_000_000UL;
+
+        for (uint cpuId = 1; cpuId < s_cpuCount; cpuId++)
+        {
+            SchedulerThread? worker = workers[cpuId];
+            int result = NativeRunSchedulerDispatchTest(cpuId, timeoutTicks);
+            PerCpuState state = s_cpuStates[cpuId];
+            ulong expectedChecksum = ComputeStage16Checksum(cpuId, worker?.Id ?? 0);
+            if (result != 1 || worker is null || worker.State != SchedulerThreadState.Dead ||
+                state.Stage16DispatchState != 2 || state.Stage16DispatchCount != 1 ||
+                state.Stage16ThreadId != worker.Id || state.Stage16Checksum != expectedChecksum ||
+                !ReferenceEquals(state.CurrentThread, state.IdleThread) ||
+                state.IdleThread?.State != SchedulerThreadState.Running)
+            {
+                Serial.WriteString("[SCHED] WARNING: Stage 16 AP dispatch failed for CpuId=");
+                Serial.WriteNumber(cpuId);
+                Serial.WriteString(".\n");
+                return false;
+            }
+
+            Serial.WriteString("[SCHED-AP-DISPATCH] cpu=");
+            Serial.WriteNumber(cpuId);
+            Serial.WriteString(" thread=");
+            Serial.WriteNumber(worker.Id);
+            Serial.WriteString(" checksum=");
+            Serial.WriteHexWithPrefix(expectedChecksum);
+            Serial.WriteString(" state=exited-idle-restored\n");
+        }
