@@ -108,5 +108,18 @@ internal class LibraryInitializer
         // Enable scheduler (timer will start invoking it)
         SchedulerManager.IsRunning = true;
         Serial.WriteString("[SCHED] Scheduler enabled\n");
+
+        // Stage 13: run only after the scheduler manager, policy, idle
+        // threads, and every PerCpuState have been initialized. APs still
+        // return to the native parked loop; this is not full SMP scheduling
+        // or preemption.
+        if (CpuLocal.IsNativePerCpuSupported)
