index 000000000..39f317560
--- /dev/null
+++ b/src/Cosmos.Kernel.Core/Bridge/Export/PerCpuSchedulerNative.cs
@@ -0,0 +1,50 @@
+#if ARCH_X64
+using System;
+using System.Runtime.InteropServices;
+using Cosmos.Kernel.Core.Runtime;
+using Cosmos.Kernel.Core.CPU;
+
+namespace Cosmos.Kernel.Core.Bridge;
+
+/// <summary>
+/// Stage-13 managed entry used only to validate the AP's CPU-local identity.
+/// The BSP owns the managed PerCpuState enter/leave proof; an AP must not walk
+/// the scheduler object graph until a later stage gives it a managed thread
+/// and full runtime/GC participation. This entry returns to native idle after
+/// one bounded identity check.
+/// </summary>
+internal static partial class PerCpuSchedulerNative
+{
+    [LibraryImport("*", EntryPoint = "_native_x64_publish_percpu_scheduler_result")]
+    [SuppressGCTransition]
+    private static partial int NativePublishResult(
+        uint cpuId,
+        uint phase,
+        uint entryCount);
+
+    /// <summary>
+    /// Performs one bounded CPU-local identity proof for the AP. The matching
+    /// managed PerCpuState lifecycle proof is performed by the BSP before the
+    /// native AP command is published.
+    /// </summary>
+    [UnmanagedCallersOnly(EntryPoint = "__cosmos_smp_percpu_scheduler_entry")]
+    public static uint Entry(uint expectedCpuId)
+    {
+        StartupCodeHelpers.RhpReversePInvoke(IntPtr.Zero);
+
+        uint cpuId = CpuLocal.CurrentCpuId;
+        uint status = cpuId == 0 || cpuId != expectedCpuId ? 1u : 0u;
+        uint phase = status == 0 ? 2u : 0u;
+        uint entryCount = status == 0 ? 1u : 0u;
+
+        if (status == 0 &&
+            NativePublishResult(expectedCpuId, phase, entryCount) != 0)
+        {
+            status = 7;
+        }
+
+        StartupCodeHelpers.RhpReversePInvokeReturn(IntPtr.Zero);
+        return status;
+    }
+}
+#endif
diff --git a/src/Cosmos.Kernel.Core/Scheduler/PerCpuState.cs b/src/Cosmos.Kernel.Core/Scheduler/PerCpuState.cs
index 27ea1c851..381c33539 100644
--- a/src/Cosmos.Kernel.Core/Scheduler/PerCpuState.cs
+++ b/src/Cosmos.Kernel.Core/Scheduler/PerCpuState.cs
@@ -1,4 +1,5 @@
 using System.Diagnostics.CodeAnalysis;
+using System.Threading;
 
 namespace Cosmos.Kernel.Core.Scheduler;
 
@@ -48,4 +49,42 @@ public sealed class PerCpuState : SchedulerExtensible
 
     // ===== Synchronization =====
     internal SpinLock _lock;
+
+    // Stage 13 is deliberately a one-shot ownership handshake, not a
+    // scheduler activation. The BSP validates this exact managed state and
+    // performs one enter/leave transition for it; the AP separately proves
+    // its CPU-local identity before returning to the native parked path. A
+    // later stage will replace this proof with real AP idle threads and
+    // dispatch/context-switch ownership.
+    private int _stage13Phase;
+    private int _stage13EntryCount;
+
+    /// <summary>
+    /// Stage-13 per-CPU scheduler foundation phase: 0=not entered,
+    /// 1=entered, 2=left successfully.
+    /// </summary>
+    internal uint Stage13Phase => (uint)Volatile.Read(ref _stage13Phase);
+
+    /// <summary>
+    /// Number of successful Stage-13 entries for this CPU.
+    /// </summary>
+    internal uint Stage13EntryCount => (uint)Volatile.Read(ref _stage13EntryCount);
+
+    internal bool TryEnterStage13(uint expectedCpuId)
+    {
+        if (CpuId != expectedCpuId ||
+            Interlocked.CompareExchange(ref _stage13Phase, 1, 0) != 0)
+        {
+            return false;
+        }
+
+        Interlocked.Increment(ref _stage13EntryCount);
+        return true;
+    }
+
+    internal bool TryLeaveStage13(uint expectedCpuId)
+    {
+        return CpuId == expectedCpuId &&
+            Interlocked.CompareExchange(ref _stage13Phase, 2, 1) == 1;
+    }
 }
