index 000000000..4ecf5da48
--- /dev/null
+++ b/src/Cosmos.Kernel.Core/Bridge/Export/PerCpuSchedulerNative.cs
@@ -0,0 +1,47 @@
+#if ARCH_X64
+using System;
+using System.Runtime.InteropServices;
+using Cosmos.Kernel.Core.Runtime;
+using Cosmos.Kernel.Core.Scheduler;
+
+namespace Cosmos.Kernel.Core.Bridge;
+
+/// <summary>
+/// Stage-13 managed entry used only to validate the per-CPU scheduler state
+/// created during normal scheduler initialization. It does not schedule a
+/// managed thread and returns to the native AP idle loop after one transition.
+/// </summary>
+internal static partial class PerCpuSchedulerNative
+{
+    [LibraryImport("*", EntryPoint = "_native_x64_publish_percpu_scheduler_result")]
+    [SuppressGCTransition]
+    private static partial int NativePublishResult(
+        uint cpuId,
+        uint phase,
+        uint entryCount);
+
+    /// <summary>
+    /// Performs one bounded enter/leave proof against the AP's dense
+    /// scheduler CpuId and managed PerCpuState.
+    /// </summary>
+    [UnmanagedCallersOnly(EntryPoint = "__cosmos_smp_percpu_scheduler_entry")]
+    public static uint Entry(uint expectedCpuId)
+    {
+        StartupCodeHelpers.RhpReversePInvoke(IntPtr.Zero);
+
+        uint status = SchedulerManager.RunPerCpuSchedulerEntry(
+            expectedCpuId,
+            out uint phase,
+            out uint entryCount);
+
+        if (status == 0 &&
+            NativePublishResult(expectedCpuId, phase, entryCount) != 0)
+        {
+            status = 7;
+        }
+
+        StartupCodeHelpers.RhpReversePInvokeReturn(IntPtr.Zero);
+        return status;
+    }
+}
+#endif
diff --git a/src/Cosmos.Kernel.Core/Scheduler/PerCpuState.cs b/src/Cosmos.Kernel.Core/Scheduler/PerCpuState.cs
