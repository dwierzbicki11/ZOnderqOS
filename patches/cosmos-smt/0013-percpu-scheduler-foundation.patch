+// int _native_x64_run_percpu_scheduler_test(uint64_t cpuCount,
+//                                           uint64_t timeoutTscTicks)
+// Wakes every parked AP with command 6. The managed entry validates the
+// scheduler's real PerCpuState for that CpuId and performs one enter/leave
+// transition. The AP then returns to native idle; no managed thread is run.
+.global _native_x64_run_percpu_scheduler_test
+_native_x64_run_percpu_scheduler_test:
+    push rbx
+    push r12
+    push r13
+    push r14
+    push r15
+    test rdi, rdi
+    jz .Lap_scheduler_test_invalid
+    cmp rdi, 256
+    ja .Lap_scheduler_test_invalid
+    test rsi, rsi
+    jz .Lap_scheduler_test_invalid
+    mov r12, rdi
+    mov r13, rsi
+    cmp r12, 1
+    je .Lap_scheduler_test_success
+    call .Lap_read_lapic_base
+    test rax, rax
+    jz .Lap_scheduler_test_invalid
+    mov qword ptr [rip + _native_x64_lapic_base], rax
+    mov r15, rax
+    xor r14d, r14d
+    mov ebx, 1
+
+.Lap_scheduler_test_cpu_loop:
+    cmp rbx, r12
+    jae .Lap_scheduler_test_success
+    lea r8, [rip + _ap_boot_state]
+    mov rax, rbx
+    shl rax, 6
+    add r8, rax
+    cmp dword ptr [r8 + 0], 1
+    jne .Lap_scheduler_test_invalid
+    cmp dword ptr [r8 + 32], 0
+    jne .Lap_scheduler_test_invalid
+    cmp dword ptr [r8 + 48], 1
+    jne .Lap_scheduler_test_invalid
+    cmp qword ptr [r8 + 56], 8
+    jne .Lap_scheduler_test_invalid
+
+    lea r9, [rip + _ap_scheduler_state]
+    mov rax, rbx
+    shl rax, 6
+    add r9, rax
+    cmp dword ptr [r9 + 0], 0
+    jne .Lap_scheduler_test_invalid
+    mov dword ptr [r9 + 4], 0
+    mov dword ptr [r9 + 8], 0
+    mfence
+
+    xor eax, eax
+    xchg dword ptr [r8 + 48], eax
+    cmp eax, 1
+    jne .Lap_scheduler_test_invalid
+    mov eax, 6
+    xchg dword ptr [r8 + 32], eax
+    test eax, eax
+    jne .Lap_scheduler_test_invalid
+
+    mov edx, dword ptr [r8 + 8]
+    shl edx, 24
+    mov dword ptr [r15 + 0x310], edx
+    mov dword ptr [r15 + 0x300], 0x000000F1
+    rdtsc
+    shl rdx, 32
+    or rax, rdx
+    mov r11, rax
+
+.Lap_scheduler_test_wait:
+    cmp dword ptr [r9 + 0], 2
+    je .Lap_scheduler_test_failure
+    cmp dword ptr [r9 + 0], 1
+    jne .Lap_scheduler_test_poll
+    cmp dword ptr [r9 + 4], 2
+    jne .Lap_scheduler_test_poll
+    cmp dword ptr [r9 + 8], 1
+    jne .Lap_scheduler_test_poll
+    cmp dword ptr [r8 + 48], 1
+    jne .Lap_scheduler_test_poll
+    cmp dword ptr [r8 + 32], 0
+    jne .Lap_scheduler_test_poll
+    cmp qword ptr [r8 + 56], 9
+    jne .Lap_scheduler_test_poll
+    inc r14
+    inc rbx
+    jmp .Lap_scheduler_test_cpu_loop
+
+.Lap_scheduler_test_poll:
+    pause
+    rdtsc
+    shl rdx, 32
+    or rax, rdx
+    sub rax, r11
+    cmp rax, r13
+    jb .Lap_scheduler_test_wait
+    jmp .Lap_scheduler_test_failure
+
+.Lap_scheduler_test_success:
+    mov eax, r14d
+    jmp .Lap_scheduler_test_return
+.Lap_scheduler_test_failure:
+    mov eax, -3
+    jmp .Lap_scheduler_test_return
+.Lap_scheduler_test_invalid:
+    mov eax, -2
+.Lap_scheduler_test_return:
+    pop r15
+    pop r14
+    pop r13
+    pop r12
+    pop rbx
+    ret
+
+
 // int _native_x64_run_ap_timer_test(uint64_t cpuCount,
 //                                    uint32_t initialCount,
 //                                    uint64_t minimumTicks,
@@ -1970,6 +2184,12 @@ _ap_managed_state: .zero 1024
 .balign 64
 _ap_managed_result: .zero 2048
 
+.balign 64
+// Stage-13 per-CPU scheduler foundation mailboxes. Each 64-byte record is:
+// +0 native completion (0=idle, 1=managed proof returned, 2=managed failure),
+// +4 managed enter/leave phase, +8 successful managed entry count.
+_ap_scheduler_state: .zero 16384
+
 .balign 64
 // 256 cache-line-isolated records:
 // request_epoch, ack_epoch, resume_epoch, state, padding,
