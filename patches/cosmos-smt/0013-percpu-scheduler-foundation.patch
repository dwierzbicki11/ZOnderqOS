+    /// <summary>
+    /// Validates one AP's addressability of its scheduler state and performs
+    /// one enter/leave transition. This is deliberately not a dispatch,
+    /// context switch, migration or preemption path: the AP returns to the
+    /// native parked loop immediately after this bounded proof.
+    /// </summary>
+    internal static uint RunPerCpuSchedulerEntry(
+        uint expectedCpuId,
+        out uint phase,
+        out uint entryCount)
+    {
+        phase = 0;
+        entryCount = 0;
+
+        if (!s_enabled || s_currentScheduler is null || s_cpuStates is null)
+        {
+            return 1;
+        }
+
+        if (expectedCpuId >= s_cpuCount || GetCurrentCpuId() != expectedCpuId)
+        {
+            return 2;
+        }
+
+        PerCpuState state = s_cpuStates[expectedCpuId];
+        if (state.CpuId != expectedCpuId ||
+            state.IdleThread is null ||
+            state.CurrentThread is null ||
+            !ReferenceEquals(state.CurrentThread, state.IdleThread) ||
+            state.CurrentThread.State != SchedulerThreadState.Running ||
+            state.SchedulerData is null)
+        {
+            return 3;
+        }
+
+        if (!state.TryEnterStage13(expectedCpuId))
+        {
+            return 4;
+        }
+
+        if (!state.TryLeaveStage13(expectedCpuId))
+        {
+            return 5;
+        }
+
+        phase = state.Stage13Phase;
+        entryCount = state.Stage13EntryCount;
+        return phase == 2 && entryCount == 1 ? 0u : 6u;
+    }
+
+    /// <summary>
+    /// Runs the Stage-13 per-CPU scheduler foundation proof after the
+    /// scheduler policy and all per-CPU states have been initialized.
+    /// x64 APs enter the managed validation export once and return to native
+    /// HLT; this method does not claim a full SMP scheduler or preemption.
+    /// </summary>
+    internal static bool RunPerCpuSchedulerFoundationProof()
+    {
+        if (!s_enabled || s_currentScheduler is null ||
+            s_cpuStates is null || s_cpuCount == 0)
+        {
+            Serial.WriteString("[SCHED] WARNING: Stage 13 scheduler state is not initialized.\n");
+            return false;
+        }
+
+        PerCpuState bsp = s_cpuStates[0];
+        if (bsp.CpuId != 0 || bsp.IdleThread is null ||
+            !ReferenceEquals(bsp.CurrentThread, bsp.IdleThread) ||
+            bsp.CurrentThread.State != SchedulerThreadState.Running ||
+            bsp.SchedulerData is null)
+        {
+            Serial.WriteString("[SCHED] WARNING: Stage 13 BSP per-CPU state is invalid.\n");
+            return false;
+        }
+
+#if ARCH_X64
+        long frequency = Stopwatch.Frequency;
+        ulong timeoutTicks = frequency > 0
+            ? checked((ulong)frequency * Stage13TimeoutSeconds)
+            : 5_000_000_000UL;
+        int expectedAps = checked((int)s_cpuCount - 1);
+        int completed = expectedAps == 0
+            ? 0
+            : NativeRunPerCpuSchedulerTest(s_cpuCount, timeoutTicks);
+        if (completed != expectedAps)
+        {
+            Serial.WriteString("[SCHED] WARNING: Stage 13 AP scheduler-state proof result=");
+            if (completed < 0)
+            {
+                Serial.WriteString("-");
+                Serial.WriteNumber((ulong)(-completed));
+            }
+            else
+            {
+                Serial.WriteNumber((ulong)completed);
+            }
+
+            Serial.WriteString(" expected=");
+            Serial.WriteNumber((ulong)expectedAps);
+            Serial.WriteString("\n");
+            return false;
+        }
+
+        Serial.WriteString("[SCHED-PERCPU] cpu=0 phase=0 entries=0 state=bsp-idle\n");
+        for (uint cpuId = 1; cpuId < s_cpuCount; cpuId++)
+        {
+            PerCpuState state = s_cpuStates[cpuId];
+            uint nativeState = NativeGetPerCpuSchedulerState(cpuId);
+            uint nativePhase = NativeGetPerCpuSchedulerPhase(cpuId);
+            uint nativeEntries = NativeGetPerCpuSchedulerEntries(cpuId);
+            if (state.CpuId != cpuId || state.IdleThread is null ||
+                state.CurrentThread is null ||
+                !ReferenceEquals(state.CurrentThread, state.IdleThread) ||
+                state.CurrentThread.State != SchedulerThreadState.Running ||
+                state.SchedulerData is null ||
+                state.Stage13Phase != 2 || state.Stage13EntryCount != 1 ||
+                nativeState != 1 || nativePhase != 2 || nativeEntries != 1)
+            {
+                Serial.WriteString("[SCHED] WARNING: Stage 13 state mismatch for CpuId=");
+                Serial.WriteNumber(cpuId);
+                Serial.WriteString("\n");
+                return false;
+            }
+
+            Serial.WriteString("[SCHED-PERCPU] cpu=");
+            Serial.WriteNumber(cpuId);
+            Serial.WriteString(" phase=");
+            Serial.WriteNumber(nativePhase);
+            Serial.WriteString(" entries=");
+            Serial.WriteNumber(nativeEntries);
+            Serial.WriteString(" state=returned-native-idle\n");
+        }
+#else
+        // ARM64 keeps its existing CPU0-only scheduler path. It is compiled
+        // by the regression job but has no Stage-13 AP runtime claim.
+        return true;
+#endif
+
+        Serial.WriteString("[SCHED-PERCPU-TEST] PASS\n");
+        return true;
+    }
+
     /// <summary>
     /// Allocates a new unique thread ID.
     /// </summary>
