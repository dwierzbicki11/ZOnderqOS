+++ b/src/Cosmos.Kernel.Core/Scheduler/PerCpuState.cs
@@ -1,4 +1,5 @@
 using System.Diagnostics.CodeAnalysis;
+using System.Threading;
 
 namespace Cosmos.Kernel.Core.Scheduler;
 
@@ -48,4 +49,41 @@ public sealed class PerCpuState : SchedulerExtensible
 
     // ===== Synchronization =====
     internal SpinLock _lock;
+
+    // Stage 13 is deliberately a one-shot ownership handshake, not a
+    // scheduler activation.  The AP proves that it can address this exact
+    // managed PerCpuState, enters and leaves the state once, and then returns
+    // to the native parked path.  A later stage will replace this proof with
+    // real AP idle threads and dispatch/context-switch ownership.
+    private int _stage13Phase;
+    private int _stage13EntryCount;
+
+    /// <summary>
+    /// Stage-13 per-CPU scheduler foundation phase: 0=not entered,
+    /// 1=entered, 2=left successfully.
+    /// </summary>
+    internal uint Stage13Phase => (uint)Volatile.Read(ref _stage13Phase);
+
+    /// <summary>
+    /// Number of successful Stage-13 entries for this CPU.
+    /// </summary>
+    internal uint Stage13EntryCount => (uint)Volatile.Read(ref _stage13EntryCount);
+
+    internal bool TryEnterStage13(uint expectedCpuId)
+    {
+        if (CpuId != expectedCpuId ||
+            Interlocked.CompareExchange(ref _stage13Phase, 1, 0) != 0)
+        {
+            return false;
+        }
+
+        Interlocked.Increment(ref _stage13EntryCount);
+        return true;
+    }
+
+    internal bool TryLeaveStage13(uint expectedCpuId)
+    {
+        return CpuId == expectedCpuId &&
+            Interlocked.CompareExchange(ref _stage13Phase, 2, 1) == 1;
+    }
 }
