+.Lap_managed_residency_end_wait:
+    xor r14d, r14d
+    xor r15d, r15d
+    mov ebx, 1
+.Lap_managed_residency_end_check:
+    cmp rbx, r12
+    jae .Lap_managed_residency_end_all_quiescent
