+    mov rax, rbx
+    shl rax, 6
+    add r8, rax
+    lea r9, [rip + _ap_managed_residency_state]
+    mov rax, rbx
+    shl rax, 6
+    add r9, rax
+
+    cmp dword ptr [r9 + 0], 2
+    je .Lap_managed_residency_end_check_success
+    cmp dword ptr [r9 + 0], 3
+    je .Lap_managed_residency_end_check_failed_return
+    cmp dword ptr [r9 + 0], 0
+    je .Lap_managed_residency_end_check_not_started
+    jmp .Lap_managed_residency_end_poll
+
+.Lap_managed_residency_end_check_success:
+    cmp qword ptr [r9 + 8], 0
+    je .Lap_managed_residency_end_poll
+    cmp dword ptr [r8 + 32], 0
+    jne .Lap_managed_residency_end_poll
+    cmp dword ptr [r8 + 48], 1
+    jne .Lap_managed_residency_end_poll
+    cmp qword ptr [r8 + 56], 10
+    jne .Lap_managed_residency_end_poll
+    inc r14d
+    inc rbx
+    jmp .Lap_managed_residency_end_check
+
+.Lap_managed_residency_end_check_failed_return:
+    cmp dword ptr [r8 + 32], 0
+    jne .Lap_managed_residency_end_poll
+    cmp dword ptr [r8 + 48], 2
+    jne .Lap_managed_residency_end_poll
+    cmp qword ptr [r8 + 56], 10
+    jne .Lap_managed_residency_end_poll
+    mov r15d, 1
+    inc r14d
+    inc rbx
+    jmp .Lap_managed_residency_end_check
+
+.Lap_managed_residency_end_check_not_started:
+    cmp dword ptr [r8 + 32], 0
+    jne .Lap_managed_residency_end_poll
+    cmp dword ptr [r8 + 48], 1
+    jne .Lap_managed_residency_end_poll
+    cmp qword ptr [r8 + 56], 9
+    jne .Lap_managed_residency_end_poll
+    mov r15d, 1
+    inc r14d
+    inc rbx
+    jmp .Lap_managed_residency_end_check
+
+.Lap_managed_residency_end_all_quiescent:
+    mov eax, r12d
+    dec eax
+    cmp r14d, eax
+    jne .Lap_managed_residency_end_poll
+    test r15d, r15d
+    jnz .Lap_managed_residency_end_failure
+    jmp .Lap_managed_residency_end_return
+
+.Lap_managed_residency_end_poll:
+    pause
+    rdtsc
+    shl rdx, 32
+    or rax, rdx
+    sub rax, r11
+    cmp rax, r13
+    jb .Lap_managed_residency_end_wait
+    mov eax, -1
+    jmp .Lap_managed_residency_end_return
+
+.Lap_managed_residency_end_single:
+    xor eax, eax
+    jmp .Lap_managed_residency_end_return
+.Lap_managed_residency_end_failure:
+    mov eax, -3
+    jmp .Lap_managed_residency_end_return
+.Lap_managed_residency_end_invalid:
+    mov eax, -2
+.Lap_managed_residency_end_return:
+    pop r15
+    pop r14
+    pop r13
+    pop r12
+    pop rbx
+    ret
