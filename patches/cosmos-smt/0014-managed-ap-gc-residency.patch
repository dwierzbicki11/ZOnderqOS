+.global _native_x64_end_managed_residency
+_native_x64_end_managed_residency:
+    push rbx
+    push r12
+    push r13
+    push r14
+    push r15
+    test rdi, rdi
+    jz .Lap_managed_residency_end_invalid
+    cmp rdi, 256
+    ja .Lap_managed_residency_end_invalid
+    test rsi, rsi
+    jz .Lap_managed_residency_end_invalid
+    mov r12, rdi
+    mov r13, rsi
+    cmp r12, 1
+    je .Lap_managed_residency_end_single
