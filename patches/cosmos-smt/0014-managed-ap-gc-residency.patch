+// int _native_x64_begin_managed_residency(uint64_t cpuCount,
+//                                          uint64_t timeoutTscTicks)
+// Starts command 7 on every AP and returns only after all APs are executing
+// the managed Stage-14 loop with interrupts enabled.
+.global _native_x64_begin_managed_residency
+_native_x64_begin_managed_residency:
+    push rbx
+    push r12
+    push r13
+    push r15
+    test rdi, rdi
+    jz .Lap_managed_residency_begin_invalid
+    cmp rdi, 256
+    ja .Lap_managed_residency_begin_invalid
+    test rsi, rsi
+    jz .Lap_managed_residency_begin_invalid
