+    shl edx, 24
+    mov dword ptr [r15 + 0x310], edx
+    mov dword ptr [r15 + 0x300], 0x000000F1
+    inc rbx
+    jmp .Lap_managed_residency_begin_send
+
+.Lap_managed_residency_begin_wait_start:
+    rdtsc
+    shl rdx, 32
+    or rax, rdx
+    mov r11, rax
+
+.Lap_managed_residency_begin_wait:
+    mov ebx, 1
+.Lap_managed_residency_begin_check:
+    cmp rbx, r12
+    jae .Lap_managed_residency_begin_success
+    lea r8, [rip + _ap_boot_state]
+    mov rax, rbx
+    shl rax, 6
+    add r8, rax
+    lea r9, [rip + _ap_managed_residency_state]
+    mov rax, rbx
+    shl rax, 6
+    add r9, rax
+    cmp dword ptr [r9 + 0], 3
+    je .Lap_managed_residency_begin_failure
+    cmp dword ptr [r9 + 0], 1
+    jne .Lap_managed_residency_begin_poll
+    cmp qword ptr [r9 + 8], 0
+    je .Lap_managed_residency_begin_poll
+    cmp dword ptr [r8 + 32], 0
+    jne .Lap_managed_residency_begin_poll
+    cmp dword ptr [r8 + 48], 0
+    jne .Lap_managed_residency_begin_poll
+    cmp qword ptr [r8 + 56], 10
