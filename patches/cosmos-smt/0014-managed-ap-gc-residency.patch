+    /// <summary>
+    /// Keeps every AP inside an allocation-free managed execution window while
+    /// the BSP performs one real OrionGC collection. AP interrupts are enabled,
+    /// so the existing native stop-the-world IPI must park and resume each AP
+    /// before it can leave the managed entry. This is the GC/runtime prerequisite
+    /// for later managed AP idle threads; it does not dispatch, migrate or
+    /// preempt a scheduler thread.
+    /// </summary>
+    internal static bool RunManagedApGcResidencyProof()
+    {
+        if (!s_enabled || s_currentScheduler is null ||
+            s_cpuStates is null || s_cpuCount == 0 ||
+            !GarbageCollector.IsEnabled)
+        {
+            Serial.WriteString("[SCHED] WARNING: Stage 14 runtime prerequisites are not initialized.\n");
+            return false;
+        }
+
+        for (uint cpuId = 0; cpuId < s_cpuCount; cpuId++)
+        {
+            PerCpuState state = s_cpuStates[cpuId];
+            if (state.CpuId != cpuId || state.Stage13Phase != 2 ||
+                state.Stage13EntryCount != 1)
+            {
+                Serial.WriteString("[SCHED] WARNING: Stage 14 requires completed Stage 13 state for CpuId=");
+                Serial.WriteNumber(cpuId);
+                Serial.WriteString(".\n");
+                return false;
+            }
+        }
+
+#if ARCH_X64
+        long frequency = Stopwatch.Frequency;
+        ulong timeoutTicks = frequency > 0
+            ? checked((ulong)frequency * Stage14TimeoutSeconds)
+            : 5_000_000_000UL;
+        int expectedAps = checked((int)s_cpuCount - 1);
+        ulong[] heartbeatBeforeGc = new ulong[checked((int)s_cpuCount)];
+
+        Serial.WriteString("[SCHED-AP-RUNTIME] dispatch\n");
+        int entered = expectedAps == 0
+            ? 0
+            : NativeBeginManagedResidency(s_cpuCount, timeoutTicks);
+        if (entered != expectedAps)
+        {
+            if (expectedAps != 0)
+            {
+                NativeEndManagedResidency(s_cpuCount, timeoutTicks);
+            }
+
+            Serial.WriteString("[SCHED] WARNING: Stage 14 managed AP entry result=");
+            WriteSignedNumber(entered);
+            Serial.WriteString(" expected=");
+            Serial.WriteNumber((ulong)expectedAps);
+            Serial.WriteString("\n");
+            return false;
+        }
+
+        Serial.WriteString("[SCHED-AP-RUNTIME] resident aps=");
+        Serial.WriteNumber((ulong)entered);
+        Serial.WriteString("\n");
+
+        for (uint cpuId = 1; cpuId < s_cpuCount; cpuId++)
+        {
+            heartbeatBeforeGc[cpuId] = NativeGetManagedResidencyHeartbeat(cpuId);
+        }
+
+        int collectionBefore = GarbageCollector.GetCollectionIndex();
+        int collectionAfter;
+        int released;
+        bool resumedAfterGc;
+        try
+        {
+            GarbageCollector.Collect();
+            collectionAfter = GarbageCollector.GetCollectionIndex();
+            resumedAfterGc = WaitForManagedApHeartbeatAdvance(heartbeatBeforeGc, timeoutTicks);
+        }
+        finally
+        {
+            released = expectedAps == 0
+                ? 0
+                : NativeEndManagedResidency(s_cpuCount, timeoutTicks);
+        }
+
+        if (collectionAfter != collectionBefore + 1)
+        {
+            Serial.WriteString("[SCHED] WARNING: Stage 14 OrionGC collection did not advance exactly once.\n");
+            return false;
+        }
+
+        if (!resumedAfterGc)
+        {
+            Serial.WriteString("[SCHED] WARNING: Stage 14 AP heartbeat did not advance after GC resume.\n");
+            return false;
+        }
+
+        if (released != expectedAps)
+        {
+            Serial.WriteString("[SCHED] WARNING: Stage 14 managed AP release result=");
+            WriteSignedNumber(released);
+            Serial.WriteString(" expected=");
+            Serial.WriteNumber((ulong)expectedAps);
+            Serial.WriteString("\n");
+            return false;
+        }
+
+        Serial.WriteString("[SCHED-AP-RUNTIME] gc-collection=");
+        Serial.WriteNumber((ulong)collectionAfter);
+        Serial.WriteString("\n");
+
+        if (expectedAps == 0)
+        {
+            Serial.WriteString("[SCHED-AP-RUNTIME] cpu=0 state=bsp-only\n");
+        }
+
+        for (uint cpuId = 1; cpuId < s_cpuCount; cpuId++)
+        {
+            uint nativeState = NativeGetManagedResidencyState(cpuId);
+            ulong heartbeat = NativeGetManagedResidencyHeartbeat(cpuId);
+            ulong checksum = NativeGetManagedResidencyChecksum(cpuId);
+            ulong expectedChecksum = ManagedApResidencyNative.ComputeChecksum(cpuId, heartbeat);
+            if (nativeState != 2 || heartbeat == 0 || checksum != expectedChecksum)
+            {
+                Serial.WriteString("[SCHED] WARNING: Stage 14 managed residency mismatch for CpuId=");
+                Serial.WriteNumber(cpuId);
+                Serial.WriteString(".\n");
+                return false;
+            }
+
+            Serial.WriteString("[SCHED-AP-RUNTIME] cpu=");
+            Serial.WriteNumber(cpuId);
+            Serial.WriteString(" heartbeats=");
+            Serial.WriteNumber(heartbeat);
+            Serial.WriteString(" checksum=");
+            Serial.WriteHexWithPrefix(checksum);
+            Serial.WriteString(" state=returned-native-idle\n");
+        }
+#else
+        // ARM64 remains a CPU0-only compile regression until its architecture
+        // has an MP bootstrap and stop-the-world interrupt implementation.
+        return true;
+#endif
+
+        Serial.WriteString("[SCHED-AP-RUNTIME-TEST] PASS\n");
+        return true;
+    }
+
+    private static void WriteSignedNumber(int value)
+    {
+        if (value < 0)
+        {
+            Serial.WriteString("-");
+            Serial.WriteNumber((ulong)(-(long)value));
+            return;
+        }
+
+        Serial.WriteNumber((ulong)value);
+    }
+
+#if ARCH_X64
+    private static bool WaitForManagedApHeartbeatAdvance(
+        ulong[] heartbeatBeforeGc,
+        ulong timeoutTicks)
+    {
+        if (s_cpuCount <= 1)
+        {
+            return true;
+        }
+
+        ulong start = (ulong)Stopwatch.GetTimestamp();
+        while (true)
+        {
+            bool allAdvanced = true;
+            for (uint cpuId = 1; cpuId < s_cpuCount; cpuId++)
+            {
+                if (NativeGetManagedResidencyHeartbeat(cpuId) <= heartbeatBeforeGc[cpuId])
+                {
+                    allAdvanced = false;
+                    break;
+                }
+            }
+
+            if (allAdvanced)
+            {
+                return true;
+            }
+
+            ulong now = (ulong)Stopwatch.GetTimestamp();
+            if (now - start >= timeoutTicks)
+            {
+                return false;
+            }
+        }
+    }
+#endif
+
