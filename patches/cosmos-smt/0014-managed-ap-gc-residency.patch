+#if ARCH_X64
+using System;
+using System.Runtime.InteropServices;
+using Cosmos.Kernel.Core.CPU;
+using Cosmos.Kernel.Core.Runtime;
+
+namespace Cosmos.Kernel.Core.Bridge;
+
+/// <summary>
+/// Stage-14 managed AP residency entry. Each AP remains in this bounded,
+/// allocation-free managed loop while the BSP performs a real OrionGC
+/// collection. The loop deliberately holds no managed heap references and
+/// does not enter the scheduler object graph; those contracts belong to the
+/// later managed-thread enrollment stage.
+/// </summary>
+internal static partial class ManagedApResidencyNative
+{
+    [LibraryImport("*", EntryPoint = "_native_x64_publish_managed_residency")]
+    [SuppressGCTransition]
+    private static partial int NativePublishState(
+        uint cpuId,
+        uint state,
+        ulong heartbeat,
+        ulong checksum);
+
+    [LibraryImport("*", EntryPoint = "_native_x64_managed_residency_should_release")]
+    [SuppressGCTransition]
+    private static partial int NativeShouldRelease(uint cpuId);
+
+    /// <summary>
+    /// Runs on an AP with interrupts enabled so the native GC rendezvous IPI
+    /// can stop and resume this managed execution context. All communication
+    /// uses native cache-line-local mailboxes.
+    /// </summary>
+    [UnmanagedCallersOnly(EntryPoint = "__cosmos_smp_managed_residency_entry")]
+    public static uint Entry(uint expectedCpuId)
+    {
+        StartupCodeHelpers.RhpReversePInvoke(IntPtr.Zero);
+
+        uint cpuId = CpuLocal.CurrentCpuId;
+        uint status = cpuId == 0 || cpuId != expectedCpuId ? 1u : 0u;
+        ulong heartbeat = 0;
+        ulong checksum = ComputeChecksum(cpuId, heartbeat);
+
+        if (status == 0 &&
+            NativePublishState(cpuId, 1, heartbeat, checksum) != 0)
+        {
+            status = 2;
+        }
+
+        while (status == 0)
+        {
+            int release = NativeShouldRelease(cpuId);
+            if (release < 0)
+            {
+                status = 3;
+                break;
+            }
+
+            if (release != 0)
+            {
+                break;
+            }
+
+            heartbeat++;
+            if (heartbeat == 0)
+            {
+                status = 4;
+                break;
+            }
+
+            checksum = ComputeChecksum(cpuId, heartbeat);
+            if (NativePublishState(cpuId, 1, heartbeat, checksum) != 0)
+            {
+                status = 5;
+            }
+        }
+
+        if (status == 0)
+        {
+            checksum = ComputeChecksum(cpuId, heartbeat);
+            if (NativePublishState(cpuId, 2, heartbeat, checksum) != 0)
+            {
+                status = 6;
+            }
+        }
+
+        StartupCodeHelpers.RhpReversePInvokeReturn(IntPtr.Zero);
+        return status;
+    }
+
+    /// <summary>
+    /// Deterministic per-heartbeat value used to prove that each AP continued
+    /// executing managed instructions before and after the GC rendezvous.
+    /// </summary>
+    internal static ulong ComputeChecksum(uint cpuId, ulong heartbeat)
+    {
+        ulong value = 0xA0761D6478BD642FUL ^ ((ulong)cpuId << 32) ^ heartbeat;
+        for (uint round = 0; round < 256; round++)
+        {
+            value ^= ((ulong)cpuId + round + 1) * 0xE7037ED1A0B428DBUL;
+            value = (value << 17) | (value >> 47);
+            value += heartbeat ^ ((ulong)round * 0x8EBC6AF09C88C6E3UL);
+        }
+
+        return value;
+    }
+}
+#endif
