+    jae .Lap_managed_residency_begin_wait_start
+    lea r8, [rip + _ap_boot_state]
+    mov rax, rbx
+    shl rax, 6
+    add r8, rax
+    xor eax, eax
+    xchg dword ptr [r8 + 48], eax
