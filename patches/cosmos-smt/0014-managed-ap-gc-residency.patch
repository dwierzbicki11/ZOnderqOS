+    shl rax, 6
+    add r8, rax
+    cmp dword ptr [r8 + 0], 1
+    jne .Lap_managed_residency_begin_invalid
+    cmp dword ptr [r8 + 32], 0
+    jne .Lap_managed_residency_begin_invalid
+    cmp dword ptr [r8 + 48], 1
+    jne .Lap_managed_residency_begin_invalid
+    cmp qword ptr [r8 + 56], 9
+    jne .Lap_managed_residency_begin_invalid
+
+    lea r9, [rip + _ap_managed_residency_state]
+    mov rax, rbx
+    shl rax, 6
+    add r9, rax
+    cmp dword ptr [r9 + 0], 0
+    jne .Lap_managed_residency_begin_invalid
+    mov dword ptr [r9 + 4], 0
+    mov qword ptr [r9 + 8], 0
