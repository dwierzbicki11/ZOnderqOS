+        if ((Volatile.Read(ref _stage18CompletedMask) & bit) != 0) return false;
+        if (slot == 0) Volatile.Write(ref _stage18Checksum0, checksum);
+        else Volatile.Write(ref _stage18Checksum1, checksum);
+        return TrySetBit(ref _stage18CompletedMask, bit);
+    }
+
+    private static bool TrySetBit(ref int target, int bit)
+    {
+        while (true)
+        {
+            int observed = Volatile.Read(ref target);
+            if ((observed & bit) != 0) return false;
+            if (Interlocked.CompareExchange(ref target, observed | bit, observed) == observed) return true;
+        }
+    }
