+        if ((Volatile.Read(ref _stage18EnteredMask) & bit) != 0) return false;
+        if (slot == 0) Volatile.Write(ref _stage18ThreadId0, threadId);
+        else Volatile.Write(ref _stage18ThreadId1, threadId);
+        return TrySetBit(ref _stage18EnteredMask, bit);
+    }
+
+    internal bool TryRecordStage18Preemption(uint expectedCpuId, uint threadId)
+    {
+        if (CpuId != expectedCpuId) return false;
+        if (Volatile.Read(ref _stage18ThreadId0) == threadId) { Interlocked.Increment(ref _stage18Preemptions0); return true; }
+        if (Volatile.Read(ref _stage18ThreadId1) == threadId) { Interlocked.Increment(ref _stage18Preemptions1); return true; }
+        return false;
+    }
+
+    internal bool TryCompleteStage18Worker(uint expectedCpuId, uint slot, uint threadId, ulong checksum)
+    {
+        if (CpuId != expectedCpuId || slot > 1 || checksum == 0 || GetStage18ThreadId(slot) != threadId || GetStage18PreemptionCount(slot) < 2) return false;
