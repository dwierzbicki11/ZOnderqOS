+    internal uint GetStage18PreemptionCount(uint slot) => slot == 0 ? (uint)Volatile.Read(ref _stage18Preemptions0) : (uint)Volatile.Read(ref _stage18Preemptions1);
+    internal ulong GetStage18Checksum(uint slot) => slot == 0 ? Volatile.Read(ref _stage18Checksum0) : Volatile.Read(ref _stage18Checksum1);
