+++ b/src/Cosmos.Kernel.HAL.X64/X64PlatformInitializer.cs
@@ -97,6 +97,14 @@ internal class X64PlatformInitializer : IPlatformInitializer
         Serial.WriteNumber((ulong)X64CpuOps.TscFrequency);
         Serial.WriteString(" Hz\n");
 
+        // Stage 4: release each Limine AP into a minimal native-only entry,
+        // validate its dense CpuId/GS/stack, then leave it parked with IF=0.
+        // No managed runtime, GC, scheduler or interrupt handler runs on APs.
+        if (!SmpApBootstrap.StartAndParkApplicationProcessors())
+        {
+            Cosmos.Kernel.Core.Panic.Halt("Stage 4 failed to start and safely park every application processor.");
+        }
+
         // Initialize RTC
         Serial.WriteString("[X64HAL] Initializing RTC...\n");
         _rtc = new RTC();
