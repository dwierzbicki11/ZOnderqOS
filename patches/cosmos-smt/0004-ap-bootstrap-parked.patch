diff --git a/src/Cosmos.Kernel.HAL.X64/SmpApBootstrap.cs b/src/Cosmos.Kernel.HAL.X64/SmpApBootstrap.cs
new file mode 100644
index 0000000000000000000000000000000000000000..2322d858c2e9df6152cfbc630b3e161fa61e8c82
--- /dev/null
+++ b/src/Cosmos.Kernel.HAL.X64/SmpApBootstrap.cs
@@ -0,0 +1,143 @@
+using System.Runtime.InteropServices;
+using Cosmos.Kernel.Boot.Limine;
+using Cosmos.Kernel.Core.IO;
+using Cosmos.Kernel.Core.X64.Cpu;
+
+namespace Cosmos.Kernel.HAL.X64;
+
+/// <summary>
+/// Stage-4 x64 application-processor bootstrap. APs execute only a native,
+/// allocation-free entry path, bind their dense CpuId to GS, report READY,
+/// and park with interrupts disabled. Managed runtime, GC and scheduler work
+/// remain confined to the BSP.
+/// </summary>
+internal static unsafe partial class SmpApBootstrap
+{
+    private const ulong ApReadyTimeoutSeconds = 5;
+
+    [LibraryImport("*", EntryPoint = "_native_x64_start_aps")]
+    [SuppressGCTransition]
+    private static partial int NativeStartAps(
+        LimineMpInfoX64** cpus,
+        ulong cpuCount,
+        ulong timeoutTscTicks);
+
+    [LibraryImport("*", EntryPoint = "_native_x64_get_ap_ready")]
+    [SuppressGCTransition]
+    private static partial uint NativeGetReady(uint cpuId);
+
+    [LibraryImport("*", EntryPoint = "_native_x64_get_ap_lapic_id")]
+    [SuppressGCTransition]
+    private static partial uint NativeGetLapicId(uint cpuId);
+
+    [LibraryImport("*", EntryPoint = "_native_x64_get_ap_gs_id")]
+    [SuppressGCTransition]
+    private static partial uint NativeGetGsId(uint cpuId);
+
+    [LibraryImport("*", EntryPoint = "_native_x64_get_ap_stack")]
+    [SuppressGCTransition]
+    private static partial ulong NativeGetStack(uint cpuId);
+
+    [LibraryImport("*", EntryPoint = "_native_x64_get_ap_rflags")]
+    [SuppressGCTransition]
+    private static partial ulong NativeGetRflags(uint cpuId);
+
+    internal static bool StartAndParkApplicationProcessors()
+    {
+        LimineMpResponseX64* response = LimineMp.X64Response;
+        if (response == null || response->Cpus == null ||
+            response->CpuCount == 0 ||
+            response->CpuCount > LimineMp.MaxXApicCpuCount)
+        {
+            Serial.WriteString("[SMP] WARNING: Stage 4 requires a valid legacy-xAPIC MP response.\n");
+            return false;
+        }
+
+        if ((response->Flags & LimineMp.X64ResponseFlagX2Apic) != 0)
+        {
+            Serial.WriteString("[SMP] WARNING: Stage 4 does not support x2APIC descriptors yet.\n");
+            return false;
+        }
+
+        long frequency = X64CpuOps.TscFrequency;
+        ulong timeoutTicks = frequency > 0
+            ? checked((ulong)frequency * ApReadyTimeoutSeconds)
+            : 5_000_000_000UL;
+
+        int started = NativeStartAps(response->Cpus, response->CpuCount, timeoutTicks);
+        int expected = checked((int)response->CpuCount - 1);
+        if (started != expected)
+        {
+            Serial.WriteString("[SMP] WARNING: Stage 4 AP READY timeout or invalid native bootstrap state.\n");
+            return false;
+        }
+
+        for (ulong tableIndex = 0; tableIndex < response->CpuCount; tableIndex++)
+        {
+            LimineMpInfoX64* descriptor = response->Cpus[tableIndex];
+            if (descriptor == null)
+            {
+                Serial.WriteString("[SMP] WARNING: Stage 4 encountered a null CPU descriptor.\n");
+                return false;
+            }
+
+            uint cpuId = checked((uint)descriptor->ExtraArgument);
+            if (cpuId == 0)
+            {
+                if (descriptor->LapicId != response->BspLapicId)
+                {
+                    Serial.WriteString("[SMP] WARNING: Stage 4 dense CpuId 0 is not the BSP.\n");
+                    return false;
+                }
+                continue;
+            }
+
+            uint ready = NativeGetReady(cpuId);
+            uint lapicId = NativeGetLapicId(cpuId);
+            uint gsId = NativeGetGsId(cpuId);
+            ulong stack = NativeGetStack(cpuId);
+            ulong rflags = NativeGetRflags(cpuId);
+
+            if (ready != 1 || lapicId != descriptor->LapicId ||
+                gsId != cpuId || stack == 0 || (stack & 0xFUL) != 0 ||
+                (rflags & (1UL << 9)) != 0)
+            {
+                Serial.WriteString("[SMP] WARNING: Stage 4 AP state validation failed for CpuId=");
+                Serial.WriteNumber(cpuId);
+                Serial.WriteString("\n");
+                return false;
+            }
+
+            for (ulong previousIndex = 0; previousIndex < tableIndex; previousIndex++)
+            {
+                LimineMpInfoX64* previous = response->Cpus[previousIndex];
+                if (previous == null || previous->ExtraArgument == 0)
+                {
+                    continue;
+                }
+
+                if (NativeGetStack(checked((uint)previous->ExtraArgument)) == stack)
+                {
+                    Serial.WriteString("[SMP] WARNING: Stage 4 AP stacks are not unique.\n");
+                    return false;
+                }
+            }
+
+            Serial.WriteString("[SMP] AP READY: CpuId=");
+            Serial.WriteNumber(cpuId);
+            Serial.WriteString(" LAPIC=");
+            Serial.WriteNumber(lapicId);
+            Serial.WriteString(" GS=");
+            Serial.WriteNumber(gsId);
+            Serial.WriteString(" stack=0x");
+            Serial.WriteHex(stack);
+            Serial.WriteString("\n");
+        }
+
+        Serial.WriteString("[SMP] Stage 4 complete: ");
+        Serial.WriteNumber((ulong)started);
+        Serial.WriteString(" AP(s) ready; AP scheduler/interrupts remain disabled.\n");
+        Serial.WriteString("[SMP-BOOT] PASS\n");
+        return true;
+    }
+}
