+    private static unsafe void DisplayLimineMpInfo()
+    {
+        LimineMpResponseX64* response = LimineMp.X64Response;
+        if (response == null)
+        {
+            Serial.WriteString("[SMP] WARNING: Limine MP response is unavailable; stage 1 is not active.\n");
+            return;
+        }
+
+        ulong cpuCount = response->CpuCount;
+        Serial.WriteString("[SMP] Limine MP response: ");
+        Serial.WriteNumber(cpuCount);
+        Serial.WriteString(" logical CPU(s), BSP LAPIC=");
+        Serial.WriteNumber(response->BspLapicId);
+        Serial.WriteString("\n");
+
+        if ((response->Flags & LimineMp.X64ResponseFlagX2Apic) != 0)
+        {
+            Serial.WriteString("[SMP] WARNING: Limine enabled x2APIC although stage 1 requested xAPIC mode.\n");
+        }
+
+        if (cpuCount == 0)
+        {
+            Serial.WriteString("[SMP] WARNING: Limine MP returned zero CPUs.\n");
+            return;
+        }
+
+        if (response->Cpus == null)
+        {
+            Serial.WriteString("[SMP] WARNING: Limine MP CPU pointer table is null.\n");
+            return;
+        }
+
+        ulong inspectCount = cpuCount;
+        if (inspectCount > LimineMp.MaxXApicCpuCount)
+        {
+            Serial.WriteString("[SMP] WARNING: CPU count exceeds the xAPIC address space; inspecting first 256 entries only.\n");
+            inspectCount = LimineMp.MaxXApicCpuCount;
+        }
+
+        bool bspSeen = false;
+        bool duplicateLapicSeen = false;
+
+        for (ulong i = 0; i < inspectCount; i++)
+        {
+            LimineMpInfoX64* cpu = response->Cpus[i];
+            if (cpu == null)
+            {
+                Serial.WriteString("[SMP] WARNING: null CPU descriptor at index ");
+                Serial.WriteNumber(i);
+                Serial.WriteString("\n");
+                continue;
+            }
+
+            bool isBsp = cpu->LapicId == response->BspLapicId;
+            bspSeen |= isBsp;
+
+            for (ulong j = 0; j < i; j++)
+            {
+                LimineMpInfoX64* previous = response->Cpus[j];
+                if (previous != null && previous->LapicId == cpu->LapicId)
+                {
+                    duplicateLapicSeen = true;
+                    break;
+                }
+            }
+
+            Serial.WriteString("[SMP] CPU[");
+            Serial.WriteNumber(i);
+            Serial.WriteString("] processor=");
+            Serial.WriteNumber(cpu->ProcessorId);
+            Serial.WriteString(" LAPIC=");
+            Serial.WriteNumber(cpu->LapicId);
+            if (isBsp)
+            {
+                Serial.WriteString(" BSP");
+            }
+            Serial.WriteString("\n");
+        }
+
+        if (!bspSeen)
+        {
+            Serial.WriteString("[SMP] WARNING: BSP LAPIC ID is missing from the Limine CPU table.\n");
+        }
+        if (duplicateLapicSeen)
+        {
+            Serial.WriteString("[SMP] WARNING: duplicate LAPIC IDs detected in the Limine CPU table.\n");
+        }
+
+        var madtInfo = AcpiMadt.GetMadtInfoPtr();
+        uint madtCpuCount = madtInfo != null ? madtInfo->CpuCount : 1;
+        if ((ulong)madtCpuCount != cpuCount)
+        {
+            Serial.WriteString("[SMP] WARNING: Limine/MADT CPU-count mismatch: Limine=");
+            Serial.WriteNumber(cpuCount);
+            Serial.WriteString(" MADT=");
+            Serial.WriteNumber(madtCpuCount);
+            Serial.WriteString("\n");
+        }
+
+        Serial.WriteString("[SMP] Stage 1 OK: topology discovered; APs remain parked.\n");
+    }
