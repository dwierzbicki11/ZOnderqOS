+    internal static bool RunManagedApplicationProcessorProof()
+    {
+        const ulong ExpectedIpiCount = 8;
+        LimineMpResponseX64* response = LimineMp.X64Response;
+        if (response == null || response->Cpus == null || response->CpuCount == 0 ||
+            response->CpuCount > LimineMp.MaxXApicCpuCount)
+        {
+            Serial.WriteString("[SMP] WARNING: managed AP proof has no valid CPU topology.\n");
+            return false;
+        }
+
+        // Keep the 1-vCPU CI topology as a real regression test while making
+        // the AP-specific proof explicit: there is no AP to enter on it.
+        if (response->CpuCount == 1)
+        {
+            Serial.WriteString("[MANAGED-AP] no application processors; single-CPU regression\n");
+            Serial.WriteString("[MANAGED-AP-TEST] PASS\n");
+            return true;
+        }
+
+        long frequency = X64CpuOps.TscFrequency;
+        ulong timeoutTicks = frequency > 0
+            ? checked((ulong)frequency * ApReadyTimeoutSeconds)
+            : 5_000_000_000UL;
+        int expected = checked((int)response->CpuCount - 1);
+        int completed = NativeRunManagedApTest(response->CpuCount, timeoutTicks);
+        if (completed != expected)
+        {
+            Serial.WriteString("[SMP] WARNING: managed AP proof result=");
+            WriteSignedNumber(completed);
+            Serial.WriteString(" expected=");
+            Serial.WriteNumber((ulong)expected);
+            Serial.WriteString("\n");
+            DumpManagedApState(response->CpuCount);
+            return false;
+        }
+
+        for (uint cpuId = 1; cpuId < response->CpuCount; cpuId++)
+        {
+            uint state = NativeGetManagedState(cpuId);
+            ulong checksum = NativeGetManagedResult(cpuId);
+            uint command = NativeGetCommand(cpuId);
+            uint completion = NativeGetCompletion(cpuId);
+            ulong ipiCount = NativeGetIpiCount(cpuId);
+            ulong expectedChecksum = ComputeManagedApChecksum(cpuId);
+            if (state != 1 || checksum != expectedChecksum || command != 0 ||
+                completion != 1 || ipiCount != ExpectedIpiCount)
+            {
+                Serial.WriteString("[SMP] WARNING: managed AP state mismatch for CpuId=");
+                Serial.WriteNumber(cpuId);
+                Serial.WriteString("\n");
+                DumpManagedApState(response->CpuCount);
+                return false;
+            }
+
+            Serial.WriteString("[MANAGED-AP] cpu=");
+            Serial.WriteNumber(cpuId);
+            Serial.WriteString(" checksum=0x");
+            Serial.WriteHex(checksum);
+            Serial.WriteString(" state=returned-native-idle\n");
+        }
+
+        Serial.WriteString("[MANAGED-AP-TEST] PASS\n");
+        return true;
+    }
+
+    private static void DumpManagedApState(ulong cpuCount)
+    {
+        for (uint cpuId = 1; cpuId < cpuCount; cpuId++)
+        {
+            Serial.WriteString("[MANAGED-AP-DIAG] cpu=");
+            Serial.WriteNumber(cpuId);
+            Serial.WriteString(" state=");
+            Serial.WriteNumber(NativeGetManagedState(cpuId));
+            Serial.WriteString(" result=0x");
+            Serial.WriteHex(NativeGetManagedResult(cpuId));
+            Serial.WriteString(" command=");
+            Serial.WriteNumber(NativeGetCommand(cpuId));
+            Serial.WriteString(" completion=");
+            Serial.WriteNumber(NativeGetCompletion(cpuId));
+            Serial.WriteString(" ipi=");
+            Serial.WriteNumber(NativeGetIpiCount(cpuId));
+            Serial.WriteString("\n");
+        }
+    }
