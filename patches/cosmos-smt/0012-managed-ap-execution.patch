+// int _native_x64_run_managed_ap_test(uint64_t cpuCount,
+//                                     uint64_t timeoutTscTicks)
+// Wakes each parked AP with vector 0xF1, asks it to execute the single managed
+// export behind command 5, and waits for its native completion mailbox. No
+// scheduler, managed Thread or AP-side allocation is involved.
+.global _native_x64_run_managed_ap_test
+_native_x64_run_managed_ap_test:
+    push rbx
+    push r12
+    push r13
+    push r14
+    push r15
+    test rdi, rdi
+    jz .Lap_managed_test_invalid
+    cmp rdi, 256
+    ja .Lap_managed_test_invalid
+    test rsi, rsi
+    jz .Lap_managed_test_invalid
+    mov r12, rdi
+    mov r13, rsi
+    call .Lap_read_lapic_base
+    test rax, rax
+    jz .Lap_managed_test_invalid
+    mov qword ptr [rip + _native_x64_lapic_base], rax
+    mov r15, rax
+    xor r14d, r14d
+    mov ebx, 1
+
+.Lap_managed_test_cpu_loop:
+    cmp rbx, r12
+    jae .Lap_managed_test_success
+    lea r8, [rip + _ap_boot_state]
+    mov rax, rbx
+    shl rax, 6
+    add r8, rax
+    cmp dword ptr [r8 + 0], 1
+    jne .Lap_managed_test_invalid
+    cmp dword ptr [r8 + 32], 0
+    jne .Lap_managed_test_invalid
+    cmp dword ptr [r8 + 48], 1
+    jne .Lap_managed_test_invalid
+    cmp qword ptr [r8 + 56], 7
+    jne .Lap_managed_test_invalid
+
+    lea r9, [rip + _ap_managed_state]
+    mov rax, rbx
+    shl rax, 2
+    add r9, rax
+    cmp dword ptr [r9], 0
+    jne .Lap_managed_test_invalid
+    mov dword ptr [r9], 0
+    lea r10, [rip + _ap_managed_result]
+    mov rax, rbx
+    shl rax, 3
+    add r10, rax
+    mov qword ptr [r10], 0
+    mfence
+
+    xor eax, eax
+    xchg dword ptr [r8 + 48], eax
+    cmp eax, 1
+    jne .Lap_managed_test_invalid
+    mov eax, 5
+    xchg dword ptr [r8 + 32], eax
+    test eax, eax
+    jne .Lap_managed_test_invalid
+
+    mov edx, dword ptr [r8 + 8]
+    shl edx, 24
+    mov dword ptr [r15 + 0x310], edx
+    mov dword ptr [r15 + 0x300], 0x000000F1
+    rdtsc
+    shl rdx, 32
+    or rax, rdx
+    mov r11, rax
+
+.Lap_managed_test_wait:
+    cmp dword ptr [r9], 2
+    je .Lap_managed_test_failure
+    cmp dword ptr [r9], 1
+    jne .Lap_managed_test_poll
+    cmp dword ptr [r8 + 48], 1
+    jne .Lap_managed_test_poll
+    cmp dword ptr [r8 + 32], 0
+    jne .Lap_managed_test_poll
+    cmp qword ptr [r8 + 56], 8
+    jne .Lap_managed_test_poll
+    inc r14
+    inc rbx
+    jmp .Lap_managed_test_cpu_loop
+
+.Lap_managed_test_poll:
+    pause
+    rdtsc
+    shl rdx, 32
+    or rax, rdx
+    sub rax, r11
+    cmp rax, r13
+    jb .Lap_managed_test_wait
+    jmp .Lap_managed_test_failure
+
+.Lap_managed_test_success:
+    mov eax, r14d
+    jmp .Lap_managed_test_return
+.Lap_managed_test_failure:
+    mov eax, -3
+    jmp .Lap_managed_test_return
+.Lap_managed_test_invalid:
+    mov eax, -2
+.Lap_managed_test_return:
+    pop r15
+    pop r14
+    pop r13
+    pop r12
+    pop rbx
+    ret
+
