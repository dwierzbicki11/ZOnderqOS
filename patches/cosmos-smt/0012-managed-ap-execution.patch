+#if ARCH_X64
+using System;
+using System.Runtime.InteropServices;
+using Cosmos.Kernel.Core.CPU;
+using Cosmos.Kernel.Core.Runtime;
+
+namespace Cosmos.Kernel.Core.Bridge;
+
+/// <summary>
+/// The Stage-12 reverse-P/Invoke entry used by the native AP proof. It is kept
+/// in the Core assembly because Cosmos emits its native managed exports from
+/// Core; HAL only owns the native command and result validation.
+/// </summary>
+internal static partial class ManagedApNative
+{
+    [LibraryImport("*", EntryPoint = "_native_x64_publish_managed_ap_result")]
+    [SuppressGCTransition]
+    private static partial int NativePublishResult(uint cpuId, ulong checksum);
+
+    /// <summary>
+    /// Executes a bounded managed operation on an AP and publishes its result.
+    /// No allocation, lock, scheduler operation or serial I/O is performed.
+    /// </summary>
+    [UnmanagedCallersOnly(EntryPoint = "__cosmos_smp_managed_ap_entry")]
+    public static uint Entry(uint expectedCpuId)
+    {
+        StartupCodeHelpers.RhpReversePInvoke(IntPtr.Zero);
+
+        uint cpuId = CpuLocal.CurrentCpuId;
+        uint status = 0;
+        if (cpuId == 0 || cpuId != expectedCpuId)
+        {
+            status = 1;
+        }
+        else
+        {
+            ulong checksum = ComputeChecksum(cpuId);
+            if (NativePublishResult(cpuId, checksum) != 0)
+            {
+                status = 2;
+            }
+        }
+
+        StartupCodeHelpers.RhpReversePInvokeReturn(IntPtr.Zero);
+        return status;
+    }
+
+    private static ulong ComputeChecksum(uint cpuId)
+    {
+        ulong checksum = 0xD6E8FEB86659FD93UL ^ cpuId;
+        for (uint round = 0; round < 1024; round++)
+        {
+            checksum ^= (ulong)(cpuId + round) * 0x9E3779B97F4A7C15UL;
+            checksum = (checksum << 13) | (checksum >> 51);
+        }
+
+        return checksum;
+    }
+}
+#endif
