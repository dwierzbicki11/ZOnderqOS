+// This code is licensed under the BSD 3-Clause license (see LICENSE for details)
+
+using System.Runtime.InteropServices;
+
+namespace Cosmos.Kernel.Core.CPU;
+
+/// <summary>
+/// Architecture-local CPU identity storage used by scheduler and interrupt hot paths.
+/// x64 binds GS base to a cache-line-sized slot before interrupts are enabled.
+/// </summary>
+internal static partial class CpuLocal
+{
+#if ARCH_X64
+    [LibraryImport("*", EntryPoint = "_native_x64_init_percpu")]
+    [SuppressGCTransition]
+    private static partial void NativeInitialize(uint cpuId);
+
+    [LibraryImport("*", EntryPoint = "_native_x64_get_current_cpu_id")]
+    [SuppressGCTransition]
+    private static partial uint NativeGetCurrentCpuId();
+
+    internal static bool Initialize(uint cpuId)
+    {
+        NativeInitialize(cpuId);
+        return NativeGetCurrentCpuId() == cpuId;
+    }
+
+    internal static uint CurrentCpuId => NativeGetCurrentCpuId();
+#else
+    internal static bool Initialize(uint cpuId)
+    {
+        _ = cpuId;
+        return false;
+    }
+
+    internal static uint CurrentCpuId => 0;
+#endif
+}
