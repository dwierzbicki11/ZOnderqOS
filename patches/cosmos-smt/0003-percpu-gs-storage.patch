+// void _native_x64_init_percpu(uint cpuId)
+// Binds GS base to this logical CPU's cache-line-sized native scratch slot.
+// Must run before interrupts are enabled on every CPU.
+.global _native_x64_init_percpu
+_native_x64_init_percpu:
+    cmp edi, 255
+    ja .Lpercpu_invalid
+
+    lea r8, [rip + _percpu_slots]
+    mov eax, edi
+    shl rax, 6
+    add r8, rax
+
+    mov qword ptr [r8 + 0], rdi
+    mov qword ptr [r8 + 8], 0
+    mov qword ptr [r8 + 16], 0
+    mov qword ptr [r8 + 24], 0
+    mov qword ptr [r8 + 32], 0
+
+    // IA32_GS_BASE = 0xC0000101, value in EDX:EAX.
+    mov rax, r8
+    mov rdx, rax
+    shr rdx, 32
+    mov ecx, 0xC0000101
+    wrmsr
+    ret
+
+.Lpercpu_invalid:
+    ud2
+
+// uint32_t _native_x64_get_current_cpu_id()
+// Returns the dense scheduler CpuId stored at GS:0.
+.global _native_x64_get_current_cpu_id
+_native_x64_get_current_cpu_id:
+    mov eax, dword ptr gs:[0]
+    ret
