+// int _native_x64_end_idle_stack_test(uint64_t cpuCount,
+//                                      uint64_t timeoutTscTicks)
+// Releases every AP stack-canary loop with a fixed IPI and waits for native
+// HLT re-entry plus exact canary restoration.
+.global _native_x64_end_idle_stack_test
+_native_x64_end_idle_stack_test:
+    push rbx
+    push r12
+    push r13
+    push r15
+    test rdi, rdi
+    jz .Lap_idle_stack_end_invalid
+    cmp rdi, 256
+    ja .Lap_idle_stack_end_invalid
+    test rsi, rsi
+    jz .Lap_idle_stack_end_invalid
+    mov r12, rdi
+    mov r13, rsi
+    cmp r12, 1
+    je .Lap_idle_stack_end_single
+    call .Lap_read_lapic_base
+    test rax, rax
+    jz .Lap_idle_stack_end_invalid
+    mov qword ptr [rip + _native_x64_lapic_base], rax
+    mov r15, rax
