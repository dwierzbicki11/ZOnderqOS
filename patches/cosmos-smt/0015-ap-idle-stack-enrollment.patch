+    mfence
+    mov edx, dword ptr [r8 + 8]
+    shl edx, 24
+    mov dword ptr [r15 + 0x310], edx
+    mov dword ptr [r15 + 0x300], 0x000000F1
+    inc rbx
+    jmp .Lap_idle_stack_end_release
+
+.Lap_idle_stack_end_wait_start:
+    rdtsc
+    shl rdx, 32
+    or rax, rdx
+    mov r11, rax
+
+.Lap_idle_stack_end_wait:
+    mov ebx, 1
+.Lap_idle_stack_end_check:
+    cmp rbx, r12
+    jae .Lap_idle_stack_end_success
+    lea r8, [rip + _ap_boot_state]
+    mov rax, rbx
+    shl rax, 6
+    add r8, rax
+    lea r9, [rip + _ap_idle_stack_state]
+    mov rax, rbx
+    shl rax, 6
+    add r9, rax
+    cmp dword ptr [r9 + 0], 3
+    je .Lap_idle_stack_end_failure
+    cmp dword ptr [r9 + 0], 2
+    jne .Lap_idle_stack_end_poll
+    mov rax, qword ptr [r9 + 8]
+    test rax, rax
+    jz .Lap_idle_stack_end_failure
+    cmp qword ptr [r9 + 16], rax
+    jne .Lap_idle_stack_end_failure
+    cmp dword ptr [r8 + 32], 0
+    jne .Lap_idle_stack_end_poll
+    cmp dword ptr [r8 + 48], 1
+    jne .Lap_idle_stack_end_poll
+    cmp qword ptr [r8 + 56], 12
+    jne .Lap_idle_stack_end_poll
+    inc rbx
+    jmp .Lap_idle_stack_end_check
+
+.Lap_idle_stack_end_poll:
+    pause
+    rdtsc
+    shl rdx, 32
+    or rax, rdx
+    sub rax, r11
+    cmp rax, r13
+    jb .Lap_idle_stack_end_wait
+    mov eax, -1
+    jmp .Lap_idle_stack_end_return
+
+.Lap_idle_stack_end_success:
+    mov eax, r12d
+    dec eax
+    jmp .Lap_idle_stack_end_return
+.Lap_idle_stack_end_single:
+    xor eax, eax
+    jmp .Lap_idle_stack_end_return
+.Lap_idle_stack_end_failure:
+    mov eax, -3
+    jmp .Lap_idle_stack_end_return
+.Lap_idle_stack_end_invalid:
+    mov eax, -2
+.Lap_idle_stack_end_return:
+    pop r15
+    pop r13
+    pop r12
+    pop rbx
+    ret
