+    mov ebx, 1
+.Lap_idle_stack_end_release:
+    cmp rbx, r12
+    jae .Lap_idle_stack_end_wait_start
+    lea r8, [rip + _ap_boot_state]
+    mov rax, rbx
+    shl rax, 6
+    add r8, rax
+    lea r9, [rip + _ap_idle_stack_state]
+    mov rax, rbx
+    shl rax, 6
+    add r9, rax
+    cmp dword ptr [r9 + 0], 1
