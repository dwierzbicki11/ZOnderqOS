+// int _native_x64_run_ap_timer_test(uint64_t cpuCount,
+//                                    uint32_t initialCount,
+//                                    uint64_t minimumTicks,
+//                                    uint64_t timeoutTscTicks)
+// Starts a periodic LAPIC timer on each AP through the parked-command path,
+// observes several private native timer interrupts, then stops the timer.
+.global _native_x64_run_ap_timer_test
+_native_x64_run_ap_timer_test:
+    push rbx
+    push r12
+    push r13
+    push r14
+    push r15
+    test rdi, rdi
+    jz .Lap_timer_test_invalid
+    cmp rdi, 256
+    ja .Lap_timer_test_invalid
+    test esi, esi
+    jz .Lap_timer_test_invalid
+    test rdx, rdx
+    jz .Lap_timer_test_invalid
+    test rcx, rcx
+    jz .Lap_timer_test_invalid
+    mov r12, rdi
+    mov r13d, esi
+    mov r14, rdx
+    mov r15, rcx
+    call .Lap_read_lapic_base
+    test rax, rax
+    jz .Lap_timer_test_invalid
+    mov qword ptr [rip + _native_x64_lapic_base], rax
+    mov dword ptr [rip + _ap_timer_initial_count], r13d
+    xor r10d, r10d
+    mov ebx, 1
+
+.Lap_timer_test_cpu_loop:
+    cmp rbx, r12
+    jae .Lap_timer_test_success
+    lea r8, [rip + _ap_boot_state]
+    mov rax, rbx
+    shl rax, 6
+    add r8, rax
+    cmp dword ptr [r8 + 0], 1
+    jne .Lap_timer_test_invalid
+    cmp dword ptr [r8 + 32], 0
+    jne .Lap_timer_test_invalid
+    cmp dword ptr [r8 + 48], 1
+    jne .Lap_timer_test_invalid
+    cmp qword ptr [r8 + 40], 100001
+    jne .Lap_timer_test_invalid
+    cmp qword ptr [r8 + 56], 5
+    jne .Lap_timer_test_invalid
+
+    lea rdx, [rip + _ap_timer_ticks]
+    mov rax, rbx
+    shl rax, 3
+    mov qword ptr [rdx + rax], 0
+    xor eax, eax
+    xchg dword ptr [r8 + 48], eax
+    mov eax, 3
+    xchg dword ptr [r8 + 32], eax
+    test eax, eax
+    jne .Lap_timer_test_invalid
+
+    mov edx, dword ptr [r8 + 8]
+    shl edx, 24
+    mov rax, qword ptr [rip + _native_x64_lapic_base]
+    mov dword ptr [rax + 0x310], edx
+    mov dword ptr [rax + 0x300], 0x000000F1
+    rdtsc
+    shl rdx, 32
+    or rax, rdx
+    mov r9, rax
+
+.Lap_timer_wait_start:
+    cmp dword ptr [r8 + 48], 1
+    jne .Lap_timer_wait_start_poll
+    cmp qword ptr [r8 + 56], 6
+    jne .Lap_timer_wait_start_poll
+    jmp .Lap_timer_wait_ticks
+
+.Lap_timer_wait_start_poll:
+    pause
+    rdtsc
+    shl rdx, 32
+    or rax, rdx
+    sub rax, r9
+    cmp rax, r15
+    jb .Lap_timer_wait_start
+    mov eax, -1
+    jmp .Lap_timer_test_return
+
+.Lap_timer_wait_ticks:
+    lea rdx, [rip + _ap_timer_ticks]
+    mov rax, rbx
+    shl rax, 3
+    cmp qword ptr [rdx + rax], r14
+    jae .Lap_timer_stop_prepare
+    pause
+    rdtsc
+    shl rdx, 32
+    or rax, rdx
+    sub rax, r9
+    cmp rax, r15
+    jb .Lap_timer_wait_ticks
+    mov eax, -1
+    jmp .Lap_timer_test_return
+
+.Lap_timer_stop_prepare:
+    xor eax, eax
+    xchg dword ptr [r8 + 48], eax
+    mov eax, 4
+    xchg dword ptr [r8 + 32], eax
+    test eax, eax
+    jne .Lap_timer_test_invalid
+
+    mov edx, dword ptr [r8 + 8]
+    shl edx, 24
+    mov rax, qword ptr [rip + _native_x64_lapic_base]
+    mov dword ptr [rax + 0x310], edx
+    mov dword ptr [rax + 0x300], 0x000000F1
+    rdtsc
+    shl rdx, 32
+    or rax, rdx
+    mov r9, rax
+
+.Lap_timer_wait_stop:
+    cmp dword ptr [r8 + 48], 1
+    jne .Lap_timer_wait_stop_poll
+    cmp qword ptr [r8 + 56], 7
+    jne .Lap_timer_wait_stop_poll
+    cmp dword ptr [r8 + 32], 0
+    jne .Lap_timer_wait_stop_poll
+    inc r10
+    inc rbx
+    jmp .Lap_timer_test_cpu_loop
+
+.Lap_timer_wait_stop_poll:
+    pause
+    rdtsc
+    shl rdx, 32
+    or rax, rdx
+    sub rax, r9
+    cmp rax, r15
+    jb .Lap_timer_wait_stop
+    mov eax, -1
+    jmp .Lap_timer_test_return
+
+.Lap_timer_test_success:
+    mov eax, r10d
+    jmp .Lap_timer_test_return
+.Lap_timer_test_invalid:
+    mov eax, -2
+.Lap_timer_test_return:
+    pop r15
+    pop r14
+    pop r13
+    pop r12
+    pop rbx
+    ret
+
