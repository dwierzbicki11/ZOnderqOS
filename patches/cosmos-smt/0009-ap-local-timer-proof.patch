+    internal static bool RunApplicationProcessorTimerProof()
+    {
+        const uint TimerIntervalMs = 10;
+        const ulong MinimumTicks = 3;
+        const ulong ExpectedIpiCount = 7;
+
+        LimineMpResponseX64* response = LimineMp.X64Response;
+        if (response == null || response->Cpus == null || response->CpuCount == 0 ||
+            response->CpuCount > LimineMp.MaxXApicCpuCount)
+        {
+            Serial.WriteString("[SMP] WARNING: AP-local timer proof has no valid CPU topology.\n");
+            return false;
+        }
+
+        uint ticksPerMs = LocalApic.TicksPerMs;
+        if (ticksPerMs == 0 || ticksPerMs > uint.MaxValue / TimerIntervalMs)
+        {
+            Serial.WriteString("[SMP] WARNING: AP-local timer proof has an invalid LAPIC calibration.\n");
+            return false;
+        }
+
+        uint initialCount = ticksPerMs * TimerIntervalMs;
+        long frequency = X64CpuOps.TscFrequency;
+        ulong timeoutTicks = frequency > 0
+            ? checked((ulong)frequency * ApReadyTimeoutSeconds)
+            : 5_000_000_000UL;
+
+        int expected = checked((int)response->CpuCount - 1);
+        int completed = NativeRunApTimerTest(response->CpuCount, initialCount, MinimumTicks, timeoutTicks);
+        if (completed != expected)
+        {
+            Serial.WriteString("[SMP] WARNING: AP-local timer proof result=");
+            WriteSignedNumber(completed);
+            Serial.WriteString(" expected=");
+            Serial.WriteNumber((ulong)expected);
+            Serial.WriteString("\n");
+            DumpParkedCommandState(response->CpuCount);
+            return false;
+        }
+
+        for (uint cpuId = 1; cpuId < response->CpuCount; cpuId++)
+        {
+            ulong timerTicks = NativeGetTimerTicks(cpuId);
+            ulong ipiCount = NativeGetIpiCount(cpuId);
+            if (timerTicks < MinimumTicks || ipiCount != ExpectedIpiCount)
+            {
+                Serial.WriteString("[SMP] WARNING: AP-local timer state mismatch for CpuId=");
+                Serial.WriteNumber(cpuId);
+                Serial.WriteString("\n");
+                DumpParkedCommandState(response->CpuCount);
+                return false;
+            }
+
+            Serial.WriteString("[SMP-TIMER] cpu=");
+            Serial.WriteNumber(cpuId);
+            Serial.WriteString(" ticks=");
+            Serial.WriteNumber(timerTicks);
+            Serial.WriteString(" ipi=");
+            Serial.WriteNumber(ipiCount);
+            Serial.WriteString("\n");
+        }
+
+        Serial.WriteString("[SMP-TIMER-TEST] PASS\n");
+        return true;
+    }
+
