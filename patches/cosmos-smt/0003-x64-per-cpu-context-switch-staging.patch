-    mov [rip + _context_switch_target_rsp], rdi
+    // Stage switches independently for every xAPIC logical processor.
+    // CPUID.1:EBX[31:24] is the initial xAPIC ID. ZOnderqOS deliberately
+    // keeps the Limine MP request in xAPIC mode during first SMP bring-up.
+    push rbx
