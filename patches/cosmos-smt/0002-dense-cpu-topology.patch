+    private static unsafe void BuildDenseCpuMap()
+    {
+        LimineMpResponseX64* response = LimineMp.X64Response;
+        if (response == null || response->Cpus == null || response->CpuCount == 0 ||
+            response->CpuCount > LimineMp.MaxXApicCpuCount)
+        {
+            Serial.WriteString("[SMP] WARNING: cannot build dense CPU map from invalid MP response.\n");
+            return;
+        }
+
+        Serial.WriteString("[SMP] Dense CPU map: ");
+        Serial.WriteNumber(response->CpuCount);
+        Serial.WriteString(" logical CPU(s)\n");
+
+        // CpuId 0 is always the BSP. This keeps the existing single-CPU
+        // scheduler/runtime state attached to CPU0 while SMP grows.
+        ulong denseId = 0;
+        LimineMpInfoX64* bsp = null;
+        for (ulong i = 0; i < response->CpuCount; i++)
+        {
+            LimineMpInfoX64* cpu = response->Cpus[i];
+            if (cpu != null && cpu->LapicId == response->BspLapicId)
+            {
+                bsp = cpu;
+                break;
+            }
+        }
+
+        if (bsp == null)
+        {
+            Serial.WriteString("[SMP] WARNING: BSP missing while building dense CPU map.\n");
+            return;
+        }
+
+        AssignDenseCpu(denseId++, bsp, true);
+
+        // APs get contiguous scheduler IDs in Limine descriptor order. LAPIC
+        // IDs remain hardware metadata and are never scheduler array indexes.
+        for (ulong i = 0; i < response->CpuCount; i++)
+        {
+            LimineMpInfoX64* cpu = response->Cpus[i];
+            if (cpu == null || cpu == bsp)
+                continue;
+            AssignDenseCpu(denseId++, cpu, false);
+        }
+
+        if (denseId != response->CpuCount)
+        {
+            Serial.WriteString("[SMP] WARNING: dense CPU map size differs from MP CPU count.\n");
+            return;
+        }
+
+        if (!ValidateDenseCpuMap(response))
+        {
+            Serial.WriteString("[SMP] WARNING: dense CPU map validation failed.\n");
+            return;
+        }
+
+        Serial.WriteString("[SMP] Dense CPU map verified: BSP=0, CpuIds are unique and contiguous.\n");
+        Serial.WriteString("[SMP] Stage 2 complete: dense CPU map ready; APs remain parked.\n");
+    }
+
+    private static unsafe void AssignDenseCpu(ulong cpuId, LimineMpInfoX64* cpu, bool bsp)
+    {
+        // Limine reserves ExtraArgument for the kernel. Stage 3 will receive
+        // this descriptor directly at AP entry, avoiding CPUID in hot paths.
+        cpu->ExtraArgument = cpuId;
+
+        Serial.WriteString("[SMP] CpuId[");
+        Serial.WriteNumber(cpuId);
+        Serial.WriteString("] LAPIC=");
+        Serial.WriteNumber(cpu->LapicId);
+        Serial.WriteString(" processor=");
+        Serial.WriteNumber(cpu->ProcessorId);
+        if (bsp)
+            Serial.WriteString(" BSP");
+        Serial.WriteString("\n");
+    }
+
+    private static unsafe bool ValidateDenseCpuMap(LimineMpResponseX64* response)
+    {
+        for (ulong i = 0; i < response->CpuCount; i++)
+        {
+            LimineMpInfoX64* cpu = response->Cpus[i];
+            if (cpu == null || cpu->ExtraArgument >= response->CpuCount)
+                return false;
+
+            if (cpu->LapicId == response->BspLapicId && cpu->ExtraArgument != 0)
+                return false;
+
+            for (ulong j = 0; j < i; j++)
+            {
+                LimineMpInfoX64* previous = response->Cpus[j];
+                if (previous != null && previous->ExtraArgument == cpu->ExtraArgument)
+                    return false;
+            }
+        }
+
+        return true;
+    }
