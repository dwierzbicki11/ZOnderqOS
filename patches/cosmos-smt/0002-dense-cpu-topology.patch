+namespace Cosmos.Kernel.Core.CPU;
+
+/// <summary>
+/// Architecture-neutral logical CPU topology discovered by the platform layer.
+/// Scheduler CPU IDs are always dense (0..CpuCount-1) and never equal to a
+/// hardware APIC/MPIDR identifier by assumption.
+/// </summary>
+public static class CpuTopology
+{
+    private static ulong[]? s_hardwareIds;
+
+    /// <summary>True after the platform has published a validated topology.</summary>
+    public static bool IsInitialized => s_hardwareIds is not null;
+
+    /// <summary>Number of logical CPUs in the discovered topology.</summary>
+    public static uint CpuCount => (uint)(s_hardwareIds?.Length ?? 0);
+
+    /// <summary>
+    /// Initializes the dense map. The boot CPU is always assigned logical
+    /// CpuId 0; remaining CPUs retain firmware enumeration order.
+    /// </summary>
+    public static bool TryInitialize(ulong bootHardwareId, ulong[] hardwareIds)
+    {
+        if (hardwareIds is null || hardwareIds.Length == 0 || s_hardwareIds is not null)
+        {
+            return false;
+        }
+
+        int bootIndex = -1;
+        for (int i = 0; i < hardwareIds.Length; i++)
+        {
+            ulong hardwareId = hardwareIds[i];
+            if (hardwareId == bootHardwareId)
+            {
+                bootIndex = i;
+            }
+
+            for (int j = 0; j < i; j++)
+            {
+                if (hardwareIds[j] == hardwareId)
+                {
+                    return false;
+                }
+            }
+        }
+
+        if (bootIndex < 0)
+        {
+            return false;
+        }
+
+        var denseHardwareIds = new ulong[hardwareIds.Length];
+        denseHardwareIds[0] = bootHardwareId;
+
+        int next = 1;
+        for (int i = 0; i < hardwareIds.Length; i++)
+        {
+            if (i == bootIndex)
+            {
+                continue;
+            }
+
+            denseHardwareIds[next++] = hardwareIds[i];
+        }
+
+        // Publish only after validation and construction are complete.
+        s_hardwareIds = denseHardwareIds;
+        return true;
+    }
+
+    /// <summary>Returns the hardware identifier assigned to a dense CpuId.</summary>
+    public static bool TryGetHardwareId(uint cpuId, out ulong hardwareId)
+    {
+        ulong[]? hardwareIds = s_hardwareIds;
+        if (hardwareIds is null || cpuId >= (uint)hardwareIds.Length)
+        {
+            hardwareId = 0;
+            return false;
+        }
+
+        hardwareId = hardwareIds[cpuId];
+        return true;
+    }
+
+    /// <summary>Maps an architecture hardware identifier to a dense CpuId.</summary>
+    public static bool TryGetCpuId(ulong hardwareId, out uint cpuId)
+    {
+        ulong[]? hardwareIds = s_hardwareIds;
+        if (hardwareIds is not null)
+        {
+            for (int i = 0; i < hardwareIds.Length; i++)
+            {
+                if (hardwareIds[i] == hardwareId)
+                {
+                    cpuId = (uint)i;
+                    return true;
+                }
+            }
+        }
+
+        cpuId = 0;
+        return false;
+    }
+}
