--- /dev/null
+++ b/src/Cosmos.Kernel.HAL.X64/SmpCpuTopology.cs
@@ -0,0 +1,170 @@
+using Cosmos.Kernel.Boot.Limine;
+using Cosmos.Kernel.Core;
+using Cosmos.Kernel.Core.IO;
+
+namespace Cosmos.Kernel.HAL.X64;
+
+/// <summary>
+/// Stage-2 SMP topology builder.
+///
+/// Limine exposes hardware LAPIC IDs, but those IDs are not guaranteed to be
+/// dense or suitable as scheduler-array indexes. This stage assigns every
+/// Limine CPU descriptor a stable dense CpuId through ExtraArgument while all
+/// APs are still parked.
+/// </summary>
+internal static unsafe class SmpCpuTopology
+{
+    public static void BuildDenseCpuMap()
+    {
+        LimineMpResponseX64* response = LimineMp.X64Response;
+        if (!TryValidateResponse(response, out LimineMpInfoX64* bsp))
+        {
+            return;
+        }
+
+        ulong cpuCount = response->CpuCount;
+        Serial.WriteString("[SMP] Dense CPU map: ");
+        Serial.WriteNumber(cpuCount);
+        Serial.WriteString(" logical CPU(s)\n");
+
+        bsp->ExtraArgument = 0;
+        WriteMapping(0, bsp, true);
+
+        ulong nextCpuId = 1;
+        for (ulong i = 0; i < cpuCount; i++)
+        {
+            LimineMpInfoX64* cpu = response->Cpus[i];
+            if (cpu == bsp)
+            {
+                continue;
+            }
+
+            cpu->ExtraArgument = nextCpuId;
+            WriteMapping(nextCpuId, cpu, false);
+            nextCpuId++;
+        }
+
+        if (nextCpuId != cpuCount || !ValidateAssignedMap(response))
+        {
+            Serial.WriteString("[SMP] WARNING: dense CPU map validation failed.\n");
+            return;
+        }
+
+        Serial.WriteString("[SMP] Dense CPU map verified: BSP=0, CpuIds are unique and contiguous.\n");
+        Serial.WriteString("[SMP] Stage 2 complete: dense CPU map ready; APs remain parked.\n");
+    }
+
+    private static bool TryValidateResponse(
+        LimineMpResponseX64* response,
+        out LimineMpInfoX64* bsp)
+    {
+        bsp = null;
+
+        if (response == null ||
+            response->Cpus == null ||
+            response->CpuCount == 0 ||
+            response->CpuCount > LimineMp.MaxXApicCpuCount)
+        {
+            Serial.WriteString("[SMP] WARNING: cannot build dense CPU map from invalid MP response.\n");
+            return false;
+        }
+
+        ulong cpuCount = response->CpuCount;
+        uint bspLapicId = response->BspLapicId;
+        ulong bspMatches = 0;
+
+        for (ulong i = 0; i < cpuCount; i++)
+        {
+            LimineMpInfoX64* cpu = response->Cpus[i];
+            if (cpu == null)
+            {
+                Serial.WriteString("[SMP] WARNING: null CPU descriptor while building dense CPU map.\n");
+                return false;
+            }
+
+            if (cpu->LapicId == bspLapicId)
+            {
+                bsp = cpu;
+                bspMatches++;
+            }
+
+            for (ulong j = 0; j < i; j++)
+            {
+                if (response->Cpus[j]->LapicId == cpu->LapicId)
+                {
+                    Serial.WriteString("[SMP] WARNING: duplicate LAPIC ID while building dense CPU map.\n");
+                    return false;
+                }
+            }
+        }
+
+        if (bspMatches != 1 || bsp == null)
+        {
+            Serial.WriteString("[SMP] WARNING: dense CPU map requires exactly one BSP descriptor.\n");
+            return false;
+        }
+
+        return true;
+    }
+
+    private static bool ValidateAssignedMap(LimineMpResponseX64* response)
+    {
+        int cpuCount = (int)response->CpuCount;
+        byte* seen = stackalloc byte[cpuCount];
+
+        for (int i = 0; i < cpuCount; i++)
+        {
+            seen[i] = 0;
+        }
+
+        for (ulong i = 0; i < response->CpuCount; i++)
+        {
+            LimineMpInfoX64* cpu = response->Cpus[i];
+            ulong cpuId = cpu->ExtraArgument;
+
+            if (cpuId >= response->CpuCount)
+            {
+                return false;
+            }
+
+            if (seen[(int)cpuId] != 0)
+            {
+                return false;
+            }
+
+            seen[(int)cpuId] = 1;
+
+            if (cpu->LapicId == response->BspLapicId && cpuId != 0)
+            {
+                return false;
+            }
+        }
+
+        for (int i = 0; i < cpuCount; i++)
+        {
+            if (seen[i] == 0)
+            {
+                return false;
+            }
+        }
+
+        return true;
+    }
+
+    private static void WriteMapping(ulong cpuId, LimineMpInfoX64* cpu, bool isBsp)
+    {
+        Serial.WriteString("[SMP] CpuId[");
+        Serial.WriteNumber(cpuId);
+        Serial.WriteString("] LAPIC=");
+        Serial.WriteNumber(cpu->LapicId);
+        Serial.WriteString(" processor=");
+        Serial.WriteNumber(cpu->ProcessorId);
+
+        if (isBsp)
+        {
+            Serial.WriteString(" BSP");
+        }
+
+        Serial.WriteString("\n");
+    }
+}
