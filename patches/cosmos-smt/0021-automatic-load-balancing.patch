+using System.Runtime.InteropServices;
+using Cosmos.Kernel.Core.CPU;
+using Cosmos.Kernel.Core.Scheduler;
+
+namespace Cosmos.Kernel.Core.Bridge;
+
+internal static class ManagedApAutomaticBalanceThreadNative
+{
+    [UnmanagedCallersOnly]
+    internal static void Entry(uint token)
+    {
+        SchedulerManager.RunStage21AutomaticBalanceThread(token);
+        while (true)
+        {
+            InternalCpu.Halt();
+        }
+    }
+}
