--- /dev/null
+++ b/src/Cosmos.Kernel.Core/Scheduler/SchedulerManager.QueueGate.cs
@@ -0,0 +1,51 @@
+using System;
+using System.Runtime.InteropServices;
+using SysThread = System.Threading.Thread;
+
+namespace Cosmos.Kernel.Core.Scheduler;
+
+public static partial class SchedulerManager
+{
+#if ARCH_X64
+    [LibraryImport("*", EntryPoint = "_native_x64_try_enter_scheduler_queue")]
+    [SuppressGCTransition]
+    private static partial int NativeTryEnterSchedulerQueue(uint cpuId);
+
+    [LibraryImport("*", EntryPoint = "_native_x64_exit_scheduler_queue")]
+    [SuppressGCTransition]
+    private static partial void NativeExitSchedulerQueue(uint cpuId);
+#endif
+
+    // Callers mask their own interrupts before taking a queue gate. Timer
+    // callbacks never spin: a reserved incoming handoff is retried next tick.
+    private static SchedulerQueueScope EnterSchedulerQueue(uint cpuId)
+    {
+#if ARCH_X64
+        while (NativeTryEnterSchedulerQueue(cpuId) != 1)
+        {
+            SysThread.SpinWait(1);
+        }
+#endif
+        return new SchedulerQueueScope(cpuId);
+    }
+
+    private static bool TryEnterSchedulerQueue(uint cpuId, out SchedulerQueueScope scope)
+    {
+        scope = new SchedulerQueueScope(cpuId);
+#if ARCH_X64
+        return NativeTryEnterSchedulerQueue(cpuId) == 1;
+#else
+        return true;
+#endif
+    }
+
+    private readonly struct SchedulerQueueScope(uint cpuId) : IDisposable
+    {
+        public void Dispose()
+        {
+#if ARCH_X64
+            NativeExitSchedulerQueue(cpuId);
+#endif
+        }
+    }
+}
