+    private static bool TrySelectAutomaticMigrationTarget(PerCpuState source, out uint targetCpuId)
+    {
+        targetCpuId = uint.MaxValue;
+        if (Volatile.Read(ref s_automaticLoadBalancingEnabled) == 0 ||
+            s_cpuStates is null || s_currentScheduler is null || s_cpuCount <= 2)
+        {
+            return false;
+        }
+
+        ulong now = GetTimestamp();
+        if (!source.CanAutomaticallyBalance(now))
+        {
+            return false;
+        }
+
+        int queued = s_currentScheduler.GetRunQueueCount(source);
+        if (queued < 1)
+        {
+            return false;
+        }
+
+        uint sourceLoad = checked((uint)queued + 1);
+        source.PublishRunnableCount(queued, true);
+        uint bestLoad = uint.MaxValue;
+        for (uint candidate = 1; candidate < s_cpuCount; candidate++)
+        {
+            if (candidate == source.CpuId)
+            {
+                continue;
+            }
+
+            PerCpuState destination = s_cpuStates[candidate];
+            uint candidateLoad = destination.PublishedRunnableCount;
+            // A command-0/completion-1 mailbox says that the native park loop
+            // is available, but it remains unchanged while an F4-dispatched
+            // worker is running. The owner-published zero load is therefore
+            // also required before this CPU may mutate the destination queue.
+            //
+            // Do not reserve candidates while scanning. Releasing a temporary
+            // reservation can race the destination owner's exact snapshot
+            // publication and decrement that fresh value back to zero. That
+            // made an active AP look parked and allowed a second remote queue
+            // mutation. Select read-only, then CAS exactly one final target.
+            if (candidateLoad == 0 && candidateLoad < bestLoad &&
+                sourceLoad >= candidateLoad + AutomaticBalanceHysteresis &&
+                NativeGetApplicationProcessorCommand(candidate) == 0 &&
+                NativeGetApplicationProcessorCompletion(candidate) == 1)
+            {
+                bestLoad = candidateLoad;
+                targetCpuId = candidate;
+            }
+        }
+
+        return targetCpuId != uint.MaxValue &&
+            s_cpuStates[targetCpuId].TryReserveIncomingRunnable(bestLoad);
+    }
