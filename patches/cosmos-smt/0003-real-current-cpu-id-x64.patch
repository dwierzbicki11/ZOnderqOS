+// uint _native_get_current_cpu_id(void)
+// Return the current logical processor's xAPIC ID. The SMT bring-up keeps
+// x2APIC disabled initially, so CPUID.1:EBX[31:24] is sufficient and matches
+// the index used by the per-CPU context-switch staging arrays.
+.global _native_get_current_cpu_id
+_native_get_current_cpu_id:
+    push rbx
+    mov eax, 1
+    xor ecx, ecx
+    cpuid
+    shr ebx, 24
+    mov eax, ebx
+    pop rbx
+    ret
+
