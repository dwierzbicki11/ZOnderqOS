+// int _native_x64_run_gc_rendezvous_test(uint64_t cpuCount,
+//                                         uint64_t rounds,
+//                                         uint64_t timeoutTscTicks)
+// Repeatedly publishes an epoch, sends vector 0xF3 to every AP, waits until
+// every AP is parked with IF=0, releases the epoch, then waits for all APs to
+// return to their interrupted HLT path. No managed code runs on an AP.
+.global _native_x64_run_gc_rendezvous_test
+_native_x64_run_gc_rendezvous_test:
+    push rbx
+    push r12
+    push r13
+    push r14
+    push r15
+    test rdi, rdi
+    jz .Lgc_test_invalid
+    cmp rdi, 256
+    ja .Lgc_test_invalid
+    test rsi, rsi
+    jz .Lgc_test_invalid
+    test rdx, rdx
+    jz .Lgc_test_invalid
+
+    mov r12, rdi
+    mov r13, rsi
+    mov r14, rdx
+    call .Lap_read_lapic_base
+    test rax, rax
+    jz .Lgc_test_invalid
+    mov qword ptr [rip + _native_x64_lapic_base], rax
+    mov r15, rax
+    mov qword ptr [rip + _gc_release_epoch], 0
+    mov ebx, 1
+
+.Lgc_test_round:
+    cmp rbx, r13
+    ja .Lgc_test_success
+
+    // Publish every AP slot before delivering any rendezvous IPI.
+    mov r10d, 1
+.Lgc_publish_loop:
+    cmp r10, r12
+    jae .Lgc_publish_done
+    lea r8, [rip + _gc_rendezvous_state]
+    mov rax, r10
+    shl rax, 6
+    add r8, rax
+    cmp dword ptr [r8 + 24], 0
+    jne .Lgc_test_invalid
+    mov qword ptr [r8 + 8], 0
+    mov qword ptr [r8 + 16], 0
+    mov qword ptr [r8 + 32], 0
+    mov qword ptr [r8 + 40], 0
+    mov qword ptr [r8 + 48], 0
+    mov qword ptr [r8 + 0], rbx
+    mov eax, 1
+    xchg dword ptr [r8 + 24], eax
+    inc r10
+    jmp .Lgc_publish_loop
+
+.Lgc_publish_done:
+    mfence
+    rdtsc
+    shl rdx, 32
+    or rax, rdx
+    mov r11, rax
+
+    mov r10d, 1
+.Lgc_send_loop:
+    cmp r10, r12
+    jae .Lgc_wait_parked
+    lea r8, [rip + _ap_boot_state]
+    mov rax, r10
+    shl rax, 6
+    add r8, rax
+    cmp dword ptr [r8 + 0], 1
+    jne .Lgc_test_invalid
+    mov edx, dword ptr [r8 + 8]
+    shl edx, 24
+    mov dword ptr [r15 + 0x310], edx
+    mov dword ptr [r15 + 0x300], 0x000000F3
+    inc r10
+    jmp .Lgc_send_loop
+
+.Lgc_wait_parked:
+    mov r10d, 1
+.Lgc_check_parked:
+    cmp r10, r12
+    jae .Lgc_all_parked
+    lea r8, [rip + _gc_rendezvous_state]
+    mov rax, r10
+    shl rax, 6
+    add r8, rax
+    cmp qword ptr [r8 + 8], rbx
+    jne .Lgc_park_poll
+    cmp dword ptr [r8 + 24], 2
+    jne .Lgc_park_poll
+    inc r10
+    jmp .Lgc_check_parked
+
+.Lgc_park_poll:
+    pause
+    rdtsc
+    shl rdx, 32
+    or rax, rdx
+    sub rax, r11
+    cmp rax, r14
+    jb .Lgc_wait_parked
+    mov eax, -1
+    jmp .Lgc_test_return
+
+.Lgc_all_parked:
+    mov rax, rbx
+    xchg qword ptr [rip + _gc_release_epoch], rax
+    mfence
+
+    rdtsc
+    shl rdx, 32
+    or rax, rdx
+    mov r11, rax
+
+.Lgc_wait_resumed:
+    mov r10d, 1
+.Lgc_check_resumed:
+    cmp r10, r12
+    jae .Lgc_round_done
+    lea r8, [rip + _gc_rendezvous_state]
+    mov rax, r10
+    shl rax, 6
+    add r8, rax
+    cmp qword ptr [r8 + 16], rbx
+    jne .Lgc_resume_poll
+    cmp dword ptr [r8 + 24], 0
+    jne .Lgc_resume_poll
+    inc r10
+    jmp .Lgc_check_resumed
+
+.Lgc_resume_poll:
+    pause
+    rdtsc
+    shl rdx, 32
+    or rax, rdx
+    sub rax, r11
+    cmp rax, r14
+    jb .Lgc_wait_resumed
+    mov eax, -1
+    jmp .Lgc_test_return
+
+.Lgc_round_done:
+    inc rbx
+    jmp .Lgc_test_round
+
+.Lgc_test_success:
+    mov eax, r13d
+    jmp .Lgc_test_return
+.Lgc_test_invalid:
+    mov eax, -2
+.Lgc_test_return:
+    pop r15
+    pop r14
+    pop r13
+    pop r12
+    pop rbx
+    ret
+
 
