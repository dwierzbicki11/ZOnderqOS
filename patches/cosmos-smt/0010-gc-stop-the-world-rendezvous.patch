+.global _native_x64_gc_rendezvous_handler
+_native_x64_gc_rendezvous_handler:
+    // Interrupt gates clear IF before entering here. Keep it clear for the
+    // complete stop-the-world interval: nested device/timer work must not run.
+    push rax
+    push rcx
+    push rdx
+    push r8
+    push r9
+    push r10
+
+    mov eax, dword ptr gs:[0]
+    test eax, eax
+    jz .Lgc_rdv_eoi_return
+    cmp eax, 255
+    ja .Lgc_rdv_eoi_return
+
+    lea r8, [rip + _gc_rendezvous_state]
+    mov ecx, eax
+    shl rcx, 6
+    add r8, rcx
+    mov rcx, qword ptr [r8 + 0]
+    test rcx, rcx
+    jz .Lgc_rdv_eoi_return
+
+    // Six pushes above = 48 bytes. The same-CPL interrupt frame starts at
+    // rsp+48 and contains RIP, CS, RFLAGS. The interrupted RSP is therefore
+    // the address immediately above that 24-byte frame.
+    lea r9, [rsp + 72]
+    mov qword ptr [r8 + 32], r9
+    mov r9, qword ptr [rsp + 48]
+    mov qword ptr [r8 + 40], r9
+    mov r9, qword ptr [rsp + 64]
+    mov qword ptr [r8 + 48], r9
+
+    mov qword ptr [r8 + 8], rcx
+    mov eax, 2
+    xchg dword ptr [r8 + 24], eax
+    mfence
+
+    // EOI before parking so the LAPIC does not keep the rendezvous interrupt
+    // in-service for the entire GC critical section.
+    mov rax, qword ptr [rip + _native_x64_lapic_base]
+    test rax, rax
+    jz .Lgc_rdv_wait_release
+    mov dword ptr [rax + 0xB0], 0
+
+.Lgc_rdv_wait_release:
+    mov rax, qword ptr [rip + _gc_release_epoch]
+    cmp rax, rcx
+    jae .Lgc_rdv_resume
+    pause
+    jmp .Lgc_rdv_wait_release
+
+.Lgc_rdv_resume:
+    mov eax, 3
+    xchg dword ptr [r8 + 24], eax
+    mov qword ptr [r8 + 16], rcx
+    mfence
+    xor eax, eax
+    xchg dword ptr [r8 + 24], eax
+    jmp .Lgc_rdv_restore
+
+.Lgc_rdv_eoi_return:
+    mov rax, qword ptr [rip + _native_x64_lapic_base]
+    test rax, rax
+    jz .Lgc_rdv_restore
+    mov dword ptr [rax + 0xB0], 0
+
+.Lgc_rdv_restore:
+    pop r10
+    pop r9
+    pop r8
+    pop rdx
+    pop rcx
+    pop rax
+    iretq
+
