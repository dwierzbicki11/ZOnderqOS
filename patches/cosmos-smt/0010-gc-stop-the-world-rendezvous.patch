+    ja .Lgc_get_invalid_\@
+    lea rcx, [rip + _gc_rendezvous_state]
+    mov eax, edi
+    shl rax, 6
+    add rcx, rax
+    .if \width == 4
+        mov eax, dword ptr [rcx + \offset]
+    .else
+        mov rax, qword ptr [rcx + \offset]
+    .endif
