     private static ulong ComputeStage16Checksum(uint cpuId, uint threadId) =>
         0x534D_5031_3600_0000UL ^ ((ulong)cpuId << 32) ^ threadId;
 
+    /// <summary>
+    /// Proves that an AP-local LAPIC timer can preempt a live managed worker,
+    /// preserve its interrupt frame, return to the AP idle context and later
+    /// resume that exact worker through the normal scheduler IRQ path.
+    /// </summary>
+    internal static unsafe bool RunApplicationProcessorTimerPreemptionProof()
+    {
+        if (!s_enabled || s_currentScheduler is null || s_cpuStates is null ||
+            s_cpuCount == 0 || !GarbageCollector.IsEnabled)
+        {
+            Serial.WriteString("[SCHED] WARNING: Stage 17 preemption prerequisites are not initialized.\n");
+            return false;
+        }
+
+#if ARCH_X64
+        SchedulerThread?[] workers = new SchedulerThread?[checked((int)s_cpuCount)];
+        ushort codeSelector = (ushort)NativeGetCodeSelector();
+        nuint entryPoint = (nuint)(delegate* unmanaged<uint, void>)&ManagedApPreemptionThreadNative.Entry;
+
+        for (uint cpuId = 1; cpuId < s_cpuCount; cpuId++)
+        {
+            PerCpuState state = s_cpuStates[cpuId];
+            if (!state.Stage15IdleStackEnrolled || state.Stage16DispatchState != 2 ||
+                state.Stage17PreemptionState != 0 || state.Stage17PreemptionCount != 0 ||
+                state.Stage17ResumeCount != 0 || state.IdleThread is null ||
+                !ReferenceEquals(state.CurrentThread, state.IdleThread))
+            {
+                Serial.WriteString("[SCHED] WARNING: Stage 17 per-CPU state is not preemptible.\n");
+                return false;
+            }
+
+            SchedulerThread worker = new()
+            {
+                Id = AllocateThreadId(),
+                CpuId = cpuId,
+                State = SchedulerThreadState.Created,
+                Flags = SchedulerThreadFlags.Pinned
+            };
+            worker.InitializeStack(entryPoint, codeSelector, cpuId);
+            CreateThread(cpuId, worker);
+            ReadyThread(cpuId, worker);
+            workers[cpuId] = worker;
+        }
+
+        long frequency = Stopwatch.Frequency;
+        ulong timeoutTicks = frequency > 0
+            ? checked((ulong)frequency * Stage17TimeoutSeconds)
+            : 5_000_000_000UL;
+
+        for (uint cpuId = 1; cpuId < s_cpuCount; cpuId++)
+        {
+            SchedulerThread? worker = workers[cpuId];
+            int preemptResult = NativeRunSchedulerDispatchTest(cpuId, timeoutTicks);
+            PerCpuState state = s_cpuStates[cpuId];
+            if (preemptResult != 1 || worker is null ||
+                worker.State != SchedulerThreadState.Ready ||
+                state.Stage17PreemptionState != 2 ||
+                state.Stage17PreemptionCount != 1 || state.Stage17ResumeCount != 0 ||
+                state.Stage17ThreadId != worker.Id ||
+                !ReferenceEquals(state.CurrentThread, state.IdleThread) ||
+                state.IdleThread?.State != SchedulerThreadState.Running)
+            {
+                Serial.WriteString("[SCHED] WARNING: Stage 17 AP preemption failed for CpuId=");
+                Serial.WriteNumber(cpuId);
+                Serial.WriteString(".\n");
+                return false;
+            }
+
+            if (!state.TryRequestStage17Resume(cpuId, worker.Id))
+            {
+                Serial.WriteString("[SCHED] WARNING: Stage 17 AP resume request failed for CpuId=");
+                Serial.WriteNumber(cpuId);
+                Serial.WriteString(".\n");
+                return false;
+            }
+
+            // The worker is already in the run queue after timer preemption,
+            // so explicitly request dispatch rather than calling ReadyThread.
+            state._needReschedule = true;
+            int resumeResult = NativeRunSchedulerDispatchTest(cpuId, timeoutTicks);
+            ulong expectedChecksum = ComputeStage17Checksum(cpuId, worker.Id);
+            if (resumeResult != 1 || worker.State != SchedulerThreadState.Dead ||
+                state.Stage17PreemptionState != 4 ||
+                state.Stage17PreemptionCount != 1 || state.Stage17ResumeCount != 1 ||
+                state.Stage17ThreadId != worker.Id ||
+                state.Stage17Checksum != expectedChecksum ||
+                !ReferenceEquals(state.CurrentThread, state.IdleThread) ||
+                state.IdleThread?.State != SchedulerThreadState.Running)
+            {
+                Serial.WriteString("[SCHED] WARNING: Stage 17 AP resume failed for CpuId=");
+                Serial.WriteNumber(cpuId);
+                Serial.WriteString(".\n");
+                return false;
+            }
+
+            Serial.WriteString("[SCHED-AP-PREEMPT] cpu=");
+            Serial.WriteNumber(cpuId);
+            Serial.WriteString(" thread=");
+            Serial.WriteNumber(worker.Id);
+            Serial.WriteString(" checksum=");
+            Serial.WriteHexWithPrefix(expectedChecksum);
+            Serial.WriteString(" state=preempted-resumed-exited-idle-restored\n");
+        }
+#else
+        // ARM64 remains a CPU0-only compile regression until MP bootstrap and
+        // a per-CPU interrupt-return context switch are implemented there.
+        return true;
+#endif
+
+        Serial.WriteString("[SCHED-AP-PREEMPT-TEST] PASS\n");
+        return true;
+    }
+
+    internal static void RunStage17PreemptedThread(uint expectedCpuId)
+    {
+        PerCpuState? state = CurrentCpuState;
+        SchedulerThread? thread = state?.CurrentThread;
+        if (state is null || thread is null || state.CpuId != expectedCpuId ||
+            thread.CpuId != expectedCpuId || ReferenceEquals(thread, state.IdleThread) ||
+            thread.State != SchedulerThreadState.Running ||
+            !state.TryEnterStage17Preemption(expectedCpuId, thread.Id))
+        {
+            Panic.Halt("Stage 17 AP scheduler thread entered with invalid ownership.");
+            return;
+        }
+
+#if ARCH_X64
+        // Unlike Stage 16, arm the timer while the worker is live. The timer
+        // must save this continuation and choose idle before the BSP requests
+        // a second dispatch of the same ready thread.
+        if (NativeArmSchedulerTimer() != 1)
+        {
+            Panic.Halt("Stage 17 AP scheduler timer could not be armed.");
+            return;
+        }
+#endif
+
+        while (state.Stage17PreemptionState != 3)
+        {
+            Thread.SpinWait(64);
+        }
+
+        using (InternalCpu.DisableInterruptsScope())
+        {
+            ulong checksum = ComputeStage17Checksum(expectedCpuId, thread.Id);
+            if (!state.TryCompleteStage17Resume(expectedCpuId, thread.Id, checksum))
+            {
+                Panic.Halt("Stage 17 AP scheduler thread failed to publish completion.");
+                return;
+            }
+
+            ExitThread(expectedCpuId, thread);
+#if ARCH_X64
+            if (NativeArmSchedulerTimer() != 1)
+            {
+                Panic.Halt("Stage 17 AP completion timer could not be armed.");
+                return;
+            }
+#endif
+        }
+    }
+
+    private static ulong ComputeStage17Checksum(uint cpuId, uint threadId) =>
+        0x534D_5031_3700_0000UL ^ ((ulong)cpuId << 32) ^ threadId;
+
     private static void Stage16DispatchInterrupt(ref IRQContext context)
     {
         _ = context;
@@ -1025,8 +1193,18 @@ public static partial class SchedulerManager
 
