+        PerCpuState? state = CurrentCpuState;
+        SchedulerThread? thread = state?.CurrentThread;
+        if (state is not null && thread is not null &&
+            !ReferenceEquals(thread, state.IdleThread) &&
+            state.Stage17PreemptionState == 1)
+        {
+            _ = state.TryRecordStage17Preemption(cpuId, thread.Id);
+        }
+
         nuint currentRsp = (nuint)Unsafe.AsPointer(ref context) - Stage16XmmSaveAreaSizeBytes;
-        OnTimerInterrupt(GetCurrentCpuId(), currentRsp, DefaultQuantumNs);
+        OnTimerInterrupt(cpuId, currentRsp, DefaultQuantumNs);
     }
 
