new file mode 100644
index 0000000..49ba262
--- /dev/null
+++ b/src/Cosmos.Kernel.Core/Bridge/Export/ManagedApPreemptionThreadNative.cs
@@ -0,0 +1,25 @@
+using System.Runtime.InteropServices;
+using Cosmos.Kernel.Core.CPU;
+using Cosmos.Kernel.Core.Scheduler;
+
+namespace Cosmos.Kernel.Core.Bridge;
+
+/// <summary>
+/// Stage-17 AP worker entered once as a new scheduler context and later
+/// resumed from the context saved by its LAPIC timer interrupt.
+/// </summary>
+internal static class ManagedApPreemptionThreadNative
+{
+    [UnmanagedCallersOnly]
+    internal static void Entry(uint expectedCpuId)
+    {
+        SchedulerManager.RunStage17PreemptedThread(expectedCpuId);
+
+        // Exit is completed by a timer-driven switch to idle. The original
+        // context was entered with a jump and therefore cannot return.
+        while (true)
+        {
+            InternalCpu.Halt();
+        }
+    }
+}
diff --git a/src/Cosmos.Kernel.Core/Scheduler/PerCpuState.cs b/src/Cosmos.Kernel.Core/Scheduler/PerCpuState.cs
index 8b122bd..8c42b6c 100644
--- a/src/Cosmos.Kernel.Core/Scheduler/PerCpuState.cs
+++ b/src/Cosmos.Kernel.Core/Scheduler/PerCpuState.cs
@@ -66,6 +66,11 @@ public sealed class PerCpuState : SchedulerExtensible
     private int _stage16DispatchCount;
     private uint _stage16ThreadId;
     private ulong _stage16Checksum;
+    private int _stage17PreemptionState;
+    private int _stage17PreemptionCount;
+    private int _stage17ResumeCount;
+    private uint _stage17ThreadId;
+    private ulong _stage17Checksum;
 
     /// <summary>
     /// Stage-13 per-CPU scheduler foundation phase: 0=not entered,
@@ -137,4 +142,58 @@ public sealed class PerCpuState : SchedulerExtensible
         Volatile.Write(ref _stage16Checksum, checksum);
         return Interlocked.CompareExchange(ref _stage16DispatchState, 2, 1) == 1;
     }
+
+    // Stage 17 phases: 0=not entered, 1=worker running, 2=timer preempted,
+    // 3=resume requested by the BSP, 4=resumed worker completed.
+    internal uint Stage17PreemptionState => (uint)Volatile.Read(ref _stage17PreemptionState);
+    internal uint Stage17PreemptionCount => (uint)Volatile.Read(ref _stage17PreemptionCount);
+    internal uint Stage17ResumeCount => (uint)Volatile.Read(ref _stage17ResumeCount);
+    internal uint Stage17ThreadId => Volatile.Read(ref _stage17ThreadId);
+    internal ulong Stage17Checksum => Volatile.Read(ref _stage17Checksum);
+
+    internal bool TryEnterStage17Preemption(uint expectedCpuId, uint threadId)
+    {
+        if (CpuId != expectedCpuId || Stage16DispatchState != 2 ||
+            Stage17PreemptionState != 0)
+        {
+            return false;
+        }
+
+        // Publish ownership before phase 1. The AP timer may interrupt on the
+        // next instruction and its handler must never observe phase 1 with a
+        // stale thread ID.
+        Volatile.Write(ref _stage17ThreadId, threadId);
+        return Interlocked.CompareExchange(ref _stage17PreemptionState, 1, 0) == 0;
+    }
+
+    internal bool TryRecordStage17Preemption(uint expectedCpuId, uint threadId)
+    {
+        if (CpuId != expectedCpuId || Stage17ThreadId != threadId ||
+            Interlocked.CompareExchange(ref _stage17PreemptionState, 2, 1) != 1)
+        {
+            return false;
+        }
+
+        Interlocked.Increment(ref _stage17PreemptionCount);
+        return true;
+    }
+
+    internal bool TryRequestStage17Resume(uint expectedCpuId, uint threadId)
+    {
+        return CpuId == expectedCpuId && Stage17ThreadId == threadId &&
+            Interlocked.CompareExchange(ref _stage17PreemptionState, 3, 2) == 2;
+    }
+
+    internal bool TryCompleteStage17Resume(uint expectedCpuId, uint threadId, ulong checksum)
+    {
+        if (CpuId != expectedCpuId || Stage17ThreadId != threadId || checksum == 0 ||
+            Stage17PreemptionState != 3)
+        {
+            return false;
+        }
+
+        Volatile.Write(ref _stage17Checksum, checksum);
+        Interlocked.Increment(ref _stage17ResumeCount);
+        return Interlocked.CompareExchange(ref _stage17PreemptionState, 4, 3) == 3;
+    }
 }
