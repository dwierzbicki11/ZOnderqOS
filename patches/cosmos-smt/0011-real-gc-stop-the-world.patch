+// long _native_x64_gc_stop_world()
+// Returns 0 before SMP is active / on a single CPU, a positive rendezvous
+// epoch after every AP is parked, or a negative error code.
+.global _native_x64_gc_stop_world
+_native_x64_gc_stop_world:
+    push rbx
+    push r12
+    push r13
+    push r14
+    push r15
+    mov r14, qword ptr [rip + _smp_gc_timeout_tsc_ticks]
+    test r14, r14
+    jz .Lgc_runtime_stop_invalid
+    mov r12, qword ptr [rip + _smp_cpu_count]
+    cmp r12, 1
+    jbe .Lgc_runtime_stop_single
+    cmp r12, 256
+    ja .Lgc_runtime_stop_invalid
+    cmp dword ptr gs:[0], 0
+    jne .Lgc_runtime_stop_invalid
+
+    call .Lap_read_lapic_base
+    test rax, rax
+    jz .Lgc_runtime_stop_invalid
+    mov qword ptr [rip + _native_x64_lapic_base], rax
+    mov r15, rax
+
+    mov r13, qword ptr [rip + _gc_release_epoch]
+    inc r13
+    jz .Lgc_runtime_stop_invalid
+
+    // Validate every AP before sending any rendezvous IPI, then publish the
+    // new epoch into one cache-line-local record per AP.
+    mov ebx, 1
+.Lgc_runtime_publish:
+    cmp rbx, r12
+    jae .Lgc_runtime_publish_done
+    lea r8, [rip + _ap_boot_state]
+    mov rax, rbx
+    shl rax, 6
+    add r8, rax
+    cmp dword ptr [r8 + 0], 1
+    jne .Lgc_runtime_stop_invalid
+
+    lea r9, [rip + _gc_rendezvous_state]
+    mov rax, rbx
+    shl rax, 6
+    add r9, rax
+    cmp dword ptr [r9 + 24], 0
+    jne .Lgc_runtime_stop_invalid
+    mov qword ptr [r9 + 8], 0
+    mov qword ptr [r9 + 16], 0
+    mov qword ptr [r9 + 32], 0
+    mov qword ptr [r9 + 40], 0
+    mov qword ptr [r9 + 48], 0
+    mov qword ptr [r9 + 0], r13
+    mov eax, 1
+    xchg dword ptr [r9 + 24], eax
+    inc rbx
+    jmp .Lgc_runtime_publish
+
+.Lgc_runtime_publish_done:
+    mfence
+    rdtsc
+    shl rdx, 32
+    or rax, rdx
+    mov r11, rax
+
+    mov ebx, 1
+.Lgc_runtime_send:
+    cmp rbx, r12
+    jae .Lgc_runtime_wait_parked
+    lea r8, [rip + _ap_boot_state]
+    mov rax, rbx
+    shl rax, 6
+    add r8, rax
+    mov edx, dword ptr [r8 + 8]
+    shl edx, 24
+    mov dword ptr [r15 + 0x310], edx
+    mov dword ptr [r15 + 0x300], 0x000000F3
+    inc rbx
+    jmp .Lgc_runtime_send
+
+.Lgc_runtime_wait_parked:
+    mov ebx, 1
+.Lgc_runtime_check_parked:
+    cmp rbx, r12
+    jae .Lgc_runtime_stop_success
+    lea r8, [rip + _gc_rendezvous_state]
+    mov rax, rbx
+    shl rax, 6
+    add r8, rax
+    cmp qword ptr [r8 + 8], r13
+    jne .Lgc_runtime_stop_poll
+    cmp dword ptr [r8 + 24], 2
+    jne .Lgc_runtime_stop_poll
+    inc rbx
+    jmp .Lgc_runtime_check_parked
+
+.Lgc_runtime_stop_poll:
+    pause
+    rdtsc
+    shl rdx, 32
+    or rax, rdx
+    sub rax, r11
+    cmp rax, r14
+    jb .Lgc_runtime_wait_parked
+
+    // Never return to managed GC with a subset of APs parked. Publish release
+    // first so every AP that did acknowledge can escape before the caller panics.
+    mov rax, r13
+    xchg qword ptr [rip + _gc_release_epoch], rax
+    mfence
+    mov rax, -1
+    jmp .Lgc_runtime_stop_return
+
+.Lgc_runtime_stop_success:
+    mov rax, r13
+    jmp .Lgc_runtime_stop_return
+.Lgc_runtime_stop_single:
+    xor eax, eax
+    jmp .Lgc_runtime_stop_return
+.Lgc_runtime_stop_invalid:
+    mov rax, -2
+.Lgc_runtime_stop_return:
+    pop r15
+    pop r14
+    pop r13
+    pop r12
+    pop rbx
+    ret
+
+// int _native_x64_gc_resume_world(uint64_t epoch)
+// Releases the APs parked by _native_x64_gc_stop_world and waits until every
+// AP has returned through IRETQ to its previous native idle context.
+.global _native_x64_gc_resume_world
+_native_x64_gc_resume_world:
+    push rbx
+    push r12
+    push r13
+    push r14
+    test rdi, rdi
+    jz .Lgc_runtime_resume_single
+    mov r13, rdi
+    mov r14, qword ptr [rip + _smp_gc_timeout_tsc_ticks]
+    test r14, r14
+    jz .Lgc_runtime_resume_invalid
+    mov r12, qword ptr [rip + _smp_cpu_count]
+    cmp r12, 1
+    jbe .Lgc_runtime_resume_single
+    cmp r12, 256
+    ja .Lgc_runtime_resume_invalid
+    cmp dword ptr gs:[0], 0
+    jne .Lgc_runtime_resume_invalid
+
+    mov rax, r13
+    xchg qword ptr [rip + _gc_release_epoch], rax
+    mfence
+    rdtsc
+    shl rdx, 32
+    or rax, rdx
+    mov r11, rax
+
+.Lgc_runtime_wait_resumed:
+    mov ebx, 1
+.Lgc_runtime_check_resumed:
+    cmp rbx, r12
+    jae .Lgc_runtime_resume_success
+    lea r8, [rip + _gc_rendezvous_state]
+    mov rax, rbx
+    shl rax, 6
+    add r8, rax
+    cmp qword ptr [r8 + 16], r13
+    jne .Lgc_runtime_resume_poll
+    cmp dword ptr [r8 + 24], 0
+    jne .Lgc_runtime_resume_poll
+    inc rbx
+    jmp .Lgc_runtime_check_resumed
+
+.Lgc_runtime_resume_poll:
+    pause
+    rdtsc
+    shl rdx, 32
+    or rax, rdx
+    sub rax, r11
+    cmp rax, r14
+    jb .Lgc_runtime_wait_resumed
+    mov eax, -1
+    jmp .Lgc_runtime_resume_return
+
+.Lgc_runtime_resume_success:
+    mov eax, r12d
+    dec eax
+    jmp .Lgc_runtime_resume_return
+.Lgc_runtime_resume_single:
+    xor eax, eax
+    jmp .Lgc_runtime_resume_return
+.Lgc_runtime_resume_invalid:
+    mov eax, -2
+.Lgc_runtime_resume_return:
+    pop r14
+    pop r13
+    pop r12
+    pop rbx
+    ret
+
