+    private static void RunRealGcStopTheWorldIntegrationProof()
+    {
+        if (!GarbageCollector.IsEnabled)
+        {
+            Cosmos.Kernel.Core.Panic.Halt("Stage 11 requires OrionGC to be initialized.");
+        }
+
+        Serial.WriteString("[GC-SMP-INTEGRATION] begin\n");
+        byte[] survivor = new byte[256];
+        survivor[0] = 0x5A;
+        survivor[255] = 0xA5;
+        int collectionStart = GarbageCollector.GetCollectionIndex();
+
+        for (uint round = 1; round <= 3; round++)
+        {
+            int freed = GarbageCollector.Collect();
+            int collectionIndex = GarbageCollector.GetCollectionIndex();
+            if (collectionIndex != collectionStart + (int)round ||
+                survivor[0] != 0x5A || survivor[255] != 0xA5)
+            {
+                Cosmos.Kernel.Core.Panic.Halt("Stage 11 real SMP GC integration proof failed.");
+            }
+
+            Serial.WriteString("[GC-SMP-INTEGRATION] round=");
+            Serial.WriteNumber(round);
+            Serial.WriteString(" collection=");
+            Serial.WriteNumber((ulong)collectionIndex);
+            Serial.WriteString(" freed=");
+            Serial.WriteNumber((ulong)freed);
+            Serial.WriteString("\n");
+        }
+
+        Serial.WriteString("[GC-SMP-INTEGRATION] survivor=OK collections=3\n");
+        Serial.WriteString("[GC-SMP-INTEGRATION-TEST] PASS\n");
+    }
