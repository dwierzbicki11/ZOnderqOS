diff --git a/src/Cosmos.Kernel.HAL.X64/SmpApBootstrap.cs b/src/Cosmos.Kernel.HAL.X64/SmpApBootstrap.cs
index eaf3c1d..4a9621f 100644
--- a/src/Cosmos.Kernel.HAL.X64/SmpApBootstrap.cs
+++ b/src/Cosmos.Kernel.HAL.X64/SmpApBootstrap.cs
@@ -52,6 +52,14 @@ internal static unsafe partial class SmpApBootstrap
     [SuppressGCTransition]
     private static partial ulong NativeGetWorkCounter(uint cpuId);
 
+    [LibraryImport("*", EntryPoint = "_native_x64_run_ap_ipi_test")]
+    [SuppressGCTransition]
+    private static partial int NativeRunApIpiTest(ulong cpuCount, ulong timeoutTscTicks);
+
+    [LibraryImport("*", EntryPoint = "_native_x64_get_ap_ipi_count")]
+    [SuppressGCTransition]
+    private static partial ulong NativeGetIpiCount(uint cpuId);
+
     internal static bool StartAndParkApplicationProcessors()
     {
         LimineMpResponseX64* response = LimineMp.X64Response;
@@ -195,8 +203,49 @@ internal static unsafe partial class SmpApBootstrap
 
         Serial.WriteString("[SMP] Native work proof complete: ");
         Serial.WriteNumber((ulong)completed);
-        Serial.WriteString(" AP worker(s); APs are now parked with interrupts disabled.\n");
+        Serial.WriteString(" AP worker(s); APs are now parked awaiting native fixed IPI.\n");
         Serial.WriteString("[SMP-TEST] PASS\n");
         return true;
     }
+
+    internal static bool RunApplicationProcessorIpiProof()
+    {
+        LimineMpResponseX64* response = LimineMp.X64Response;
+        if (response == null || response->Cpus == null || response->CpuCount == 0 ||
+            response->CpuCount > LimineMp.MaxXApicCpuCount)
+        {
+            Serial.WriteString("[SMP] WARNING: fixed IPI proof has no valid CPU topology.\n");
+            return false;
+        }
+
+        long frequency = X64CpuOps.TscFrequency;
+        ulong timeoutTicks = frequency > 0 ? checked((ulong)frequency * ApReadyTimeoutSeconds) : 5_000_000_000UL;
+        int expected = checked((int)response->CpuCount - 1);
+        int acknowledged = NativeRunApIpiTest(response->CpuCount, timeoutTicks);
+        if (acknowledged != expected)
+        {
+            Serial.WriteString("[SMP] WARNING: fixed IPI acknowledgement timed out or rejected state.\n");
+            return false;
+        }
+
+        for (uint cpuId = 1; cpuId < response->CpuCount; cpuId++)
+        {
+            ulong count = NativeGetIpiCount(cpuId);
+            if (count != 1)
+            {
+                Serial.WriteString("[SMP] WARNING: fixed IPI count mismatch for CpuId=");
+                Serial.WriteNumber(cpuId);
+                Serial.WriteString("\n");
+                return false;
+            }
+            Serial.WriteString("[APIC] CPU ");
+            Serial.WriteNumber(cpuId);
+            Serial.WriteString(" fixed IPI ack count=");
+            Serial.WriteNumber(count);
+            Serial.WriteString("\n");
+        }
+
+        Serial.WriteString("[APIC-TEST] PASS\n");
+        return true;
+    }
 }
diff --git a/src/Cosmos.Kernel.HAL.X64/X64PlatformInitializer.cs b/src/Cosmos.Kernel.HAL.X64/X64PlatformInitializer.cs
index 9a31b5b..1fed060 100644
