+    private static unsafe void BuildDenseCpuMap()
+    {
+        LimineMpResponseX64* response = LimineMp.X64Response;
+        if (response == null || response->Cpus == null || response->CpuCount == 0 ||
+            response->CpuCount > LimineMp.MaxXApicCpuCount)
+        {
+            Serial.WriteString("[SMP] WARNING: cannot build dense CPU map from invalid MP response.\n");
+            return;
+        }
+
+        Serial.WriteString("[SMP] Dense CPU map: ");
+        Serial.WriteNumber(response->CpuCount);
+        Serial.WriteString(" logical CPU(s)\n");
+
+        // CpuId 0 is always the BSP. This is deliberate: existing single-CPU
+        // scheduler/runtime state remains attached to CPU0 while SMP grows.
+        ulong denseId = 0;
+        LimineMpInfoX64* bsp = null;
+        for (ulong i = 0; i < response->CpuCount; i++)
+        {
+            LimineMpInfoX64* cpu = response->Cpus[i];
+            if (cpu != null && cpu->LapicId == response->BspLapicId)
+            {
+                bsp = cpu;
+                break;
+            }
+        }
+
+        if (bsp == null)
+        {
+            Serial.WriteString("[SMP] WARNING: BSP missing while building dense CPU map.\n");
+            return;
+        }
+
+        PrintDenseCpu(denseId++, bsp, true);
+
+        // APs get contiguous scheduler IDs in Limine descriptor order. Hardware
+        // LAPIC IDs are metadata only; they are never used as scheduler indexes.
+        for (ulong i = 0; i < response->CpuCount; i++)
+        {
+            LimineMpInfoX64* cpu = response->Cpus[i];
+            if (cpu == null || cpu == bsp)
+                continue;
+            PrintDenseCpu(denseId++, cpu, false);
+        }
+
+        if (denseId != response->CpuCount)
+        {
+            Serial.WriteString("[SMP] WARNING: dense CPU map size differs from MP CPU count.\n");
+            return;
+        }
+
+        Serial.WriteString("[SMP] Stage 2 complete: dense CPU map ready; APs remain parked.\n");
+    }
+
+    private static unsafe void PrintDenseCpu(ulong cpuId, LimineMpInfoX64* cpu, bool bsp)
+    {
+        Serial.WriteString("[SMP] CpuId[");
+        Serial.WriteNumber(cpuId);
+        Serial.WriteString("] LAPIC=");
+        Serial.WriteNumber(cpu->LapicId);
+        Serial.WriteString(" processor=");
+        Serial.WriteNumber(cpu->ProcessorId);
+        if (bsp)
+            Serial.WriteString(" BSP");
+        Serial.WriteString("\n");
+    }
+
