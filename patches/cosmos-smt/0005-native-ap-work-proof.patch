+    private static partial int NativeRunApWorkTest(
+        ulong cpuCount,
+        ulong timeoutTscTicks);
+
+    [LibraryImport("*", EntryPoint = "_native_x64_get_ap_work_counter")]
+    [SuppressGCTransition]
+    private static partial ulong NativeGetWorkCounter(uint cpuId);
+
     internal static bool StartAndParkApplicationProcessors()
     {
         LimineMpResponseX64* response = LimineMp.X64Response;
@@ -140,4 +150,53 @@ internal static unsafe partial class SmpApBootstrap
         Serial.WriteString("[SMP-BOOT] PASS\n");
         return true;
     }
+
+    internal static bool RunApplicationProcessorWorkProof()
+    {
+        const ulong ExpectedCounter = 100_000;
+        LimineMpResponseX64* response = LimineMp.X64Response;
+        if (response == null || response->Cpus == null ||
+            response->CpuCount == 0 ||
+            response->CpuCount > LimineMp.MaxXApicCpuCount)
+        {
+            Serial.WriteString("[SMP] WARNING: native AP work proof has no valid CPU topology.\n");
+            return false;
+        }
+
+        long frequency = X64CpuOps.TscFrequency;
+        ulong timeoutTicks = frequency > 0
+            ? checked((ulong)frequency * ApReadyTimeoutSeconds)
+            : 5_000_000_000UL;
+        int expected = checked((int)response->CpuCount - 1);
+        int completed = NativeRunApWorkTest(response->CpuCount, timeoutTicks);
+        if (completed != expected)
+        {
+            Serial.WriteString("[SMP] WARNING: native AP work proof timed out or rejected invalid state.\n");
+            return false;
+        }
+
+        for (uint cpuId = 1; cpuId < response->CpuCount; cpuId++)
+        {
+            ulong counter = NativeGetWorkCounter(cpuId);
+            if (counter != ExpectedCounter)
+            {
+                Serial.WriteString("[SMP] WARNING: AP work counter mismatch for CpuId=");
+                Serial.WriteNumber(cpuId);
+                Serial.WriteString("\n");
+                return false;
+            }
+
+            Serial.WriteString("[SMP-TEST] cpu=");
+            Serial.WriteNumber(cpuId);
+            Serial.WriteString(" counter=");
+            Serial.WriteNumber(counter);
+            Serial.WriteString("\n");
+        }
+
+        Serial.WriteString("[SMP] Native work proof complete: ");
+        Serial.WriteNumber((ulong)completed);
+        Serial.WriteString(" AP worker(s); APs are now parked with interrupts disabled.\n");
+        Serial.WriteString("[SMP-TEST] PASS\n");
+        return true;
+    }
 }
