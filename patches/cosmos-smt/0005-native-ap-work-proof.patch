+// Stage 5 command mailbox. The BSP publishes command 1 only after every AP
+// has reported READY. Each AP atomically increments its own cache-line-local
+// counter, publishes DONE, and only then enters the permanent parked path.
+.Lap_wait_work:
+    pause
+    cmp dword ptr [r14 + 32], 1
+    jne .Lap_wait_work
+    mov r15d, 100000
+
+.Lap_work_loop:
+    lock inc qword ptr [r14 + 40]
+    dec r15d
+    jne .Lap_work_loop
+    mfence
+    mov eax, 1
+    xchg dword ptr [r14 + 48], eax
+
 .Lap_park:
     cli
     hlt
@@ -514,6 +534,102 @@ AP_STATE_GETTER _native_x64_get_ap_lapic_id, 8, 4
 AP_STATE_GETTER _native_x64_get_ap_gs_id, 12, 4
 AP_STATE_GETTER _native_x64_get_ap_stack, 16, 8
 AP_STATE_GETTER _native_x64_get_ap_rflags, 24, 8
+AP_STATE_GETTER _native_x64_get_ap_work_counter, 40, 8
+
+// int _native_x64_run_ap_work_test(uint64_t cpuCount,
+//                                  uint64_t timeoutTscTicks)
+// Publishes one bounded native work command to each dense AP CpuId and waits
+// for every AP to report completion. APs remain native-only with IF=0.
+.global _native_x64_run_ap_work_test
+_native_x64_run_ap_work_test:
+    push rbx
+    push r12
+    push r13
+    push r14
+    push r15
+
+    test rdi, rdi
+    jz .Lap_work_invalid
+    cmp rdi, 256
+    ja .Lap_work_invalid
+    test rsi, rsi
+    jz .Lap_work_invalid
+
+    mov r12, rdi
+    mov r13, rsi
+    lea r14, [r12 - 1]
+    mov ebx, 1
+
+.Lap_command_loop:
+    cmp rbx, r12
+    jae .Lap_commands_published
+    lea r8, [rip + _ap_boot_state]
+    mov rax, rbx
+    shl rax, 6
+    add r8, rax
+    cmp dword ptr [r8 + 0], 1
+    jne .Lap_work_invalid
+    cmp qword ptr [r8 + 40], 0
+    jne .Lap_work_invalid
+    cmp dword ptr [r8 + 48], 0
+    jne .Lap_work_invalid
+    mov eax, 1
+    xchg dword ptr [r8 + 32], eax
+    inc rbx
+    jmp .Lap_command_loop
+
+.Lap_commands_published:
+    rdtsc
+    shl rdx, 32
+    or rax, rdx
+    mov r15, rax
+
+.Lap_work_poll:
+    xor r11d, r11d
+    mov ebx, 1
+
+.Lap_work_count_loop:
+    cmp rbx, r12
+    jae .Lap_work_count_done
+    lea r8, [rip + _ap_boot_state]
+    mov rax, rbx
+    shl rax, 6
+    add r8, rax
+    cmp dword ptr [r8 + 48], 1
+    jne .Lap_work_count_next
+    inc r11d
+
+.Lap_work_count_next:
+    inc rbx
+    jmp .Lap_work_count_loop
+
+.Lap_work_count_done:
+    cmp r11, r14
+    je .Lap_work_success
+    pause
+    rdtsc
+    shl rdx, 32
+    or rax, rdx
+    sub rax, r15
+    cmp rax, r13
+    jb .Lap_work_poll
+    mov eax, -1
+    jmp .Lap_work_return
+
+.Lap_work_invalid:
+    mov eax, -2
+    jmp .Lap_work_return
+
+.Lap_work_success:
+    mov eax, r14d
+
+.Lap_work_return:
+    pop r15
+    pop r14
+    pop r13
+    pop r12
+    pop rbx
+    ret
 
