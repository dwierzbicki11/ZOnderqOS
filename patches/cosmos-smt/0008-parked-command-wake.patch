@@ -64,6 +64,10 @@ internal static unsafe partial class SmpApBootstrap
     [SuppressGCTransition]
     private static partial int NativeRunApIpiRounds(ulong cpuCount, ulong rounds, ulong timeoutTscTicks);
 
+    [LibraryImport("*", EntryPoint = "_native_x64_run_ap_parked_command_test")]
+    [SuppressGCTransition]
+    private static partial int NativeRunApParkedCommandTest(ulong cpuCount, ulong timeoutTscTicks);
+
     internal static bool StartAndParkApplicationProcessors()
     {
         LimineMpResponseX64* response = LimineMp.X64Response;
@@ -295,4 +299,51 @@ internal static unsafe partial class SmpApBootstrap
         Serial.WriteString("[APIC-RUN-TEST] PASS\n");
         return true;
     }
+
+    internal static bool RunApplicationProcessorParkedCommandProof()
+    {
+        const ulong ExpectedCounter = 100_001;
+        const ulong ExpectedIpiCount = 5;
+        LimineMpResponseX64* response = LimineMp.X64Response;
+        if (response == null || response->Cpus == null || response->CpuCount == 0 ||
+            response->CpuCount > LimineMp.MaxXApicCpuCount)
+        {
+            Serial.WriteString("[SMP] WARNING: parked AP command proof has no valid CPU topology.\n");
+            return false;
+        }
+
+        long frequency = X64CpuOps.TscFrequency;
+        ulong timeoutTicks = frequency > 0 ? checked((ulong)frequency * ApReadyTimeoutSeconds) : 5_000_000_000UL;
+        int expected = checked((int)response->CpuCount - 1);
+        int completed = NativeRunApParkedCommandTest(response->CpuCount, timeoutTicks);
+        if (completed != expected)
+        {
+            Serial.WriteString("[SMP] WARNING: parked AP command proof timed out or rejected state.\n");
+            return false;
+        }
+
+        for (uint cpuId = 1; cpuId < response->CpuCount; cpuId++)
+        {
+            ulong counter = NativeGetWorkCounter(cpuId);
+            ulong ipiCount = NativeGetIpiCount(cpuId);
+            if (counter != ExpectedCounter || ipiCount != ExpectedIpiCount)
+            {
+                Serial.WriteString("[SMP] WARNING: parked AP command state mismatch for CpuId=");
+                Serial.WriteNumber(cpuId);
+                Serial.WriteString("\n");
+                return false;
+            }
+
+            Serial.WriteString("[SMP-IDLE] cpu=");
+            Serial.WriteNumber(cpuId);
+            Serial.WriteString(" parked-command counter=");
+            Serial.WriteNumber(counter);
+            Serial.WriteString(" ipi=");
+            Serial.WriteNumber(ipiCount);
+            Serial.WriteString("\n");
+        }
+
+        Serial.WriteString("[SMP-IDLE-TEST] PASS\n");
+        return true;
+    }
 }
