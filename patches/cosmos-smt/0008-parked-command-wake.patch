+// int _native_x64_run_ap_parked_command_test(uint64_t cpuCount,
+//                                            uint64_t timeoutTscTicks)
+// Publishes one native command to each parked AP, wakes it with a fixed IPI,
+// and waits for the AP idle path after HLT to complete the command.
+.global _native_x64_run_ap_parked_command_test
+_native_x64_run_ap_parked_command_test:
+    push rbx
+    push r12
+    push r13
+    push r14
+    push r15
+    test rdi, rdi
+    jz .Lap_parkcmd_invalid
+    cmp rdi, 256
+    ja .Lap_parkcmd_invalid
+    test rsi, rsi
+    jz .Lap_parkcmd_invalid
+    mov r12, rdi
+    mov r13, rsi
+    call .Lap_read_lapic_base
+    test rax, rax
+    jz .Lap_parkcmd_invalid
+    mov qword ptr [rip + _native_x64_lapic_base], rax
+    mov r15, rax
+    xor r14d, r14d
+    mov ebx, 1
+.Lap_parkcmd_loop:
+    cmp rbx, r12
+    jae .Lap_parkcmd_success
+    lea r8, [rip + _ap_boot_state]
+    mov rax, rbx
+    shl rax, 6
+    add r8, rax
+    cmp dword ptr [r8 + 0], 1
+    jne .Lap_parkcmd_invalid
+    cmp qword ptr [r8 + 40], 100000
+    jne .Lap_parkcmd_invalid
+    cmp qword ptr [r8 + 56], 4
+    jne .Lap_parkcmd_invalid
+    xor eax, eax
+    xchg dword ptr [r8 + 48], eax
+    mov eax, 2
+    xchg dword ptr [r8 + 4], eax
+    test eax, eax
+    jne .Lap_parkcmd_invalid
+    mov edx, dword ptr [r8 + 8]
+    shl edx, 24
+    mov dword ptr [r15 + 0x310], edx
+    mov dword ptr [r15 + 0x300], 0x000000F1
+    rdtsc
+    shl rdx, 32
+    or rax, rdx
+    mov r11, rax
+.Lap_parkcmd_wait:
+    cmp dword ptr [r8 + 48], 1
+    jne .Lap_parkcmd_poll
+    cmp qword ptr [r8 + 40], 100001
+    jne .Lap_parkcmd_invalid
+    cmp qword ptr [r8 + 56], 5
+    jne .Lap_parkcmd_invalid
+    inc r14
+    inc rbx
+    jmp .Lap_parkcmd_loop
+.Lap_parkcmd_poll:
+    pause
+    rdtsc
+    shl rdx, 32
+    or rax, rdx
+    sub rax, r11
+    cmp rax, r13
+    jb .Lap_parkcmd_wait
+    mov eax, -1
+    jmp .Lap_parkcmd_return
+.Lap_parkcmd_success:
+    mov eax, r14d
+    jmp .Lap_parkcmd_return
+.Lap_parkcmd_invalid:
+    mov eax, -2
+.Lap_parkcmd_return:
+    pop r15
+    pop r14
+    pop r13
+    pop r12
+    pop rbx
+    ret
+
+
