diff --git a/src/Cosmos.Kernel.Native.X64/CPU/Interrupts.s b/src/Cosmos.Kernel.Native.X64/CPU/Interrupts.s
index c519e59..378c2d2 100644
--- a/src/Cosmos.Kernel.Native.X64/CPU/Interrupts.s
+++ b/src/Cosmos.Kernel.Native.X64/CPU/Interrupts.s
@@ -673,6 +673,92 @@ _native_x64_run_ap_ipi_test:
     ret
 
 
+// int _native_x64_run_ap_ipi_rounds(uint64_t cpuCount,
+//                                   uint64_t rounds,
+//                                   uint64_t timeoutTscTicks)
+// Sends several fixed IPIs to every parked AP and waits for each native handler
+// acknowledgement. APs remain in the native HLT loop between IPIs.
+.global _native_x64_run_ap_ipi_rounds
+_native_x64_run_ap_ipi_rounds:
+    push rbx
+    push r12
+    push r13
+    push r14
+    push r15
+    test rdi, rdi
+    jz .Lap_ipi_rounds_invalid
+    cmp rdi, 256
+    ja .Lap_ipi_rounds_invalid
+    test rsi, rsi
+    jz .Lap_ipi_rounds_invalid
+    test rdx, rdx
+    jz .Lap_ipi_rounds_invalid
+    mov r12, rdi
+    mov r13, rsi
+    mov r14, rdx
+    call .Lap_read_lapic_base
+    test rax, rax
+    jz .Lap_ipi_rounds_invalid
+    mov qword ptr [rip + _native_x64_lapic_base], rax
+    mov r15, rax
+    xor r9d, r9d
+    xor r10d, r10d
+.Lap_ipi_round_loop:
+    cmp r10, r13
+    jae .Lap_ipi_rounds_success
+    mov ebx, 1
+.Lap_ipi_round_cpu_loop:
+    cmp rbx, r12
+    jae .Lap_ipi_round_next
+    lea r8, [rip + _ap_boot_state]
+    mov rax, rbx
+    shl rax, 6
+    add r8, rax
+    cmp dword ptr [r8 + 0], 1
+    jne .Lap_ipi_rounds_invalid
+    mov rcx, qword ptr [r8 + 56]
+    lea r11, [rcx + 1]
+    mov edx, dword ptr [r8 + 8]
+    shl edx, 24
+    mov dword ptr [r15 + 0x310], edx
+    mov dword ptr [r15 + 0x300], 0x000000F1
+    rdtsc
+    shl rdx, 32
+    or rax, rdx
+    mov rsi, rax
+.Lap_ipi_round_wait:
+    cmp qword ptr [r8 + 56], r11
+    je .Lap_ipi_round_ack
+    pause
+    rdtsc
+    shl rdx, 32
+    or rax, rdx
+    sub rax, rsi
+    cmp rax, r14
+    jb .Lap_ipi_round_wait
+    mov eax, -1
+    jmp .Lap_ipi_rounds_return
+.Lap_ipi_round_ack:
+    inc r9
+    inc rbx
+    jmp .Lap_ipi_round_cpu_loop
+.Lap_ipi_round_next:
+    inc r10
+    jmp .Lap_ipi_round_loop
+.Lap_ipi_rounds_success:
+    mov eax, r9d
+    jmp .Lap_ipi_rounds_return
+.Lap_ipi_rounds_invalid:
+    mov eax, -2
+.Lap_ipi_rounds_return:
+    pop r15
+    pop r14
+    pop r13
+    pop r12
+    pop rbx
+    ret
+
+
 // int _native_x64_run_ap_work_test(uint64_t cpuCount,
 //                                  uint64_t timeoutTscTicks)
 // Publishes one bounded native work command to each dense AP CpuId and waits
