@@ -248,4 +252,47 @@ internal static unsafe partial class SmpApBootstrap
         Serial.WriteString("[APIC-TEST] PASS\n");
         return true;
     }
+
+    internal static bool RunApplicationProcessorIpiRendezvousProof()
+    {
+        const ulong ExtraRounds = 3;
+        LimineMpResponseX64* response = LimineMp.X64Response;
+        if (response == null || response->Cpus == null || response->CpuCount == 0 ||
+            response->CpuCount > LimineMp.MaxXApicCpuCount)
+        {
+            Serial.WriteString("[SMP] WARNING: repeated fixed IPI rendezvous has no valid CPU topology.\n");
+            return false;
+        }
+
+        long frequency = X64CpuOps.TscFrequency;
+        ulong timeoutTicks = frequency > 0 ? checked((ulong)frequency * ApReadyTimeoutSeconds) : 5_000_000_000UL;
+        int expected = checked((int)((response->CpuCount - 1) * ExtraRounds));
+        int acknowledged = NativeRunApIpiRounds(response->CpuCount, ExtraRounds, timeoutTicks);
+        if (acknowledged != expected)
+        {
+            Serial.WriteString("[SMP] WARNING: repeated fixed IPI rendezvous timed out or rejected state.\n");
+            return false;
+        }
+
+        ulong expectedCount = 1 + ExtraRounds;
+        for (uint cpuId = 1; cpuId < response->CpuCount; cpuId++)
+        {
+            ulong count = NativeGetIpiCount(cpuId);
+            if (count != expectedCount)
+            {
+                Serial.WriteString("[SMP] WARNING: repeated fixed IPI count mismatch for CpuId=");
+                Serial.WriteNumber(cpuId);
+                Serial.WriteString("\n");
+                return false;
+            }
+            Serial.WriteString("[APIC-RUN] CPU ");
+            Serial.WriteNumber(cpuId);
+            Serial.WriteString(" repeated fixed IPI total count=");
+            Serial.WriteNumber(count);
+            Serial.WriteString("\n");
+        }
+
+        Serial.WriteString("[APIC-RUN-TEST] PASS\n");
+        return true;
+    }
 }
