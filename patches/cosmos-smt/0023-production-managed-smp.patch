     private static void OnTimerInterruptCore(uint cpuId, nuint currentRsp, ulong elapsedNs)
     {
+        RecordCpuAccounting(cpuId);
         s_tickCount++;
 
         // Recorded before the early returns below, so the period is readable
@@ -3510,9 +3512,28 @@ public static partial class SchedulerManager
             !ReferenceEquals(state.CurrentThread, state.IdleThread) &&
                 state.CurrentThread.State == SchedulerThreadState.Running);
 
+        SchedulerThread currentThread = state.CurrentThread;
+        if ((currentThread.Flags & SchedulerThreadFlags.Managed) != 0 &&
+            !currentThread.ManagedPreemptionEnabled)
+        {
