+            return;
+        }
+
         // Check and wake up sleeping threads whose timeout has expired
         CheckSleepingThreads(cpuId, elapsedNs);
 
+        // A runnable production managed thread must not be switched to the
+        // native AP idle context when there is no alternative runnable work.
+        // That context returns to the park loop and disarms the AP timer, so
