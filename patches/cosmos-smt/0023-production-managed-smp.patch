diff --git a/src/Cosmos.Kernel.Core/Scheduler/SchedulerManager.SmpProduction.cs b/src/Cosmos.Kernel.Core/Scheduler/SchedulerManager.SmpProduction.cs
new file mode 100644
--- /dev/null
+++ b/src/Cosmos.Kernel.Core/Scheduler/SchedulerManager.SmpProduction.cs
@@ -0,0 +1,286 @@
+using System;
+using System.Diagnostics;
+using System.Threading;
+using Cosmos.Kernel.Core.CPU;
+using Cosmos.Kernel.Core.IO;
+using SysThread = System.Threading.Thread;
+
+namespace Cosmos.Kernel.Core.Scheduler;
+
+public static partial class SchedulerManager
+{
+    private static int s_managedPlacementTicket;
+    private static int s_stage23StartedWorkers;
+    private static int s_stage23CompletedWorkers;
+    private static int s_stage23ReleaseWorkers;
+    private static int s_stage23Failure;
+    private static int s_stage23FailureCpu;
+    private static int s_stage23FailureHit;
+    private static int[]? s_stage23CpuHits;
+
+    private const ulong Stage23TimeoutSeconds = 30;
+
+    /// <summary>
+    /// Selects and reserves a parked AP for a new ordinary managed thread.
+    /// Remote Stride run queues are only mutated while their owner is in the
+    /// native parked loop. CPU0 remains the safe fallback when every AP is busy.
+    /// </summary>
+    internal static uint SelectManagedThreadCpu()
+    {
+#if ARCH_X64
+        uint cpuCount = s_cpuCount;
+        if (cpuCount <= 1 || s_cpuStates is null)
+        {
+            return 0;
+        }
+
+        uint ticket = unchecked((uint)Interlocked.Increment(ref s_managedPlacementTicket));
+        for (uint offset = 0; offset < cpuCount - 1; offset++)
+        {
+            uint candidate = 1 + ((ticket - 1 + offset) % (cpuCount - 1));
+            PerCpuState state = s_cpuStates[candidate];
+
+            if (NativeGetApplicationProcessorCommand(candidate) != 0 ||
+                NativeGetApplicationProcessorCompletion(candidate) != 1 ||
+                !state.TryReserveManagedDispatch())
+            {
+                continue;
+            }
+
+            // Close the race between mailbox observation and the managed CAS.
+            if (NativeGetApplicationProcessorCommand(candidate) == 0 &&
+                NativeGetApplicationProcessorCompletion(candidate) == 1)
+            {
+                return candidate;
+            }
+
+            state.ReleaseManagedDispatchReservation();
+        }
+#endif
+        return 0;
+    }
+
+    /// <summary>
+    /// Wakes a reserved parked AP after its managed thread has been queued.
+    /// </summary>
+    internal static bool ActivateManagedThreadCpu(uint cpuId)
+    {
+        if (cpuId == 0)
+        {
+            return true;
+        }
+
+#if ARCH_X64
+        if (s_cpuStates is null || cpuId >= s_cpuCount)
+        {
+            return false;
+        }
+
+        bool activated = NativeBeginSchedulerCpu(cpuId) == 1;
+        s_cpuStates[cpuId].ReleaseManagedDispatchReservation();
+        return activated;
+#else
+        return false;
+#endif
+    }
+
+    /// <summary>
+    /// Arms the periodic scheduler timer once CoreLib has entered the actual
+    /// ZonderqOS process/delegate body. CPU0 already owns the platform timer.
+    /// </summary>
+    internal static void EnableCurrentCpuManagedPreemption()
+    {
+#if ARCH_X64
+        if (GetCurrentCpuId() == 0)
+        {
+            return;
+        }
+
+        using (InternalCpu.DisableInterruptsScope())
+        {
+            if (NativeArmSchedulerTimer() != 1)
+            {
+                Cosmos.Kernel.Core.Panic.Halt("Production AP scheduler timer could not be armed.");
+            }
+        }
+#endif
+    }
+
+    /// <summary>
+    /// Production-path proof: ordinary System.Threading.Thread instances must
+    /// execute on every AP, enter through normal CoreLib startup/exit, and
+    /// restore the registry and native AP park state afterwards.
+    /// </summary>
+    internal static bool RunManagedThreadDistributionProof()
+    {
+        if (!s_enabled || s_currentScheduler is null || s_cpuStates is null || s_cpuCount == 0)
+        {
+            return false;
+        }
+
+#if ARCH_X64
+        int initialThreadCount = ThreadCount;
+        int workerCount = checked((int)s_cpuCount - 1);
+        int[] cpuHits = new int[checked((int)s_cpuCount)];
+        s_stage23CpuHits = cpuHits;
+        cpuHits[0] = 1;
+
+        Volatile.Write(ref s_managedPlacementTicket, 0);
+        Volatile.Write(ref s_stage23StartedWorkers, 0);
+        Volatile.Write(ref s_stage23CompletedWorkers, 0);
+        Volatile.Write(ref s_stage23ReleaseWorkers, 0);
+        Volatile.Write(ref s_stage23Failure, 0);
+        Volatile.Write(ref s_stage23FailureCpu, -1);
+        Volatile.Write(ref s_stage23FailureHit, -1);
+
+        for (int index = 0; index < workerCount; index++)
+        {
+            SysThread worker = new(Stage23ManagedWorker);
+            worker.Start();
+        }
+
+        long frequency = Stopwatch.Frequency;
+        ulong timeoutTicks = frequency > 0
+            ? checked((ulong)frequency * Stage23TimeoutSeconds)
+            : 30_000_000_000UL;
+        ulong start = (ulong)Stopwatch.GetTimestamp();
+
+        while (Volatile.Read(ref s_stage23StartedWorkers) != workerCount)
+        {
+            if (Volatile.Read(ref s_stage23Failure) != 0 ||
+                (ulong)Stopwatch.GetTimestamp() - start >= timeoutTicks)
+            {
+                Volatile.Write(ref s_stage23ReleaseWorkers, 1);
+                WriteStage23FailureDiagnostics("start");
+                return false;
+            }
+            SysThread.SpinWait(64);
+        }
+
+        Volatile.Write(ref s_stage23ReleaseWorkers, 1);
+        start = (ulong)Stopwatch.GetTimestamp();
+        while (Volatile.Read(ref s_stage23CompletedWorkers) != workerCount ||
+            ThreadCount != initialThreadCount)
+        {
+            if (Volatile.Read(ref s_stage23Failure) != 0 ||
+                (ulong)Stopwatch.GetTimestamp() - start >= timeoutTicks)
+            {
+                WriteStage23FailureDiagnostics("completion");
+                return false;
+            }
+            SysThread.SpinWait(64);
+        }
+
+        int expectedParkedAps = checked((int)s_cpuCount - 1);
+        int parkedAps = expectedParkedAps == 0
+            ? 0
+            : NativeWaitConcurrentSchedulerTest(s_cpuCount, timeoutTicks);
+        if (parkedAps != expectedParkedAps)
+        {
+            Volatile.Write(ref s_stage23FailureCpu, parkedAps);
+            Volatile.Write(ref s_stage23FailureHit, expectedParkedAps);
+            Volatile.Write(ref s_stage23Failure, 3);
+            WriteStage23FailureDiagnostics("parked");
+            return false;
+        }
+
+        int uniqueCpus = 0;
+        ulong cpuMask = 0;
+        for (uint cpuId = 0; cpuId < s_cpuCount; cpuId++)
+        {
+            if (cpuHits[checked((int)cpuId)] != 1)
+            {
+                Volatile.Write(ref s_stage23FailureCpu, checked((int)cpuId));
+                Volatile.Write(ref s_stage23FailureHit, cpuHits[checked((int)cpuId)]);
+                Volatile.Write(ref s_stage23Failure, 4);
+                WriteStage23FailureDiagnostics("hits");
+                return false;
+            }
+
+            uniqueCpus++;
+            if (cpuId < 64)
+            {
+                cpuMask |= 1UL << checked((int)cpuId);
+            }
+        }
+
+        Serial.WriteString("[SCHED-PRODUCTION-SMP] workers=");
+        Serial.WriteNumber((ulong)(uint)workerCount);
+        Serial.WriteString(" unique-cpus=");
+        Serial.WriteNumber((ulong)(uint)uniqueCpus);
+        Serial.WriteString(" cpu-mask=");
+        Serial.WriteHexWithPrefix(cpuMask);
+        Serial.WriteString(" registry=restored aps=parked\n");
+        s_stage23CpuHits = null;
+#else
+        Serial.WriteString("[SCHED-PRODUCTION-SMP] workers=0 unique-cpus=1 cpu-mask=0x1 registry=restored aps=parked\n");
+#endif
+        Serial.WriteString("[SCHED-PRODUCTION-SMP-TEST] PASS\n");
+        return true;
+    }
+
+    private static void WriteStage23FailureDiagnostics(string phase)
+    {
+        Serial.WriteString("[SCHED-PRODUCTION-SMP-CHECK] phase=");
+        Serial.WriteString(phase);
+        Serial.WriteString(" started=");
+        Serial.WriteNumber((ulong)(uint)Volatile.Read(ref s_stage23StartedWorkers));
+        Serial.WriteString(" completed=");
+        Serial.WriteNumber((ulong)(uint)Volatile.Read(ref s_stage23CompletedWorkers));
+        Serial.WriteString(" failure=");
+        Serial.WriteNumber((ulong)(uint)Volatile.Read(ref s_stage23Failure));
+        Serial.WriteString(" cpu=");
+        Serial.WriteNumber((ulong)(uint)Volatile.Read(ref s_stage23FailureCpu));
+        Serial.WriteString(" hit=");
+        Serial.WriteNumber((ulong)(uint)Volatile.Read(ref s_stage23FailureHit));
+        Serial.WriteString(" hits=");
+        int[]? hits = s_stage23CpuHits;
+        if (hits is not null)
+        {
+            for (int index = 0; index < hits.Length; index++)
+            {
+                if (index != 0)
+                {
+                    Serial.WriteString(",");
+                }
+                Serial.WriteNumber((ulong)(uint)Volatile.Read(ref hits[index]));
+            }
+        }
+        Serial.WriteString("\n");
+    }
+
+    private static void Stage23ManagedWorker()
+    {
+        // We are now inside the real ThreadStart delegate, so CoreLib has
+        // completed its startup handshake and AP preemption is safe to arm.
+        EnableCurrentCpuManagedPreemption();
+
+        int[]? hits = s_stage23CpuHits;
+        uint cpuId = GetCurrentCpuId();
+        if (hits is null || cpuId >= checked((uint)hits.Length))
+        {
+            Volatile.Write(ref s_stage23FailureCpu, checked((int)cpuId));
+            Volatile.Write(ref s_stage23FailureHit, -1);
+            Volatile.Write(ref s_stage23Failure, 1);
+            return;
+        }
+
+        int hit = Interlocked.Increment(ref hits[checked((int)cpuId)]);
+        if (hit != 1)
+        {
+            Volatile.Write(ref s_stage23FailureCpu, checked((int)cpuId));
+            Volatile.Write(ref s_stage23FailureHit, hit);
+            Volatile.Write(ref s_stage23Failure, 2);
+            return;
+        }
+
+        Interlocked.Increment(ref s_stage23StartedWorkers);
+        while (Volatile.Read(ref s_stage23ReleaseWorkers) == 0 &&
+            Volatile.Read(ref s_stage23Failure) == 0)
+        {
+            SysThread.SpinWait(64);
+        }
+
+        Interlocked.Increment(ref s_stage23CompletedWorkers);
+    }
+}
diff --git a/src/Cosmos.Kernel.Core/Runtime/Thread.cs b/src/Cosmos.Kernel.Core/Runtime/Thread.cs
--- a/src/Cosmos.Kernel.Core/Runtime/Thread.cs
+++ b/src/Cosmos.Kernel.Core/Runtime/Thread.cs
@@ -96,5 +96,23 @@ internal class Thread
     // tested against every historical SMT prefix.
     [RuntimeExport("RhEnableCurrentCpuManagedPreemption")]
-    internal static void RhEnableCurrentCpuManagedPreemption() { }
+    internal static void RhEnableCurrentCpuManagedPreemption()
+    {
+        SchedulerManager.EnableCurrentCpuManagedPreemption();
+    }
+
+    /// <summary>
+    /// CoreLib registers inlined thread-static roots with the native runtime
+    /// during its startup handshake. Cosmos keeps the backing object graph on
+    /// <see cref="SchedulerThread"/>, which is already rooted and scanned by
+    /// OrionGC, so no additional native ThreadStore registration is required.
+    /// Providing this managed runtime export also keeps a fresh scheduler
+    /// thread from entering NativeAOT's unattached native-thread path.
+    /// </summary>
+    [RuntimeExport("RhRegisterInlinedThreadStaticRoot")]
+    internal static void RhRegisterInlinedThreadStaticRoot(ref object? root, IntPtr module)
+    {
+        _ = root;
+        _ = module;
+    }
 
     [RuntimeExport("RhYield")]
