+
+    /// <summary>
+    /// Installs a raw receive handler on the primary adapter. This is intended
+    /// for pre-IP bring-up and diagnostics; configuring the normal network
+    /// stack replaces this handler with its protocol dispatcher.
+    /// </summary>
+    /// <param name="handler">Callback invoked by the NIC for each received Ethernet frame.</param>
+    /// <returns>True when a primary device exists and the handler was installed.</returns>
+    public static bool SetRawReceiveHandler(Action<byte[], int> handler)
+    {
+        if (!IsEnabled || PrimaryDevice is null || handler is null)
+        {
+            return false;
+        }
+
+        PrimaryDevice.OnPacketReceived = (data, length) => handler(data, length);
+        return true;
+    }
 }
