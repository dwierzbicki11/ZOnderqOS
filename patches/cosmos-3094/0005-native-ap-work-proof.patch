+    mov eax, -2
+    jmp .Lsmp5_return
+.Lsmp5_success:
+    mov eax, r14d
+.Lsmp5_return:
+    pop r15
+    pop r14
+    pop r13
+    pop r12
+    pop rbx
+    ret
 
