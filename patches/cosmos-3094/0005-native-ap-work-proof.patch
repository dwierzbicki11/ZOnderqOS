+    cmp dword ptr [r8 + 32], 0
+    jne .Lsmp5_invalid
+    cmp qword ptr [r8 + 40], 0
+    jne .Lsmp5_invalid
+    cmp dword ptr [r8 + 48], 0
+    jne .Lsmp5_invalid
+    inc rbx
+    jmp .Lsmp5_preflight
+.Lsmp5_publish:
+    mov ebx, 1
+.Lsmp5_publish_loop:
+    cmp rbx, r12
+    jae .Lsmp5_published
+    lea r8, [rip + _smp3094_ap_boot_state]
+    mov rax, rbx
+    shl rax, 6
+    add r8, rax
+    mov eax, 1
+    xchg dword ptr [r8 + 32], eax
+    inc rbx
+    jmp .Lsmp5_publish_loop
+.Lsmp5_published:
+    rdtsc
+    shl rdx, 32
+    or rax, rdx
+    mov r15, rax
+.Lsmp5_poll:
+    xor r11d, r11d
+    mov ebx, 1
+.Lsmp5_count:
+    cmp rbx, r12
+    jae .Lsmp5_counted
+    lea r8, [rip + _smp3094_ap_boot_state]
+    mov rax, rbx
+    shl rax, 6
+    add r8, rax
+    cmp dword ptr [r8 + 48], 1
+    jne .Lsmp5_next
+    inc r11d
+.Lsmp5_next:
+    inc rbx
+    jmp .Lsmp5_count
+.Lsmp5_counted:
+    cmp r11, r14
+    je .Lsmp5_success
+    pause
