+// Native AP work command: rdi = count, rsi = TSC timeout delta.
+// Two-phase preflight prevents partial mailbox activation.
+.global _native_x64_run_ap_work_test
+_native_x64_run_ap_work_test:
+    push rbx
+    push r12
+    push r13
+    push r14
+    push r15
+    test rdi, rdi
+    jz .Lsmp5_invalid
+    cmp rdi, 256
+    ja .Lsmp5_invalid
+    test rsi, rsi
+    jz .Lsmp5_invalid
+    mov r12, rdi
+    mov r13, rsi
+    lea r14, [r12 - 1]
+    mov ebx, 1
+.Lsmp5_preflight:
+    cmp rbx, r12
+    jae .Lsmp5_publish
+    lea r8, [rip + _smp3094_ap_boot_state]
+    mov rax, rbx
+    shl rax, 6
+    add r8, rax
+    cmp dword ptr [r8 + 0], 1
