+    [LibraryImport("*", EntryPoint = "_native_x64_prepare_ap_ipi")]
+    [SuppressGCTransition]
+    private static partial int NativePrepareIpi(ulong localApicBase);
+
+    [LibraryImport("*", EntryPoint = "_native_x64_run_ap_ipi_test")]
+    [SuppressGCTransition]
+    private static partial int NativeRunIpiTest(
+        LimineMpInfoX64** descriptors, ulong count, ulong timeoutTicks);
+
+    [LibraryImport("*", EntryPoint = "_native_x64_get_ap_ipi_count")]
+    [SuppressGCTransition]
+    private static partial ulong NativeGetIpiCount(uint cpuId);
+
+    internal static bool StartAndParkApplicationProcessors()
+    {
+        if (!LimineMp.TryAssignDenseX64CpuIds(out ulong cpuCount) ||
+            cpuCount == 0 || cpuCount > LimineMp.MaxXApicCpuCount ||
+            !CpuLocal.ValidateApStacks((uint)cpuCount))
+        {
+            Serial.WriteString("[SMP3094] Invalid topology or AP stack reservation.\n");
+            return false;
+        }
+
+        LimineMpResponseX64* response = (LimineMpResponseX64*)Limine.MP.Response;
+        long frequency = X64CpuOps.TscFrequency;
+        ulong deadlineTicks = frequency > 0 &&
+            (ulong)frequency <= ulong.MaxValue / ReadyTimeoutSeconds
+            ? (ulong)frequency * ReadyTimeoutSeconds
+            : 5_000_000_000UL;
+
+        // Construct the AP-only IDT before releasing CPUs from Limine.
+        // Native APs never execute Cosmos managed interrupt dispatch.
+        if (!LocalApic.IsInitialized || NativePrepareIpi(LocalApic.BaseAddress) != 1)
+        {
+            Serial.WriteString("[SMP3094] Stage 6 native IPI IDT preparation failed.\n");
+            return false;
+        }
+
+        // AP code runs only native instructions, with interrupts disabled.
+        // A single shared deadline bounds waiting for all APs.
+        int started = NativeStartAps(response->Cpus, cpuCount, deadlineTicks);
+        int expected = checked((int)cpuCount - 1);
+        if (started != expected)
+        {
+            Serial.WriteString("[SMP3094] AP startup failed or READY timeout.\n");
+            return false;
+        }
+
+        for (ulong tableIndex = 0; tableIndex < cpuCount; tableIndex++)
+        {
+            LimineMpInfoX64* desc = response->Cpus[tableIndex];
+            uint id = checked((uint)desc->ExtraArgument);
+            if (id == 0)
+            {
+                if (desc->LapicId != response->BspLapicId)
+                {
+                    return false;
+                }
+
+                continue;
+            }
+
+            ulong stack = NativeGetStack(id);
+            if (NativeGetReady(id) != 1 ||
+                NativeGetLapicId(id) != desc->LapicId ||
+                NativeGetGsId(id) != id ||
+                stack == 0 || (stack & 15UL) != 0 ||
+                (NativeGetRflags(id) & (1UL << 9)) != 0)
+            {
+                Serial.WriteString("[SMP3094] AP bootstrap validation failed: CpuId=");
+                Serial.WriteNumber(id);
+                Serial.WriteString("\n");
+                return false;
+            }
+
+            Serial.WriteString("[SMP3094] AP READY CpuId=");
+            Serial.WriteNumber(id);
+            Serial.WriteString(" LAPIC=");
+            Serial.WriteNumber(desc->LapicId);
+            Serial.WriteString("\n");
+        }
+
+        Serial.WriteString("[SMP3094] Stage 4 complete: ");
+        Serial.WriteNumber((ulong)expected);
+        Serial.WriteString(" native APs ready and parked; no AP scheduler or GC.\n");
+        Serial.WriteString("[SMP3094-STAGE4] PASS\n");
+        return true;
+    }
+
+    /// <summary>Proves that each AP performs native work after READY.</summary>
+    internal static bool RunNativeWorkProof()
+    {
+        const ulong ExpectedCounter = 100_000UL;
+        if (!LimineMp.TryValidateX64(out ulong count, out _) ||
+            count == 0 || count > LimineMp.MaxXApicCpuCount)
+        {
+            return false;
+        }
+
+        long frequency = X64CpuOps.TscFrequency;
+        ulong timeoutTicks = frequency > 0 &&
+            (ulong)frequency <= ulong.MaxValue / ReadyTimeoutSeconds
+            ? (ulong)frequency * ReadyTimeoutSeconds
+            : 5_000_000_000UL;
+
+        int completed = NativeRunApWorkTest(count, timeoutTicks);
+        if (completed != (int)count - 1)
+        {
+            Serial.WriteString("[SMP3094] Stage 5 AP native work timed out.\n");
+            return false;
+        }
+
+        for (uint id = 1; id < count; id++)
+        {
+            ulong actual = NativeGetWorkCounter(id);
+            if (actual != ExpectedCounter)
+            {
+                Serial.WriteString("[SMP3094] Invalid native work counter for CPU ");
+                Serial.WriteNumber(id);
+                Serial.WriteString("\n");
+                return false;
+            }
+
+            Serial.WriteString("[SMP3094-WORK] CPU=");
+            Serial.WriteNumber(id);
+            Serial.WriteString(" counter=");
+            Serial.WriteNumber(actual);
+            Serial.WriteString("\n");
+        }
+
+        Serial.WriteString("[SMP3094-STAGE5] PASS\n");
+        return true;
+    }
+
+    /// <summary>
+    /// Check one real fixed-delivery Local APIC IPI per secondary processor.
+    /// The native dispatcher uses each Limine descriptor's physical LAPIC ID,
+    /// not its dense scheduler CPU ID.
+    /// </summary>
+    internal static bool RunNativeIpiProof()
+    {
+        if (!LimineMp.TryValidateX64(out ulong count, out _) ||
+            count == 0 || count > LimineMp.MaxXApicCpuCount)
+        {
+            return false;
+        }
+
+        LimineMpResponseX64* response = (LimineMpResponseX64*)Limine.MP.Response;
+        long frequency = X64CpuOps.TscFrequency;
+        ulong timeoutTicks = frequency > 0 &&
+            (ulong)frequency <= ulong.MaxValue / ReadyTimeoutSeconds
+            ? (ulong)frequency * ReadyTimeoutSeconds
+            : 5_000_000_000UL;
+
+        int received = NativeRunIpiTest(response->Cpus, count, timeoutTicks);
+        if (received != (int)count - 1)
+        {
+            Serial.WriteString("[SMP3094] Stage 6 IPI timeout or AP IDT failure.\n");
+            return false;
+        }
+
+        for (ulong i = 0; i < count; i++)
+        {
+            LimineMpInfoX64* cpu = response->Cpus[i];
+            uint cpuId = (uint)cpu->ExtraArgument;
+            if (cpuId == 0)
+            {
+                continue;
+            }
+
+            ulong observed = NativeGetIpiCount(cpuId);
+            if (observed != 1UL)
+            {
+                Serial.WriteString("[SMP3094] Stage 6 wrong IPI count for CPU ");
+                Serial.WriteNumber(cpuId);
+                Serial.WriteString("\n");
+                return false;
+            }
+
+            Serial.WriteString("[SMP3094-IPI] CPU=");
+            Serial.WriteNumber(cpuId);
+            Serial.WriteString(" LAPIC=");
+            Serial.WriteNumber(cpu->LapicId);
+            Serial.WriteString(" count=");
+            Serial.WriteNumber(observed);
+            Serial.WriteString("\n");
+        }
+
+        Serial.WriteString("[SMP3094-STAGE6] PASS\n");
         return true;
     }
 }
