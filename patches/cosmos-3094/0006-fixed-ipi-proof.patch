+.Lsmp4_poll_loop:
+    cmp rbx, r13
+    jae .Lsmp4_poll_end
+    mov r8, qword ptr [r12 + rbx * 8]
+    mov rcx, qword ptr [r8 + 24]
+    test rcx, rcx
+    jz .Lsmp4_poll_next
+    lea r9, [rip + _smp3094_ap_boot_state]
+    shl rcx, 6
+    add r9, rcx
+    cmp dword ptr [r9 + 0], 1
+    jne .Lsmp4_poll_next
+    inc r11d
+.Lsmp4_poll_next:
+    inc rbx
+    jmp .Lsmp4_poll_loop
+
+.Lsmp4_poll_end:
+    cmp r11d, r15d
+    je .Lsmp4_success
+    pause
+    rdtsc
+    shl rdx, 32
+    or rax, rdx
+    sub rax, r10
+    cmp rax, r14
+    jb .Lsmp4_poll
+    mov eax, -1
+    jmp .Lsmp4_return
+
+.Lsmp4_invalid:
+    mov eax, -2
+    jmp .Lsmp4_return
+.Lsmp4_success:
+    mov eax, r15d
+.Lsmp4_return:
+    pop r15
+    pop r14
+    pop r13
+    pop r12
+    pop rbx
+    ret
+
+// Limine enters with RDI = LimineMpInfoX64*.
+// No C#/GC/TLS/IRQ on the AP; its private stack is installed first.
+.global _native_x64_ap_entry
+_native_x64_ap_entry:
+    cli
+    cld
+    mov r12, rdi
+    test r12, r12
+    jz .Lsmp4_park
+    mov r13, qword ptr [r12 + 24]
+    test r13, r13
+    jz .Lsmp4_park
+    cmp r13, 255
+    ja .Lsmp4_park
+
+    // Stage 3 reserved top = base + CpuId*16384 + 16384.
+    lea rsp, [rip + _smp3094_ap_stacks]
+    mov rax, r13
+    shl rax, 14
+    add rsp, rax
+    add rsp, 16384
+    and rsp, -16
+
+    mov edi, r13d
+    call _native_x64_init_percpu
+
+    lea r14, [rip + _smp3094_ap_boot_state]
+    mov rax, r13
+    shl rax, 6
+    add r14, rax
+
+    mov eax, 1
+    cpuid
+    shr ebx, 24
+    mov dword ptr [r14 + 4], r13d
+    mov dword ptr [r14 + 8], ebx
+    mov eax, dword ptr gs:[0]
+    mov dword ptr [r14 + 12], eax
+    mov qword ptr [r14 + 16], rsp
+    pushfq
+    pop rax
+    mov qword ptr [r14 + 24], rax
+
+    // Publish READY with full memory barrier; BSP reads state afterwards.
+    mfence
+    mov eax, 1
+    xchg dword ptr [r14 + 0], eax
+
+// Wait for BSP mailbox command 1, run 100000 increments, publish DONE.
+// Busy wait is bounded by BSP's stage-5 timeout, not a production AP idle path.
+.Lsmp5_wait:
+    pause
+    cmp dword ptr [r14 + 32], 1
+    jne .Lsmp5_wait
+    mov r15d, 100000
+.Lsmp5_work_loop:
+    lock inc qword ptr [r14 + 40]
+    dec r15d
+    jne .Lsmp5_work_loop
+    mfence
+    mov eax, 1
+    xchg dword ptr [r14 + 48], eax
+
+    // Only after Stage 5: install the AP-only IDT and arm Local APIC.
+    // Publish ARMED after all hardware stores, before enabling interrupts.
+    call _smp6_arm_ap_ipi
+    mfence
+    mov eax, 1
+    xchg dword ptr [r14 + 52], eax
+
+.Lsmp4_park:
+    // STI;HLT defers interrupt delivery until HLT is entered, avoiding
+    // the classic lost-wakeup race. No managed handlers run on APs.
+    sti
+    hlt
+    jmp .Lsmp4_park
+
+.macro SMP4_STATE_GETTER name, offset, width
+.global \name
+\name:
+    cmp edi, 255
+    ja .Lsmp4_bad_get_\@
+    lea rcx, [rip + _smp3094_ap_boot_state]
+    mov eax, edi
+    shl rax, 6
+    add rcx, rax
+    .if \width == 4
+        mov eax, dword ptr [rcx + \offset]
+    .else
+        mov rax, qword ptr [rcx + \offset]
+    .endif
+    ret
+.Lsmp4_bad_get_\@:
+    xor eax, eax
+    ret
+.endm
+
+SMP4_STATE_GETTER _native_x64_get_ap_ready, 0, 4
+SMP4_STATE_GETTER _native_x64_get_ap_lapic_id, 8, 4
+SMP4_STATE_GETTER _native_x64_get_ap_gs_id, 12, 4
+SMP4_STATE_GETTER _native_x64_get_ap_stack, 16, 8
+SMP4_STATE_GETTER _native_x64_get_ap_rflags, 24, 8
+SMP4_STATE_GETTER _native_x64_get_ap_work_counter, 40, 8
+
+// Native AP work command: rdi = count, rsi = TSC timeout delta.
+// Two-phase preflight prevents partial mailbox activation.
+.global _native_x64_run_ap_work_test
+_native_x64_run_ap_work_test:
+    push rbx
+    push r12
+    push r13
+    push r14
+    push r15
+    test rdi, rdi
+    jz .Lsmp5_invalid
+    cmp rdi, 256
+    ja .Lsmp5_invalid
+    test rsi, rsi
+    jz .Lsmp5_invalid
+    mov r12, rdi
+    mov r13, rsi
+    lea r14, [r12 - 1]
+    mov ebx, 1
+.Lsmp5_preflight:
+    cmp rbx, r12
+    jae .Lsmp5_publish
+    lea r8, [rip + _smp3094_ap_boot_state]
+    mov rax, rbx
+    shl rax, 6
+    add r8, rax
+    cmp dword ptr [r8 + 0], 1
+    jne .Lsmp5_invalid
+    cmp dword ptr [r8 + 32], 0
+    jne .Lsmp5_invalid
+    cmp qword ptr [r8 + 40], 0
+    jne .Lsmp5_invalid
+    cmp dword ptr [r8 + 48], 0
+    jne .Lsmp5_invalid
+    inc rbx
+    jmp .Lsmp5_preflight
+.Lsmp5_publish:
+    mov ebx, 1
+.Lsmp5_publish_loop:
+    cmp rbx, r12
+    jae .Lsmp5_published
+    lea r8, [rip + _smp3094_ap_boot_state]
+    mov rax, rbx
+    shl rax, 6
+    add r8, rax
+    mov eax, 1
+    xchg dword ptr [r8 + 32], eax
+    inc rbx
+    jmp .Lsmp5_publish_loop
+.Lsmp5_published:
+    rdtsc
+    shl rdx, 32
+    or rax, rdx
+    mov r15, rax
+.Lsmp5_poll:
+    xor r11d, r11d
+    mov ebx, 1
+.Lsmp5_count:
+    cmp rbx, r12
+    jae .Lsmp5_counted
+    lea r8, [rip + _smp3094_ap_boot_state]
+    mov rax, rbx
+    shl rax, 6
+    add r8, rax
+    cmp dword ptr [r8 + 48], 1
+    jne .Lsmp5_next
+    inc r11d
+.Lsmp5_next:
+    inc rbx
+    jmp .Lsmp5_count
+.Lsmp5_counted:
+    cmp r11, r14
+    je .Lsmp5_success
+    pause
+    rdtsc
+    shl rdx, 32
+    or rax, rdx
+    sub rax, r15
+    cmp rax, r13
+    jb .Lsmp5_poll
+    mov eax, -1
+    jmp .Lsmp5_return
+.Lsmp5_invalid:
+    mov eax, -2
+    jmp .Lsmp5_return
+.Lsmp5_success:
+    mov eax, r14d
+.Lsmp5_return:
+    pop r15
+    pop r14
+    pop r13
+    pop r12
+    pop rbx
+    ret
+
+// Stage 6: only the secondary processors load this private IDT.
+// Build it once on BSP before the Limine AP entry pointers are published.
+// Returns 1 if LAPIC base is nonzero, aligned and in legacy xAPIC space.
+.global _native_x64_prepare_ap_ipi
+_native_x64_prepare_ap_ipi:
+    test rdi, rdi
+    jz .Lsmp6_prep_bad
+    test rdi, 4095
+    jnz .Lsmp6_prep_bad
+    mov rax, rdi
+    shr rax, 32
+    test rax, rax
+    jnz .Lsmp6_prep_bad
+    mov qword ptr [rip + _smp6_lapic_base], rdi
+
+    lea rax, [rip + _smp6_ap_idt]
+    lea rdx, [rip + _smp6_ap_idtr]
+    mov word ptr [rdx], 4095
+    mov qword ptr [rdx + 2], rax
+
+    mov edi, 241
+    lea rsi, [rip + _smp6_ap_ipi_handler]
+    call _smp6_set_gate
+    mov edi, 255
+    lea rsi, [rip + _smp6_ap_spurious_handler]
+    call _smp6_set_gate
+    mov eax, 1
+    ret
+.Lsmp6_prep_bad:
+    xor eax, eax
+    ret
+
+// edi = vector, rsi = handler virtual address. BSP only, before AP release.
+_smp6_set_gate:
+    lea rcx, [rip + _smp6_ap_idt]
+    mov eax, edi
+    shl rax, 4
+    add rcx, rax
+    mov word ptr [rcx + 0], si
+    mov ax, cs
+    mov word ptr [rcx + 2], ax
+    mov byte ptr [rcx + 4], 0
+    mov byte ptr [rcx + 5], 0x8E
+    mov rax, rsi
+    shr rax, 16
+    mov word ptr [rcx + 6], ax
+    shr rax, 16
+    mov dword ptr [rcx + 8], eax
+    mov dword ptr [rcx + 12], 0
+    ret
+
+// AP only. The BSP initialized _smp6_lapic_base and native IDTR.
+// APs never enter managed interrupt handlers before full runtime port.
+_smp6_arm_ap_ipi:
+    lidt [rip + _smp6_ap_idtr]
+    mov ecx, 0x1B
+    rdmsr
+    or eax, 0x800
+    wrmsr
+    mov rax, qword ptr [rip + _smp6_lapic_base]
+    mov dword ptr [rax + 0x80], 0          // TPR: accept fixed interrupts
+    mov dword ptr [rax + 0x320], 0x10000   // mask timer
+    mov dword ptr [rax + 0x350], 0x10000   // mask LINT0
+    mov dword ptr [rax + 0x360], 0x10000   // mask LINT1
+    mov dword ptr [rax + 0x370], 0x10000   // mask error
+    mov dword ptr [rax + 0xF0], 0x1FF      // enable LAPIC, vector FF
+    ret
+
+// Real interrupt handler: GS points to the current AP's cache line.
+// Preserve clobbered registers, acknowledge LAPIC and return with IRETQ.
+// All other interrupt vectors remain disabled / unconfigured at Stage 6.
+.global _smp6_ap_ipi_handler
+_smp6_ap_ipi_handler:
+    push rax
+    push rdx
+    mov eax, dword ptr gs:[0]
+    cmp eax, 255
+    ja .Lsmp6_handler_eoi
+    lea rdx, [rip + _smp3094_ap_boot_state]
+    shl rax, 6
+    add rdx, rax
+    lock inc qword ptr [rdx + 56]
+.Lsmp6_handler_eoi:
+    mov rax, qword ptr [rip + _smp6_lapic_base]
+    mov dword ptr [rax + 0xB0], 0
+    pop rdx
+    pop rax
+    iretq
+
+// A spurious APIC interrupt must NOT issue EOI.
+.global _smp6_ap_spurious_handler
+_smp6_ap_spurious_handler:
+    iretq
+
+SMP4_STATE_GETTER _native_x64_get_ap_ipi_count, 56, 8
+
+// IPI proof: rdi descriptor table, rsi CPU count, rdx total TSC deadline.
+// Stage 6 uses physical LAPIC IDs from Limine descriptors, never dense IDs.
+// Returns n-1 on success, -1 timeout, -2 invalid topology/state.
+.global _native_x64_run_ap_ipi_test
+_native_x64_run_ap_ipi_test:
+    push rbx
+    push r12
+    push r13
+    push r14
+    push r15
+    test rdi, rdi
+    jz .Lsmp6_invalid
+    test rsi, rsi
+    jz .Lsmp6_invalid
+    cmp rsi, 256
+    ja .Lsmp6_invalid
+    test rdx, rdx
+    jz .Lsmp6_invalid
+    mov r12, rdi
+    mov r13, rsi
+    mov r14, rdx
+    rdtsc
+    shl rdx, 32
+    or rax, rdx
+    mov r15, rax
+
+// Wait for ALL APs to install their IDTs and LAPIC before sending IPI.
+// The shared deadline applies to the entire preflight + dispatch.
+.Lsmp6_preflight:
+    mov ebx, 0
+.Lsmp6_check:
+    cmp rbx, r13
+    jae .Lsmp6_send_begin
+    mov r8, qword ptr [r12 + rbx * 8]
+    test r8, r8
+    jz .Lsmp6_invalid
+    mov rcx, qword ptr [r8 + 24]  // dense CPU ID
+    cmp rcx, r13
+    jae .Lsmp6_invalid
+    test rcx, rcx
+    jz .Lsmp6_check_next
+    mov eax, dword ptr [r8 + 4]   // physical LAPIC ID
+    cmp eax, 255
+    ja .Lsmp6_invalid
+    lea r9, [rip + _smp3094_ap_boot_state]
+    shl rcx, 6
+    add r9, rcx
+    cmp dword ptr [r9 + 52], 1    // AP's IPI_ARMED bit
+    jne .Lsmp6_not_armed
+    cmp qword ptr [r9 + 56], 0
+    jne .Lsmp6_invalid
+.Lsmp6_check_next:
+    inc rbx
+    jmp .Lsmp6_check
+.Lsmp6_not_armed:
+    pause
+    rdtsc
+    shl rdx, 32
+    or rax, rdx
+    sub rax, r15
+    cmp rax, r14
+    jae .Lsmp6_timeout
+    jmp .Lsmp6_preflight
+
+.Lsmp6_send_begin:
+    mov ebx, 0
+.Lsmp6_send:
+    cmp rbx, r13
+    jae .Lsmp6_success
+    mov r8, qword ptr [r12 + rbx * 8]
+    mov rcx, qword ptr [r8 + 24]
+    test rcx, rcx
+    jz .Lsmp6_send_next
+    lea r10, [rip + _smp3094_ap_boot_state]
+    shl rcx, 6
+    add r10, rcx
+    mov edx, dword ptr [r8 + 4]  // physical LAPIC, not logical CPU ID
+    shl edx, 24
+    mov r9, qword ptr [rip + _smp6_lapic_base]
+    // ICR busy gate: do not overwrite an outstanding delivery command.
+.Lsmp6_icr_idle:
+    mov eax, dword ptr [r9 + 0x300]
+    test eax, 0x1000
+    jz .Lsmp6_icr_send
+    pause
+    rdtsc
+    shl rdx, 32
+    or rax, rdx
+    sub rax, r15
+    cmp rax, r14
+    jae .Lsmp6_timeout
+    jmp .Lsmp6_icr_idle
+.Lsmp6_icr_send:
+    mov edx, dword ptr [r8 + 4]
+    shl edx, 24
+    mov dword ptr [r9 + 0x310], edx
+    mov dword ptr [r9 + 0x300], 0x000000F1
+.Lsmp6_wait_ack:
+    cmp qword ptr [r10 + 56], 1
+    je .Lsmp6_send_next
+    cmp qword ptr [r10 + 56], 1
+    ja .Lsmp6_invalid
+    pause
+    rdtsc
+    shl rdx, 32
+    or rax, rdx
+    sub rax, r15
+    cmp rax, r14
+    jae .Lsmp6_timeout
+    jmp .Lsmp6_wait_ack
+.Lsmp6_send_next:
+    inc rbx
+    jmp .Lsmp6_send
+
+.Lsmp6_success:
+    mov eax, r13d
+    dec eax
+    jmp .Lsmp6_return
+.Lsmp6_timeout:
+    mov eax, -1
+    jmp .Lsmp6_return
+.Lsmp6_invalid:
+    mov eax, -2
+.Lsmp6_return:
+    pop r15
+    pop r14
+    pop r13
+    pop r12
+    pop rbx
+    ret
+
+// void _native_set_context_switch_sp(nuint newSp)
+// Sets the target SP for context switch. Called from managed code
+// during timer interrupt to request a context switch.
+// rdi = new RSP to switch to (pointing to saved context)
+.global _native_set_context_switch_sp
+_native_set_context_switch_sp:
+    mov [rip + _context_switch_target_rsp], rdi
+    ret
+
+// nuint _native_get_context_switch_sp()
+// Gets the current context switch target SP (for debugging)
+.global _native_get_context_switch_sp
+_native_get_context_switch_sp:
+    mov rax, [rip + _context_switch_target_rsp]
+    ret
+
+// nuint _native_get_sp()
+// Gets the current SP value
+.global _native_get_sp
+_native_get_sp:
+    mov rax, rsp
+    ret
+
+// uint64_t _native_x64_get_last_error_code()
+// Returns the error code stashed by the most recent error-code exception
+// stub (vectors 8, 10-14, 17, 21, 29, 30). Only meaningful while handling
+// that exception; a nested error-code exception overwrites it.
+.global _native_x64_get_last_error_code
+_native_x64_get_last_error_code:
+    mov rax, [rip + _irq_last_error_code]
+    ret
+
+// void _native_set_context_switch_new_thread(int isNew)
+// Sets whether the target thread is NEW (1) or RESUMED (0)
+// rdi = isNew flag
+.global _native_set_context_switch_new_thread
+_native_set_context_switch_new_thread:
+    mov [rip + _context_switch_is_new_thread], rdi
+    ret
+
+.bss
+// x64 cacheline-sized identity/context reservation for 256 logical CPUs.
+.balign 64
+_smp3094_cpu_slots: .zero 16384
+
+// 256 AP stacks of 16KiB each; 4MiB zero-initialized BSS.
+// Stacks are not used until a separate AP bootstrap patch is validated.
+.balign 4096
+_smp3094_ap_stacks: .zero 4194304
+
+// 256 cache-line records: READY, logical ID, physical APIC ID,
+// GS identity, stack pointer and interrupt flag observation.
+.balign 64
+_smp3094_ap_boot_state: .zero 16384
+
+// AP-only native interrupt table: fixed IPI vector F1 and spurious FF.
+// Built by the BSP before AP publication and immutable after that.
+.balign 16
+_smp6_ap_idt: .zero 4096
+_smp6_ap_idtr: .zero 10
+.balign 8
+_smp6_lapic_base: .quad 0
 // Per-CPU context switch target RSP (0 = no switch, non-zero = switch to this RSP)
 // For SMP, this would be per-CPU, but for now single-CPU
 .global _context_switch_target_rsp
