+.Lsmp7_wait:
+    mov eax, dword ptr [rsp + 8]
+    inc eax
+    cmp qword ptr [r10 + 56], rax
+    je .Lsmp7_next_ap
+    jb .Lsmp7_pending
+    jmp .Lsmp7_invalid
+.Lsmp7_pending:
+    pause
+    rdtsc
+    shl rdx, 32
+    or rax, rdx
+    sub rax, r15
+    cmp rax, r14
+    jae .Lsmp7_timeout
+    jmp .Lsmp7_wait
+
+.Lsmp7_next_ap:
+    inc rbx
+    jmp .Lsmp7_each_ap
+.Lsmp7_round_complete:
+    inc dword ptr [rsp + 8]
+    jmp .Lsmp7_round_start
+.Lsmp7_success:
+    mov eax, r13d
+    dec eax
+    jmp .Lsmp7_exit
+.Lsmp7_timeout:
+    mov eax, -1
+    jmp .Lsmp7_exit
+.Lsmp7_invalid:
+    mov eax, -2
+.Lsmp7_exit:
+    add rsp, 16
+    pop r15
+    pop r14
+    pop r13
+    pop r12
+    pop rbx
+    ret
+
+// Stage 8: native multi-CPU rendezvous using fixed IPI vector F2.
+// The handler publishes ARRIVED for its generation, waits until the BSP
+// releases ALL APs, sends LAPIC EOI, then publishes EXITED.
+// While inside the handler IF=0, no managed GC or scheduler is entered.
+.global _smp8_ap_rendezvous_handler
+_smp8_ap_rendezvous_handler:
+    push rax
+    push rcx
+    push rdx
+    mov eax, dword ptr gs:[0]
+    test eax, eax
+    jz .Lsmp8_ap_eoi
+    cmp eax, 255
+    ja .Lsmp8_ap_eoi
+    lea rdx, [rip + _smp8_barrier_state]
+    shl rax, 6
+    add rdx, rax
+    mov rcx, qword ptr [rip + _smp8_request_generation]
+    mov rax, qword ptr [rip + _smp8_release_generation]
+    mov qword ptr [rdx + 16], rax
+    lock inc qword ptr [rdx + 24]
+    mov rax, rcx
+    xchg qword ptr [rdx + 0], rax
+.Lsmp8_ap_wait_release:
+    cmp qword ptr [rip + _smp8_release_generation], rcx
+    jae .Lsmp8_ap_release
+    pause
+    jmp .Lsmp8_ap_wait_release
+.Lsmp8_ap_release:
+    mov rax, qword ptr [rip + _smp6_lapic_base]
+    mov dword ptr [rax + 0xB0], 0
+    mov rax, rcx
+    xchg qword ptr [rdx + 8], rax
+    jmp .Lsmp8_ap_return
+.Lsmp8_ap_eoi:
+    mov rax, qword ptr [rip + _smp6_lapic_base]
+    mov dword ptr [rax + 0xB0], 0
+.Lsmp8_ap_return:
+    pop rdx
+    pop rcx
+    pop rax
+    iretq
+
+.macro SMP8_BARRIER_GETTER name, offset
+.global \name
+\name:
+    test edi, edi
+    jz .Lsmp8_get_bad_\@
+    cmp edi, 255
+    ja .Lsmp8_get_bad_\@
+    lea rcx, [rip + _smp8_barrier_state]
+    mov eax, edi
+    shl rax, 6
+    add rcx, rax
+    mov rax, qword ptr [rcx + \offset]
+    ret
+.Lsmp8_get_bad_\@:
+    xor eax, eax
+    ret
+.endm
+
+SMP8_BARRIER_GETTER _native_x64_get_ap_barrier_enter, 0
+SMP8_BARRIER_GETTER _native_x64_get_ap_barrier_exit, 8
+SMP8_BARRIER_GETTER _native_x64_get_ap_barrier_hits, 24
+
+// BSP: rdi=Limine CPU descriptors, rsi=count, rdx=single global TSC
+// deadline, ecx=number of generation rounds (1..16).
+// For each round: preflight all APs, send F2 IPI to physical LAPIC IDs,
+// confirm EVERY AP arrived and its observed release epoch is still prior,
+// release all APs at once, then confirm every AP exited.
+// Return # APs or -1 timeout / -2 corrupt state.
+.global _native_x64_run_ap_rendezvous
+_native_x64_run_ap_rendezvous:
+    push rbx
+    push r12
+    push r13
+    push r14
+    push r15
+    sub rsp, 16
+    test rdi, rdi
+    jz .Lsmp8_invalid
+    test rsi, rsi
+    jz .Lsmp8_invalid
+    cmp rsi, 256
+    ja .Lsmp8_invalid
+    test rdx, rdx
+    jz .Lsmp8_invalid
+    test ecx, ecx
+    jz .Lsmp8_invalid
+    cmp ecx, 16
+    ja .Lsmp8_invalid
+    mov r12, rdi
+    mov r13, rsi
+    mov r14, rdx
+    mov dword ptr [rsp + 8], ecx // total generations
+    mov dword ptr [rsp], 1       // current generation, starts at 1
+    rdtsc
+    shl rdx, 32
+    or rax, rdx
+    mov r15, rax
+
+.Lsmp8_round:
+    mov eax, dword ptr [rsp]
+    cmp eax, dword ptr [rsp + 8]
+    ja .Lsmp8_success
+    mov r10d, eax
+    dec r10
+    cmp qword ptr [rip + _smp8_release_generation], r10
+    jne .Lsmp8_invalid
+
+// Check whole descriptor set BEFORE any IPI is sent in this generation.
+    xor ebx, ebx
+.Lsmp8_preflight:
+    cmp rbx, r13
+    jae .Lsmp8_preflight_done
+    mov r8, qword ptr [r12 + rbx * 8]
+    test r8, r8
+    jz .Lsmp8_invalid
+    mov rcx, qword ptr [r8 + 24]
+    cmp rcx, r13
+    jae .Lsmp8_invalid
+    test rcx, rcx
+    jz .Lsmp8_preflight_next
+    mov eax, dword ptr [r8 + 4]
+    cmp eax, 255
+    ja .Lsmp8_invalid
+    lea r9, [rip + _smp3094_ap_boot_state]
+    shl rcx, 6
+    add r9, rcx
+    cmp dword ptr [r9 + 52], 1
+    jne .Lsmp8_invalid
+    cmp qword ptr [r9 + 56], 33
+    jne .Lsmp8_invalid
+    lea r9, [rip + _smp8_barrier_state]
+    mov rcx, qword ptr [r8 + 24]
+    shl rcx, 6
+    add r9, rcx
+    mov eax, dword ptr [rsp]
+    dec rax
+    cmp qword ptr [r9 + 0], rax
+    jne .Lsmp8_invalid
+    cmp qword ptr [r9 + 8], rax
+    jne .Lsmp8_invalid
+    cmp qword ptr [r9 + 24], rax
+    jne .Lsmp8_invalid
+.Lsmp8_preflight_next:
+    inc rbx
+    jmp .Lsmp8_preflight
+
+.Lsmp8_preflight_done:
+    mov eax, dword ptr [rsp]
+    xchg qword ptr [rip + _smp8_request_generation], rax
+    xor ebx, ebx
+
+// Send exactly one fixed vector F2 IPI to each armed AP.
+.Lsmp8_send:
+    cmp rbx, r13
+    jae .Lsmp8_wait_all_arrive
+    mov r8, qword ptr [r12 + rbx * 8]
+    mov rcx, qword ptr [r8 + 24]
+    test rcx, rcx
+    jz .Lsmp8_next_send
+    mov r9, qword ptr [rip + _smp6_lapic_base]
+.Lsmp8_icr_idle:
+    mov eax, dword ptr [r9 + 0x300]
+    test eax, 0x1000
+    jz .Lsmp8_icr_go
+    pause
+    rdtsc
+    shl rdx, 32
+    or rax, rdx
+    sub rax, r15
+    cmp rax, r14
+    jae .Lsmp8_timeout
+    jmp .Lsmp8_icr_idle
+.Lsmp8_icr_go:
+    mov edx, dword ptr [r8 + 4]
+    shl edx, 24
+    mov dword ptr [r9 + 0x310], edx
+    mov dword ptr [r9 + 0x300], 0x000000F2
+.Lsmp8_next_send:
+    inc rbx
+    jmp .Lsmp8_send
+
+// Scan ALL APs; they must stay in the handler before release.
+.Lsmp8_wait_all_arrive:
+    xor ebx, ebx
+    xor r11d, r11d
+.Lsmp8_scan_arrive:
+    cmp rbx, r13
+    jae .Lsmp8_arrive_checked
+    mov r8, qword ptr [r12 + rbx * 8]
+    mov rcx, qword ptr [r8 + 24]
+    test rcx, rcx
+    jz .Lsmp8_arrive_next
+    lea r9, [rip + _smp8_barrier_state]
+    shl rcx, 6
+    add r9, rcx
+    mov eax, dword ptr [rsp]
+    cmp qword ptr [r9 + 0], rax
+    jne .Lsmp8_not_arrived
+    cmp qword ptr [r9 + 24], rax
+    jne .Lsmp8_invalid
+    mov edx, eax
+    dec rdx
+    cmp qword ptr [r9 + 16], rdx
+    jne .Lsmp8_invalid
+    inc r11d
+    jmp .Lsmp8_arrive_check_exit
+.Lsmp8_not_arrived:
+    dec rax
+    cmp qword ptr [r9 + 0], rax
+    jne .Lsmp8_invalid
+.Lsmp8_arrive_check_exit:
+    mov eax, dword ptr [rsp]
+    dec rax
+    cmp qword ptr [r9 + 8], rax
+    jne .Lsmp8_invalid
+.Lsmp8_arrive_next:
+    inc rbx
+    jmp .Lsmp8_scan_arrive
+.Lsmp8_arrive_checked:
+    mov rax, r13
+    dec rax
+    cmp r11, rax
+    je .Lsmp8_release
+    pause
+    rdtsc
+    shl rdx, 32
+    or rax, rdx
+    sub rax, r15
+    cmp rax, r14
+    jae .Lsmp8_timeout
+    jmp .Lsmp8_wait_all_arrive
+
+// Global release only occurs once every AP has confirmed entry.
+.Lsmp8_release:
+    mov eax, dword ptr [rsp]
+    xchg qword ptr [rip + _smp8_release_generation], rax
+
+.Lsmp8_wait_all_exit:
+    xor ebx, ebx
+    xor r11d, r11d
+.Lsmp8_scan_exit:
+    cmp rbx, r13
+    jae .Lsmp8_exit_checked
+    mov r8, qword ptr [r12 + rbx * 8]
+    mov rcx, qword ptr [r8 + 24]
+    test rcx, rcx
+    jz .Lsmp8_exit_next
+    lea r9, [rip + _smp8_barrier_state]
+    shl rcx, 6
+    add r9, rcx
+    mov eax, dword ptr [rsp]
+    cmp qword ptr [r9 + 0], rax
+    jne .Lsmp8_invalid
+    cmp qword ptr [r9 + 24], rax
+    jne .Lsmp8_invalid
+    cmp qword ptr [r9 + 8], rax
+    je .Lsmp8_exit_count
+    dec rax
+    cmp qword ptr [r9 + 8], rax
+    jne .Lsmp8_invalid
+    jmp .Lsmp8_exit_next
+.Lsmp8_exit_count:
+    inc r11d
+.Lsmp8_exit_next:
+    inc rbx
+    jmp .Lsmp8_scan_exit
+.Lsmp8_exit_checked:
+    mov rax, r13
+    dec rax
+    cmp r11, rax
+    je .Lsmp8_next_round
+    pause
+    rdtsc
+    shl rdx, 32
+    or rax, rdx
+    sub rax, r15
+    cmp rax, r14
+    jae .Lsmp8_timeout
+    jmp .Lsmp8_wait_all_exit
+
+.Lsmp8_next_round:
+    inc dword ptr [rsp]
+    jmp .Lsmp8_round
+
+.Lsmp8_success:
+    mov eax, r13d
+    dec eax
+    jmp .Lsmp8_return
+.Lsmp8_timeout:
+    mov eax, -1
+    jmp .Lsmp8_return
+.Lsmp8_invalid:
+    mov eax, -2
+.Lsmp8_return:
+    add rsp, 16
+    pop r15
+    pop r14
+    pop r13
+    pop r12
+    pop rbx
+    ret
+
+// void _native_set_context_switch_sp(nuint newSp)
+// Sets the target SP for context switch. Called from managed code
+// during timer interrupt to request a context switch.
+// rdi = new RSP to switch to (pointing to saved context)
+.global _native_set_context_switch_sp
+_native_set_context_switch_sp:
+    mov [rip + _context_switch_target_rsp], rdi
+    ret
+
+// nuint _native_get_context_switch_sp()
+// Gets the current context switch target SP (for debugging)
+.global _native_get_context_switch_sp
+_native_get_context_switch_sp:
+    mov rax, [rip + _context_switch_target_rsp]
+    ret
+
+// nuint _native_get_sp()
+// Gets the current SP value
+.global _native_get_sp
+_native_get_sp:
+    mov rax, rsp
+    ret
+
+// uint64_t _native_x64_get_last_error_code()
+// Returns the error code stashed by the most recent error-code exception
+// stub (vectors 8, 10-14, 17, 21, 29, 30). Only meaningful while handling
+// that exception; a nested error-code exception overwrites it.
+.global _native_x64_get_last_error_code
+_native_x64_get_last_error_code:
+    mov rax, [rip + _irq_last_error_code]
+    ret
+
+// void _native_set_context_switch_new_thread(int isNew)
+// Sets whether the target thread is NEW (1) or RESUMED (0)
+// rdi = isNew flag
+.global _native_set_context_switch_new_thread
+_native_set_context_switch_new_thread:
+    mov [rip + _context_switch_is_new_thread], rdi
+    ret
+
+.bss
+// x64 cacheline-sized identity/context reservation for 256 logical CPUs.
+.balign 64
+_smp3094_cpu_slots: .zero 16384
+
+// 256 AP stacks of 16KiB each; 4MiB zero-initialized BSS.
+// Stacks are not used until a separate AP bootstrap patch is validated.
+.balign 4096
+_smp3094_ap_stacks: .zero 4194304
+
+// 256 cache-line records: READY, logical ID, physical APIC ID,
+// GS identity, stack pointer and interrupt flag observation.
+.balign 64
+_smp3094_ap_boot_state: .zero 16384
+
+// AP-only native interrupt table: fixed IPI vector F1 and spurious FF.
+// Built by the BSP before AP publication and immutable after that.
+.balign 16
+_smp6_ap_idt: .zero 4096
+_smp6_ap_idtr: .zero 10
+.balign 8
+_smp6_lapic_base: .quad 0
+
+// Stage 8 native rendezvous (256 cachelines, 16 KiB) and epoch controls.
+.balign 64
+_smp8_barrier_state: .zero 16384
+.balign 8
+_smp8_request_generation: .quad 0
+_smp8_release_generation: .quad 0
 // Per-CPU context switch target RSP (0 = no switch, non-zero = switch to this RSP)
 // For SMP, this would be per-CPU, but for now single-CPU
 .global _context_switch_target_rsp
