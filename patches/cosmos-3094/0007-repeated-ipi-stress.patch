diff --git a/src/Cosmos.Kernel.Native.X64/CPU/Interrupts.s b/src/Cosmos.Kernel.Native.X64/CPU/Interrupts.s
--- a/src/Cosmos.Kernel.Native.X64/CPU/Interrupts.s
+++ b/src/Cosmos.Kernel.Native.X64/CPU/Interrupts.s
@@ -891,6 +891,151 @@
     pop rbx
     ret
 
+// Stage 7 native AP IPI stress. All APs have received Stage 6 IPI #1.
+// Inputs: rdi=Limine descriptors**, rsi=CPU count, rdx=total TSC
+// deadline, ecx=number of additional rounds. Return n-1, -1, or -2.
+// Each AP is targeted by its physical LAPIC ID, not dense scheduler ID.
+.global _native_x64_run_ap_ipi_stress
+_native_x64_run_ap_ipi_stress:
+    push rbx
+    push r12
+    push r13
+    push r14
+    push r15
+    sub rsp, 16
+    test rdi, rdi
+    jz .Lsmp7_invalid
+    test rsi, rsi
+    jz .Lsmp7_invalid
+    cmp rsi, 256
+    ja .Lsmp7_invalid
+    test rdx, rdx
+    jz .Lsmp7_invalid
+    test ecx, ecx
+    jz .Lsmp7_invalid
+    cmp ecx, 128
+    ja .Lsmp7_invalid
+    mov r12, rdi
+    mov r13, rsi
+    mov r14, rdx
+    mov dword ptr [rsp], ecx
+    mov dword ptr [rsp + 8], 1
+    rdtsc
+    shl rdx, 32
+    or rax, rdx
+    mov r15, rax
+
+// Preflight every AP before sending a new IPI.
+    xor ebx, ebx
+.Lsmp7_preflight:
+    cmp rbx, r13
+    jae .Lsmp7_round_start
+    mov r8, qword ptr [r12 + rbx * 8]
+    test r8, r8
+    jz .Lsmp7_invalid
+    mov rcx, qword ptr [r8 + 24]
+    cmp rcx, r13
+    jae .Lsmp7_invalid
+    test rcx, rcx
+    jz .Lsmp7_preflight_next
+    mov eax, dword ptr [r8 + 4]
+    cmp eax, 255
+    ja .Lsmp7_invalid
+    lea r10, [rip + _smp3094_ap_boot_state]
+    shl rcx, 6
+    add r10, rcx
+    cmp dword ptr [r10 + 52], 1
+    jne .Lsmp7_invalid
+    cmp qword ptr [r10 + 56], 1
+    jne .Lsmp7_invalid
+.Lsmp7_preflight_next:
+    inc rbx
+    jmp .Lsmp7_preflight
+
+.Lsmp7_round_start:
+    mov eax, dword ptr [rsp + 8]
+    cmp eax, dword ptr [rsp]
+    ja .Lsmp7_success
+    xor ebx, ebx
+.Lsmp7_each_ap:
+    cmp rbx, r13
+    jae .Lsmp7_round_complete
+    mov r8, qword ptr [r12 + rbx * 8]
+    mov rcx, qword ptr [r8 + 24]
+    test rcx, rcx
+    jz .Lsmp7_next_ap
+    lea r10, [rip + _smp3094_ap_boot_state]
+    shl rcx, 6
+    add r10, rcx
+    mov eax, dword ptr [rsp + 8]
+    cmp qword ptr [r10 + 56], rax
+    jne .Lsmp7_invalid
+    mov r9, qword ptr [rip + _smp6_lapic_base]
+    test r9, r9
+    jz .Lsmp7_invalid
+
+// Wait for previous ICR delivery status to clear.
+.Lsmp7_icr_idle:
+    mov eax, dword ptr [r9 + 0x300]
+    test eax, 0x1000
+    jz .Lsmp7_send
+    pause
+    rdtsc
+    shl rdx, 32
+    or rax, rdx
+    sub rax, r15
+    cmp rax, r14
+    jae .Lsmp7_timeout
+    jmp .Lsmp7_icr_idle
+
+.Lsmp7_send:
+    mov edx, dword ptr [r8 + 4]
+    shl edx, 24
+    mov dword ptr [r9 + 0x310], edx
+    mov dword ptr [r9 + 0x300], 0x000000F1
+
+// Must see exactly one new acknowledgement, not zero or two.
+.Lsmp7_wait:
+    mov eax, dword ptr [rsp + 8]
+    inc eax
+    cmp qword ptr [r10 + 56], rax
+    je .Lsmp7_next_ap
+    jb .Lsmp7_pending
+    jmp .Lsmp7_invalid
+.Lsmp7_pending:
+    pause
+    rdtsc
+    shl rdx, 32
+    or rax, rdx
+    sub rax, r15
+    cmp rax, r14
+    jae .Lsmp7_timeout
+    jmp .Lsmp7_wait
+
+.Lsmp7_next_ap:
+    inc rbx
+    jmp .Lsmp7_each_ap
+.Lsmp7_round_complete:
+    inc dword ptr [rsp + 8]
+    jmp .Lsmp7_round_start
+.Lsmp7_success:
+    mov eax, r13d
+    dec eax
+    jmp .Lsmp7_exit
+.Lsmp7_timeout:
+    mov eax, -1
+    jmp .Lsmp7_exit
+.Lsmp7_invalid:
+    mov eax, -2
+.Lsmp7_exit:
+    add rsp, 16
+    pop r15
+    pop r14
+    pop r13
+    pop r12
+    pop rbx
+    ret
+
 // void _native_set_context_switch_sp(nuint newSp)
 // Sets the target SP for context switch. Called from managed code
 // during timer interrupt to request a context switch.
