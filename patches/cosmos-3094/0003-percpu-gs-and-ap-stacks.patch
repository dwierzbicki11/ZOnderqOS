-// void _native_set_context_switch_sp(nuint newSp)
+// Stage 3: GS-local logical CPU identity, before AP boot is enabled.
+// Native bootstrap in later stages must call init_percpu on each AP.
+.global _native_x64_init_percpu
+_native_x64_init_percpu:
+    cmp edi, 255
+    ja .Lsmp3094_bad_id
+    lea r8, [rip + _smp3094_cpu_slots]
+    mov eax, edi
+    shl rax, 6
+    add r8, rax
+    mov qword ptr [r8 + 0], rdi
+    mov qword ptr [r8 + 8], 0
+    mov qword ptr [r8 + 16], 0
+    mov qword ptr [r8 + 24], 0
+    mov qword ptr [r8 + 32], 0
+    mov rax, r8
+    mov rdx, rax
+    shr rdx, 32
+    mov ecx, 0xC0000101
+    wrmsr
+    ret
+.Lsmp3094_bad_id:
+    ud2
+
+.global _native_x64_get_current_cpu_id
+_native_x64_get_current_cpu_id:
+    mov eax, dword ptr gs:[0]
+    ret
+
+// Read-only reserved stack top; BSP and out-of-range CPU IDs return zero.
+.global _native_x64_smp3094_ap_stack_top
+_native_x64_smp3094_ap_stack_top:
+    test edi, edi
+    jz .Lsmp3094_bad_stack
+    cmp edi, 255
+    ja .Lsmp3094_bad_stack
+    lea rax, [rip + _smp3094_ap_stacks]
+    mov ecx, edi
+    shl rcx, 14
+    add rax, rcx
+    add rax, 16384
+    ret
+.Lsmp3094_bad_stack:
+    xor eax, eax
+    ret
+
+// void _native_set_context_switch_sp(nuint newSp)
 // Sets the target SP for context switch. Called from managed code
 // during timer interrupt to request a context switch.
 // rdi = new RSP to switch to (pointing to saved context)
@@ -326,7 +372,15 @@
     mov [rip + _context_switch_is_new_thread], rdi
     ret
 
-.bss
+.bss
+// x64 cacheline-sized identity/context reservation for 256 logical CPUs.
+.balign 64
+_smp3094_cpu_slots: .zero 16384
+
+// 256 AP stacks of 16KiB each; 4MiB zero-initialized BSS.
+// Stacks are not used until a separate AP bootstrap patch is validated.
+.balign 4096
+_smp3094_ap_stacks: .zero 4194304
 // Per-CPU context switch target RSP (0 = no switch, non-zero = switch to this RSP)
 // For SMP, this would be per-CPU, but for now single-CPU
 .global _context_switch_target_rsp
